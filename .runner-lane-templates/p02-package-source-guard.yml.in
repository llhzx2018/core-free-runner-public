name: P02 candidate package source guard (one-off, no package)
on:
  pull_request:
    branches: [main]
    paths:
      - '.github/workflows/p02-package-source-guard-oneoff.yml'
permissions:
  contents: read
jobs:
  source-only:
    runs-on: ubuntu-24.04
    timeout-minutes: 20
    env:
      TARGET_REPO: {{REPOSITORY}}
      TARGET_VERSION: {{TARGET_VERSION}}
      TARGET_SHA: {{TARGET_SHA}}
      TARGET_TREE: {{TARGET_TREE}}
      SOURCE_VERSIONS_JSON: '{{SOURCE_VERSIONS_JSON}}'
      SCHEMA_VERSION: '{{SCHEMA_VERSION}}'
    steps:
      - name: Checkout Runner lane spec tools
        uses: actions/checkout@v4
        with:
          path: runner
          persist-credentials: false
      - name: Validate lane identity and rendered workflow
        shell: bash
        run: |
          set -Eeuo pipefail
          python3 runner/scripts/ephemeral_lane_spec.py validate --spec runner/.runner-lanes/p02-package-source-guard.json
          python3 runner/scripts/ephemeral_lane_spec.py render --spec runner/.runner-lanes/p02-package-source-guard.json --template runner/.runner-lane-templates/p02-package-source-guard.yml.in --output "$RUNNER_TEMP/p02-rendered.yml"
          cmp "$RUNNER_TEMP/p02-rendered.yml" runner/.github/workflows/p02-package-source-guard-oneoff.yml
          python3 runner/scripts/ephemeral_lane_spec.py audit-rendered --spec runner/.runner-lanes/p02-package-source-guard.json --input runner/.github/workflows/p02-package-source-guard-oneoff.yml
      - name: Checkout exact private P02 source
        uses: actions/checkout@v4
        with:
          repository: __GH_EXPR_TARGET_REPO__
          ref: __GH_EXPR_TARGET_SHA__
          token: __GH_SECRET_PRIVATE_READ__
          persist-credentials: false
          path: product
      - name: Checkout current owning update channel
        uses: actions/checkout@v4
        with:
          repository: llhzx2018/core-updates
          ref: main
          token: __GH_SECRET_PRIVATE_READ__
          persist-credentials: false
          path: update-channel
      - name: Exact source and all-builder negative checks only
        shell: bash
        run: |
          set -Eeuo pipefail
          test "$(git -C product rev-parse HEAD)" = "$TARGET_SHA"
          test "$(git -C product show -s --format=%T HEAD)" = "$TARGET_TREE"
          test "$(cat product/VERSION)" = "$TARGET_VERSION"
          python3 product/scripts/verify-source-manifest.py
          bash product/scripts/verify-repository.sh
          python3 - "$GITHUB_WORKSPACE/update-channel/projects/P02.json" <<'PY'
          import json, os, subprocess, sys, tempfile
          from pathlib import Path

          channel = Path(sys.argv[1])
          document = json.loads(channel.read_text(encoding="utf-8"))
          sources = document["from_versions"] + [document["target_version"]]
          expected = json.loads(os.environ["SOURCE_VERSIONS_JSON"])
          assert len(sources) == len(set(sources)) == 21, "official source count/duplicates changed"
          assert len(expected) == 21 and set(sources) == set(expected), "lane source set differs from live channel"
          validator = [
              sys.executable, "scripts/verify-release-source-set.py",
              "--channel-json", str(channel),
              "--target-version", os.environ["TARGET_VERSION"],
          ]
          for version in sources:
              validator.extend(["--source-version", version])
          subprocess.run(validator, cwd="product", check=True)
          print("P02_21_SOURCE_SET_OFFICIAL_CHANNEL_MATCH=PASS")

          incomplete = sources[1:]
          with tempfile.TemporaryDirectory(prefix="p02-package-entry-guard-") as temporary:
              temp = Path(temporary)
              deploy = temp / "missing-deploy"
              cases = [
                  ("build-candidate.py", ["--out", str(temp / "candidate")], [temp / "candidate"]),
                  ("build-release.py", ["--out", str(temp / "release")], [temp / "release"]),
                  ("build-multisource-update.py", [
                      "--deploy-root", str(deploy), "--output", str(temp / "update.zip"),
                      "--target-version", os.environ["TARGET_VERSION"],
                      "--source-schema", os.environ["SCHEMA_VERSION"],
                      "--target-schema", os.environ["SCHEMA_VERSION"],
                      "--timestamp", "2026-11-12T00:00:00Z",
                  ], [temp / "update.zip"]),
                  ("build-multisource-repair.py", [
                      "--deploy-root", str(deploy),
                      "--template", "scripts/repair-template.php",
                      "--output", str(temp / "repair.php"),
                      "--target-version", os.environ["TARGET_VERSION"],
                      "--schema", os.environ["SCHEMA_VERSION"],
                  ], [temp / "repair.php"]),
              ]
              for name, arguments, outputs in cases:
                  command = [sys.executable, "scripts/" + name, *arguments,
                             "--channel-json", str(channel)]
                  for version in incomplete:
                      command.extend(["--source-version", version])
                  result = subprocess.run(command, cwd="product", capture_output=True, text=True)
                  assert result.returncode != 0, name + " unexpectedly accepted an incomplete source set"
                  assert "P02_SOURCE_CONTINUITY_MISMATCH" in result.stderr, name + ": " + result.stderr[-1200:]
                  assert all(not output.exists() for output in outputs), name + " wrote an artifact before rejection"
                  print("P02_DIRECT_BUILDER_MISMATCH_DENIED=PASS " + name)
          print("P02_ALL_FOUR_PACKAGE_ENTRYPOINTS_FAIL_CLOSED=PASS")
          PY
      - name: Cleanup transient private checkouts
        if: always()
        shell: bash
        run: |
          rm -rf runner product update-channel
          echo P02_PRIVATE_SOURCE_AND_CHANNEL_PERSISTED_IN_PUBLIC_GIT_OR_ARTIFACT=NO
