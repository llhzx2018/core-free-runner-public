#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$ROOT_DIR/lib/terminal_ui.sh"
source "$ROOT_DIR/lib/cloudpanel_ui_common.sh"
source "$ROOT_DIR/lib/cloudpanel_ui_sites.sh"
source "$ROOT_DIR/lib/cloudpanel_ui_ops.sh"
source "$ROOT_DIR/lib/cloudpanel_ui_admin.sh"

site_management() {
  clear_site_selection
  local rc choice
  if select_site; then :; else rc=$?; [[ $rc -eq 2 ]] && return 0; pause; return 0; fi

  while true; do
    say
    ui_title '网站管理'
    ui_rule
    say "当前网站：${C_GREEN}$SELECTED_DOMAIN${C_RESET}"
    say
    ui_menu_info 1 '网站概览'
    ui_menu_good 2 '健康检查'
    ui_menu_info 3 '数据库清单'
    ui_menu_warn 4 '新增数据库'
    ui_menu_good 5 '导出数据库'
    ui_menu_warn 6 '导入数据库'
    ui_menu_info 7 'SSL 状态'
    ui_menu_warn 8 '申请 / 安装 Let’s Encrypt'
    ui_menu_warn 9 '安装自定义证书'
    ui_menu_warn 10 '修复网站权限'
    ui_menu_warn 11 '清理 Varnish 缓存'
    say
    ui_menu_flow 98 '更换网站'
    ui_menu_back 0 '返回 P07 主菜单'
    say
    ui_note '网站只选择一次；P07 不自动修改 DNS，不删除源服务器，不覆盖已有目标服务器。'
    ui_prompt '请选择 [0-11/98]：'; read -r choice || return 0
    case "$choice" in
      1) show_site_details ;;
      2) site_health ;;
      3) list_site_databases ;;
      4) add_site_database ;;
      5) export_site_database ;;
      6) import_site_database ;;
      7) ssl_status ;;
      8) issue_lets_encrypt ;;
      9) install_custom_certificate ;;
      10) repair_permissions ;;
      11) purge_varnish ;;
      98)
        clear_site_selection
        if select_site; then :; else rc=$?; [[ $rc -eq 2 ]] && return 0; pause; return 0; fi
        ;;
      0) clear_site_selection; return 0 ;;
      *) ui_warn '请输入 0-11 或 98。' ;;
    esac
  done
}

admin_management() {
  local choice
  while true; do
    say
    ui_title 'CloudPanel 管理'
    ui_rule
    ui_menu_warn 1 '创建网站'
    ui_menu_warn 2 'CloudPanel 安全'
    ui_menu_info 3 'CloudPanel 用户'
    ui_menu_good 4 '平台基础能力检查'
    ui_menu_back 0 '返回 P07 主菜单'
    say
    ui_note 'Vhost 模板由 CloudPanel / P07 自动处理；高级维护能力不在普通入口。'
    ui_note '删除网站 / 数据库 / 用户不在普通入口；P07 不自动修改 DNS，不删除源服务器，不覆盖目标服务器。'
    ui_prompt '请选择 [0-4]：'; read -r choice || return 0
    case "$choice" in
      1) create_site ;;
      2) panel_security ;;
      3) panel_users ;;
      4) platform_status ;;
      0) return 0 ;;
      *) ui_warn '请输入 0-4。' ;;
    esac
  done
}

root_menu() {
  local choice
  while true; do
    say
    ui_title 'CloudPanel'
    ui_rule
    ui_menu_good 1 '网站管理'
    ui_menu_info 2 'CloudPanel 管理'
    ui_menu_back 0 '返回 P07 主菜单'
    ui_prompt '请选择 [0-2]：'; read -r choice || return 0
    case "$choice" in
      1) site_management ;;
      2) admin_management ;;
      0) return 0 ;;
      *) ui_warn '请输入 0-2。' ;;
    esac
  done
}

case "${1:-}" in
  site) site_management ;;
  admin) admin_management ;;
  "") root_menu ;;
  *) printf '用法：%s [site|admin]\n' "$(basename "$0")" >&2; exit 2 ;;
esac
