#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$ROOT_DIR/lib/terminal_ui.sh"
source "$ROOT_DIR/lib/cloudpanel_ui_common.sh"
source "$ROOT_DIR/lib/cloudpanel_ui_sites.sh"
source "$ROOT_DIR/lib/cloudpanel_ui_ops.sh"
source "$ROOT_DIR/lib/cloudpanel_ui_admin.sh"

manage_selected_site() {
  local rc choice
  while true; do
    ui_page '网站创建与维护' "${SELECTED_DOMAIN}"
    ui_rule
    say "当前网站：${C_GREEN}$SELECTED_DOMAIN${C_RESET}"
    say
    ui_menu_info 1 '网站概览'
    ui_menu_good 2 '网站健康检查'
    ui_menu_info 3 '数据库'
    ui_menu_info 4 '网站证书（HTTPS）'
    ui_menu_warn 5 '权限与缓存'
    say
    ui_menu_flow 98 '更换网站'
    ui_menu_back 0 '返回'
    say
    ui_note '这里只管理当前网站；不会自动修改域名解析（DNS），不会删除其它网站。'
    ui_prompt '请选择 [0-5/98]：'; read -r choice || return 0
    case "$choice" in
      1) show_site_details ;;
      2) site_health ;;
      3) database_tools ;;
      4) ssl_tools ;;
      5) maintenance_tools ;;
      98)
        clear_site_selection
        if select_site; then :; else rc=$?; [[ $rc -eq 2 ]] && return 0; pause; return 0; fi
        ;;
      0) clear_site_selection; return 0 ;;
      *) ui_warn '请输入 0-5 或 98。' ;;
    esac
  done
}

site_management() {
  local rc choice
  while true; do
    ui_page '网站创建与维护' '管理已有网站或创建新网站'
    ui_rule
    ui_menu_good 1 '管理已有网站'
    ui_menu_warn 2 '创建新网站'
    ui_menu_back 0 '返回'
    say
    ui_note '删除网站不在普通入口，避免误操作。'
    ui_prompt '请选择 [0-2]：'; read -r choice || return 0
    case "$choice" in
      1)
        clear_site_selection
        if select_site; then
          manage_selected_site
        else
          rc=$?
          [[ $rc -eq 2 ]] || pause
        fi
        ;;
      2) create_site ;;
      0) return 0 ;;
      *) ui_warn '请输入 0-2。' ;;
    esac
  done
}

admin_management() {
  local choice
  while true; do
    ui_page '面板账号与安全（CloudPanel）' '面板自身设置'
    ui_rule
    ui_menu_warn 1 '登录安全'
    ui_menu_info 2 '面板用户'
    ui_menu_good 3 '面板状态检查'
    ui_menu_back 0 '返回'
    say
    ui_note '网站底层配置由 CloudPanel 和工具自动处理，普通用户无需管理。'
    ui_note '删除网站 / 数据库 / 用户不在普通入口；不会自动修改 DNS，也不会覆盖已有网站。'
    ui_prompt '请选择 [0-3]：'; read -r choice || return 0
    case "$choice" in
      1) panel_security ;;
      2) panel_users ;;
      3) platform_status ;;
      0) return 0 ;;
      *) ui_warn '请输入 0-3。' ;;
    esac
  done
}

root_menu() {
  local choice
  while true; do
    ui_page 'CloudPanel 管理' '网站与面板分工'
    ui_rule
    ui_menu_good 1 '网站创建与维护'
    ui_menu_info 2 '面板账号与安全'
    ui_menu_back 0 '返回'
    ui_prompt '请选择 [0-2]：'; read -r choice || return 0
    case "$choice" in
      1) site_management ;;
      2) admin_management ;;
      0) return 0 ;;
      *) ui_warn '请输入 0-2。' ;;
    esac
  done
}

case "${1:-}" in
  site) site_management ;;
  admin) admin_management ;;
  "") root_menu ;;
  *) printf '用法：%s [site|admin]\n' "$(basename "$0")" >&2; exit 2 ;;
esac
