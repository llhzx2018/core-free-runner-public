#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT_DIR="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
CORE="$ROOT_DIR/bin/vfops"
SITE_UI="$ROOT_DIR/bin/vfops-site-ui"
MIGRATE_UI="$ROOT_DIR/bin/vfops-migrate-ui"
AUTO_UI="$ROOT_DIR/bin/vfops-auto-backup"
CLOUDPANEL_UI="$ROOT_DIR/bin/vfops-cloudpanel-ui"
DIAG_UI="$ROOT_DIR/bin/vfops-diagnostics-ui"
HISTORY_UI="$ROOT_DIR/bin/vfops-history-ui"
SELFCHECK_UI="$ROOT_DIR/bin/vfops-selfcheck-ui"
INIT_UI="$ROOT_DIR/bin/vfops-init-ui"
HISTORY_ENGINE="$ROOT_DIR/lib/ops_history.py"
DIAG_ENGINE="$ROOT_DIR/lib/ops_diagnostics.py"
VERSION="$(cat "$ROOT_DIR/VERSION" 2>/dev/null || printf 'UNKNOWN')"
BUILD_ID="$(cat "$ROOT_DIR/BUILD_ID" 2>/dev/null || printf 'UNKNOWN')"
CHANNEL=""

source "$ROOT_DIR/lib/terminal_ui.sh"

pause() { ui_pause_return; }

history_label() {
  case "$(basename "$1"):${2:-}" in
    vfops-site-ui:overview) printf '服务器与网站概况' ;;
    vfops-site-ui:backup) printf '备份网站' ;;
    vfops-site-ui:restore) printf '恢复网站' ;;
    vfops-migrate-ui:*) printf '服务器迁移' ;;
    vfops-auto-backup:*) printf '自动备份 / 异地备份' ;;
    vfops-cloudpanel-ui:site) printf '网站管理' ;;
    vfops-cloudpanel-ui:admin) printf '面板管理（CloudPanel）' ;;
    vfops-diagnostics-ui:*) printf '诊断中心' ;;
    vfops-history-ui:*) printf '最近操作' ;;
    vfops-selfcheck-ui:*) printf 'P07 自检 / 修复' ;;
    vfops-init-ui:*) printf '新服务器初始化' ;;
    *) printf 'P07 操作' ;;
  esac
}

record_history() {
  local action="$1" result="$2" detail="${3:-}"
  [[ -f "$HISTORY_ENGINE" ]] || return 0
  python3 "$HISTORY_ENGINE" append --action "$action" --result "$result" --detail "$detail" >/dev/null 2>&1 || true
}

run_module() {
  local file="$1"; shift
  if [[ ! -f "$file" ]]; then
    printf '\n模块缺失，P07 已停止：%s\n' "$(basename "$file")" >&2
    pause
    return 0
  fi
  local rc action
  action="$(history_label "$file" "${1:-}")"
  ui_screen_clear
  set +e
  bash "$file" "$@"
  rc=$?
  set -e
  if [[ $rc -ne 0 ]]; then
    record_history "$action" '失败' "退出码 $rc"
    ui_result_error '功能没有正常完成'
    ui_kv '模块' "$(basename "$file")"
    ui_kv '退出码' "$rc"
    say
    ui_note '主菜单仍可继续使用。'
    ui_pause_return
  else
    [[ "$action" == '最近操作' ]] || record_history "$action" '成功'
  fi
  return 0
}

header() {
  ui_page "P07 · VF 服务器运维" "${VERSION}${CHANNEL:+ ${CHANNEL}}"
  local summary status count
  summary="$(python3 "$DIAG_ENGINE" --summary 2>/dev/null || printf 'UNKNOWN ?')"
  status="${summary%% *}"
  count="${summary#* }"
  case "$status" in
    OK) ui_good '状态摘要：当前未发现明显问题' ;;
    WARN) ui_attention "状态摘要：有 ${count} 项需要关注" ;;
    ERROR) ui_bad '状态摘要：发现阻断级异常' ;;
    *) ui_note '状态摘要：暂时无法读取' ;;
  esac
  say
  say "  ${C_CYAN}1.${C_RESET} 服务器与网站概况"
  say "  ${C_GREEN}2.${C_RESET} 备份网站"
  say "  ${C_YELLOW}3.${C_RESET} 恢复网站"
  say "  ${C_MAGENTA}4.${C_RESET} 服务器迁移（整机 / 单站）"
  say "  ${C_CYAN}5.${C_RESET} 自动备份 / 异地备份"
  say "  ${C_CYAN}6.${C_RESET} 网站管理"
  say "  ${C_CYAN}7.${C_RESET} 面板管理（CloudPanel）"
  say
  say "  ${C_CYAN}8.${C_RESET} 诊断中心"
  say "  ${C_CYAN}9.${C_RESET} 最近操作"
  say "  ${C_GREEN}10.${C_RESET} P07 自检 / 修复"
  say "  ${C_YELLOW}11.${C_RESET} 新服务器初始化"
  say
  say "  ${C_GRAY}0.${C_RESET} 退出"
  say
  say "${C_GRAY}青色=信息/管理 · 绿色=安全/查看 · 黄色=配置/恢复 · 洋红=迁移 · 红色=高风险/删除${C_RESET}"
  say
}

if (($# > 0)); then
  case "$1" in
    --version|-V)
      printf 'VF Server Ops %s%s\n' "$VERSION" "${CHANNEL:+ $CHANNEL}"
      exit 0
      ;;
    --build-id)
      printf '%s\n' "$BUILD_ID"
      exit 0
      ;;
    --advanced)
      shift
      exec "$CORE" "$@"
      ;;
    *)
      exec "$CORE" "$@"
      ;;
  esac
fi

while true; do
  header
  printf '%b' "${C_BOLD}请选择 [0-11]：${C_RESET}"
  read -r choice || exit 0
  case "$choice" in
    1) run_module "$SITE_UI" overview ;;
    2) run_module "$SITE_UI" backup ;;
    3) run_module "$SITE_UI" restore ;;
    4) run_module "$MIGRATE_UI" ;;
    5) run_module "$AUTO_UI" ;;
    6) run_module "$CLOUDPANEL_UI" site ;;
    7) run_module "$CLOUDPANEL_UI" admin ;;
    8) run_module "$DIAG_UI" ;;
    9) run_module "$HISTORY_UI" ;;
    10) run_module "$SELFCHECK_UI" ;;
    11) run_module "$INIT_UI" ;;
    0) exit 0 ;;
    *) say "${C_YELLOW}请输入 0-11。${C_RESET}"; pause ;;
  esac
done
