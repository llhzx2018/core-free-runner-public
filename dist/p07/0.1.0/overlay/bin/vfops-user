#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT_DIR="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
CORE="$ROOT_DIR/bin/vfops"
SITE_UI="$ROOT_DIR/bin/vfops-site-ui"
MIGRATE_UI="$ROOT_DIR/bin/vfops-migrate-ui"
AUTO_UI="$ROOT_DIR/bin/vfops-auto-backup"
DIAG_UI="$ROOT_DIR/bin/vfops-diagnostics-ui"
HISTORY_UI="$ROOT_DIR/bin/vfops-history-ui"
SELFCHECK_UI="$ROOT_DIR/bin/vfops-selfcheck-ui"
INIT_UI="$ROOT_DIR/bin/vfops-init-ui"
HISTORY_ENGINE="$ROOT_DIR/lib/ops_history.py"
DIAG_ENGINE="$ROOT_DIR/lib/ops_diagnostics.py"
VERSION="$(cat "$ROOT_DIR/VERSION" 2>/dev/null || printf 'UNKNOWN')"
BUILD_ID="$(cat "$ROOT_DIR/BUILD_ID" 2>/dev/null || printf 'UNKNOWN')"
CHANNEL=""

source "$ROOT_DIR/lib/terminal_ui.sh"

pause() { ui_pause_return; }

history_label() {
  case "$(basename "$1"):${2:-}" in
    vfops-site-ui:overview) printf '网站与数据概况' ;;
    vfops-site-ui:backup) printf '备份网站' ;;
    vfops-site-ui:restore) printf '恢复网站' ;;
    vfops-migrate-ui:*) printf '服务器迁移' ;;
    vfops-auto-backup:*) printf '自动备份与异地备份' ;;
    vfops-diagnostics-ui:*) printf '服务器健康检查' ;;
    vfops-history-ui:*) printf '最近操作' ;;
    vfops-selfcheck-ui:*) printf '工具检查 / 修复' ;;
    vfops-init-ui:*) printf '初始化服务器' ;;
    *) printf '服务器工具箱操作' ;;
  esac
}

record_history() {
  local action="$1" result="$2" detail="${3:-}"
  [[ -f "$HISTORY_ENGINE" ]] || return 0
  python3 "$HISTORY_ENGINE" append --action "$action" --result "$result" --detail "$detail" >/dev/null 2>&1 || true
}

run_module() {
  local file="$1"; shift
  local rc action
  action="$(history_label "$file" "${1:-}")"
  if [[ ! -f "$file" ]]; then
    ui_result_error '当前功能暂时无法打开'
    ui_kv '功能' "$action"
    ui_note '请返回服务器工具箱，使用“工具检查 / 修复”检查组件。'
    ui_pause_return
    return 0
  fi
  ui_screen_clear
  set +e
  bash "$file" "$@"
  rc=$?
  set -e
  if [[ $rc -ne 0 ]]; then
    record_history "$action" '失败' "退出码 $rc"
    ui_result_error '功能没有正常完成'
    ui_kv '功能' "$action"
    say
    ui_note '请返回服务器工具箱重新进入；若再次失败，请使用“工具检查 / 修复”。'
    ui_pause_return
  else
    [[ "$action" == '最近操作' ]] || record_history "$action" '成功'
  fi
  return 0
}

header() {
  ui_page "网站与数据" "${VERSION}${CHANNEL:+ ${CHANNEL}}"
  say "  ${C_CYAN}1.${C_RESET} 网站与数据概况      ${C_GRAY}网站状态${C_RESET}"
  say "  ${C_GREEN}2.${C_RESET} 立即备份一个网站    ${C_GRAY}手动备份${C_RESET}"
  say "  ${C_YELLOW}3.${C_RESET} 从备份恢复网站      ${C_GRAY}安全恢复${C_RESET}"
  say "  ${C_CYAN}4.${C_RESET} 自动备份与异地备份  ${C_GRAY}Google/B2${C_RESET}"
  say "  ${C_MAGENTA}5.${C_RESET} 服务器迁移          ${C_GRAY}整机/单站${C_RESET}"
  say
  say "  ${C_GRAY}0.${C_RESET} 返回"
  say
  ui_note '常用操作直接放在这一层；只有选择网站、备份或迁移任务时才进入临时选择页。'
  ui_note '网站/数据库/面板日常管理请使用 CloudPanel。'
  say
}

if (($# > 0)); then
  case "$1" in
    --version|-V)
      printf 'VF Server Ops %s%s\n' "$VERSION" "${CHANNEL:+ $CHANNEL}"
      exit 0
      ;;
    --build-id)
      printf '%s\n' "$BUILD_ID"
      exit 0
      ;;
    --init)
      shift
      exec bash "$INIT_UI" "$@"
      ;;
    --advanced)
      shift
      exec "$CORE" "$@"
      ;;
    *)
      exec "$CORE" "$@"
      ;;
  esac
fi

while true; do
  header
  printf '%b' "${C_BOLD}请选择 [0-5]：${C_RESET}"
  read -r choice || exit 0
  case "$choice" in
    1) run_module "$SITE_UI" overview ;;
    2) run_module "$SITE_UI" backup ;;
    3) run_module "$SITE_UI" restore ;;
    4) run_module "$AUTO_UI" ;;
    5) run_module "$MIGRATE_UI" ;;
    0) exit 0 ;;
    *) say "${C_YELLOW}请输入 0-5。${C_RESET}"; pause ;;
  esac
done
