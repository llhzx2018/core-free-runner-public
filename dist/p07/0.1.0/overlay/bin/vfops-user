#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT_DIR="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
CORE="$ROOT_DIR/bin/vfops"
SITE_UI="$ROOT_DIR/bin/vfops-site-ui"
MIGRATE_UI="$ROOT_DIR/bin/vfops-migrate-ui"
AUTO_UI="$ROOT_DIR/bin/vfops-auto-backup"
CLOUDPANEL_UI="$ROOT_DIR/bin/vfops-cloudpanel-ui"
VERSION="$(cat "$ROOT_DIR/VERSION" 2>/dev/null || printf 'UNKNOWN')"
BUILD_ID="$(cat "$ROOT_DIR/BUILD_ID" 2>/dev/null || printf 'UNKNOWN')"
CHANNEL=""

source "$ROOT_DIR/lib/terminal_ui.sh"

pause() { printf '\n按 Enter 返回...'; read -r _ || true; }

run_module() {
  local file="$1"; shift
  if [[ ! -f "$file" ]]; then
    printf '\n模块缺失，P07 已停止：%s\n' "$(basename "$file")" >&2
    pause
    return 0
  fi
  bash "$file" "$@"
}

header() {
  if [[ -t 1 ]]; then printf '\033[H\033[2J'; fi
  say "${C_CYAN}┌──────────────────────────────────────────────────────────────┐${C_RESET}"
  say "${C_CYAN}│${C_RESET}  ${C_BOLD}P07 · VF Server Ops${C_RESET}   ${C_GRAY}${VERSION}${CHANNEL:+ ${CHANNEL}}${C_RESET}"
  say "${C_CYAN}└──────────────────────────────────────────────────────────────┘${C_RESET}"
  say
  say "  ${C_CYAN}1.${C_RESET} 服务器 / 网站概览"
  say "  ${C_GREEN}2.${C_RESET} 备份网站"
  say "  ${C_YELLOW}3.${C_RESET} 恢复网站"
  say "  ${C_MAGENTA}4.${C_RESET} 服务器迁移（整机 / 单站）"
  say "  ${C_CYAN}5.${C_RESET} 自动备份 / 远程灾备"
  say "  ${C_CYAN}6.${C_RESET} 网站管理"
  say "  ${C_CYAN}7.${C_RESET} CloudPanel 管理"
  say
  say "  ${C_GRAY}0.${C_RESET} 退出"
  say
  say "${C_GRAY}绿色=安全/查看 · 黄色=配置/恢复 · 洋红=迁移 · 红色=高风险/删除${C_RESET}"
  say
}

if (($# > 0)); then
  case "$1" in
    --version|-V)
      printf 'VF Server Ops %s%s\n' "$VERSION" "${CHANNEL:+ $CHANNEL}"
      exit 0
      ;;
    --build-id)
      printf '%s\n' "$BUILD_ID"
      exit 0
      ;;
    --advanced)
      shift
      exec "$CORE" "$@"
      ;;
    *)
      exec "$CORE" "$@"
      ;;
  esac
fi

while true; do
  header
  printf '%b' "${C_BOLD}请选择 [0-7]：${C_RESET}"
  read -r choice || exit 0
  case "$choice" in
    1) run_module "$SITE_UI" overview ;;
    2) run_module "$SITE_UI" backup ;;
    3) run_module "$SITE_UI" restore ;;
    4) run_module "$MIGRATE_UI" ;;
    5) run_module "$AUTO_UI" ;;
    6) run_module "$CLOUDPANEL_UI" site ;;
    7) run_module "$CLOUDPANEL_UI" admin ;;
    0) exit 0 ;;
    *) say "${C_YELLOW}请输入 0-7。${C_RESET}"; pause ;;
  esac
done
