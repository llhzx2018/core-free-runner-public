#!/usr/bin/env bash
set -euo pipefail
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$ROOT_DIR/lib/terminal_ui.sh"
PUBLIC_INSTALLER='https://raw.githubusercontent.com/llhzx2018/core-free-runner-public/main/installers/p07-final.sh'
NEEDS_REPAIR=0

selfcheck() {
  NEEDS_REPAIR=0
  ui_page '工具检查 / 修复' '检查服务器工具箱自身'
  local missing=0 f build='未知'
  [[ -f "$ROOT_DIR/BUILD_ID" ]] && IFS= read -r build < "$ROOT_DIR/BUILD_ID" || true

  for f in bin/vfops-user bin/vfops lib/terminal_ui.sh VERSION BUILD_ID; do
    [[ -f "$ROOT_DIR/$f" ]] || missing=$((missing+1))
  done
  [[ -x "$ROOT_DIR/bin/vfops-user" ]] || missing=$((missing+1))
  [[ -L /usr/local/bin/vfops ]] || missing=$((missing+1))

  say "版本        ${build}"
  if [[ "$missing" -eq 0 ]]; then
    say '运行文件    正常'
    say '主入口      正常'
    say
    ui_good '结论：服务器工具箱正常 ✓'
  else
    NEEDS_REPAIR=1
    say "运行文件    发现 ${missing} 项异常"
    say '主入口      需要修复'
    say
    ui_bad '结论：服务器工具箱需要修复。'
  fi
}

repair_now() {
  local tmp
  command -v curl >/dev/null 2>&1 || {
    ui_result_error '无法修复：系统缺少 curl'
    return 1
  }
  tmp="$(mktemp -t p07-repair.XXXXXX)"
  if curl -fsSL "$PUBLIC_INSTALLER" -o "$tmp" && P07_NO_EXEC=1 bash "$tmp"; then
    ui_result_ok '工具修复完成'
  else
    ui_result_error '工具修复未完成'
    rm -f "$tmp"
    return 1
  fi
  rm -f "$tmp"
  return 0
}

selfcheck
if [[ "$NEEDS_REPAIR" -eq 0 ]]; then
  ui_pause_return
  exit 0
fi

say
ui_safety_tier write '修复只替换服务器工具箱自身运行文件，不迁移服务器、不修改 DNS、不恢复网站、不修改资源配置。'
ui_prompt '现在重新安装工具运行文件？[y/N]：'
read -r confirm || confirm=''
if [[ "$confirm" =~ ^[Yy]$ ]]; then
  if repair_now; then
    say
    selfcheck
  fi
else
  ui_note '已取消修复；没有修改服务器工具运行文件。'
fi
ui_pause_return
