#!/usr/bin/env bash
set -euo pipefail
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$ROOT_DIR/lib/terminal_ui.sh"
PUBLIC_INSTALLER='https://raw.githubusercontent.com/llhzx2018/core-free-runner-public/main/installers/p07-final.sh'

selfcheck() {
  ui_page '工具检查 / 修复' '只检查服务器工具箱自身，不检查网站内容'
  local missing=0 f
  for f in bin/vfops-user bin/vfops lib/terminal_ui.sh VERSION BUILD_ID; do
    if [[ -f "$ROOT_DIR/$f" ]]; then ui_good "正常  $f"; else ui_bad "缺失  $f"; missing=1; fi
  done
  [[ -x "$ROOT_DIR/bin/vfops-user" ]] && ui_good '正常  主入口可执行' || ui_attention '提醒  主入口不是可执行文件'
  [[ -L /usr/local/bin/vfops ]] && ui_good '正常  /usr/local/bin/vfops 链接存在' || ui_attention '提醒  /usr/local/bin/vfops 链接未发现'
  say
  [[ $missing -eq 0 ]] && ui_good '结论：服务器工具箱运行文件完整。' || ui_bad '结论：服务器工具箱运行文件不完整。'
}
while true; do
  selfcheck
  say
  ui_menu_info 1 '重新检查'
  ui_menu_warn 2 '重新安装工具运行文件'
  ui_menu_back 0 '返回'
  say
  ui_safety_tier write '重新安装只替换服务器工具箱自身运行文件，不会迁移服务器、修改域名解析、恢复网站或修改资源配置。'
  ui_prompt '请选择 [0-2]：'; read -r choice || exit 0
  case "$choice" in
    1) ;;
    2)
      ui_page '工具修复确认' '重新安装服务器工具箱运行文件'
      ui_safety_tier write '将从正式公共入口重新安装当前工具运行文件。'
      ui_prompt '确认重新安装工具运行文件？[y/N]：'
      read -r confirm || continue
      if [[ "$confirm" =~ ^[Yy]$ ]]; then
        tmp="$(mktemp -t p07-repair.XXXXXX)"
        if curl -fsSL "$PUBLIC_INSTALLER" -o "$tmp" && bash "$tmp"; then
          ui_result_ok '工具修复完成'
        else
          ui_result_error '工具修复未完成'
        fi
        rm -f "$tmp"
        ui_pause_return
      fi
      ;;
    0) exit 0 ;;
    *) ui_attention '请输入 0-2。'; ui_pause_return ;;
  esac
done
