#!/usr/bin/env bash
set -euo pipefail
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$ROOT_DIR/lib/terminal_ui.sh"
ENGINE="$ROOT_DIR/lib/ops_diagnostics.py"

ui_page 'P07 · 诊断中心' '只读检查 · 不修改服务器'
raw="$(python3 "$ENGINE" --json)"
RAW="$raw" C_GREEN="$C_GREEN" C_YELLOW="$C_YELLOW" C_RED="$C_RED" C_RESET="$C_RESET" python3 - <<'PY'
import json,os
d=json.loads(os.environ["RAW"])
colors={"OK":os.environ.get("C_GREEN",""),"WARN":os.environ.get("C_YELLOW",""),"ERROR":os.environ.get("C_RED","")}
labels={"OK":"正常","WARN":"提醒","ERROR":"异常"}
reset=os.environ.get("C_RESET","")
for x in d["checks"]:
    s=x["status"]; c=colors.get(s,"")
    print(f"{c}{labels.get(s,s)}{reset}  {x['label']}：{x['detail']}")
print()
print("总体：" + {"OK":"当前未发现明显问题","WARN":"有需要关注的项目","ERROR":"发现需要优先处理的异常"}.get(d["verdict"],d["verdict"]))
PY
say
ui_safety_tier read '不会重启服务、修改配置或删除数据。'
ui_pause_return
