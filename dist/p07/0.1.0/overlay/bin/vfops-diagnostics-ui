#!/usr/bin/env bash
set -euo pipefail
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$ROOT_DIR/lib/terminal_ui.sh"
ENGINE="$ROOT_DIR/lib/ops_diagnostics.py"

ui_page '服务器健康检查' '只读检查'
raw="$(python3 "$ENGINE" --json)"
RAW="$raw" python3 - <<'PY'
import json,os
d=json.loads(os.environ["RAW"])
rows={x["key"]:x for x in d["checks"]}
def state(keys):
    xs=[rows[k] for k in keys if k in rows]
    if any(x["status"]=="ERROR" for x in xs): return "异常"
    if any(x["status"]=="WARN" for x in xs): return "需关注"
    return "正常"
print("结论        " + {"OK":"当前未发现明显问题","WARN":"有项目需要关注","ERROR":"发现需要优先处理的问题"}.get(d["verdict"],"需要检查"))
print()
print(f"工具箱      {state(['p07'])}")
print(f"网站面板    {state(['cloudpanel'])}")
print(f"网站服务    {state(['nginx','mysql','php'])}")
print(f"服务器资源  {state(['disk','memory','swap'])}")
b=rows.get("backup")
if b:
    print(f"本地备份    {'正常' if b['status']=='OK' else '需关注'} · {b['detail']}")
PY
say
ui_note '这里只给运行结论；不会重启服务、修改配置或删除数据。'
ui_pause_return
