#!/usr/bin/env bash
set -euo pipefail
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$ROOT_DIR/lib/terminal_ui.sh"
CORE="$ROOT_DIR/bin/vfops"

current_timezone() {
  timedatectl show -p Timezone --value 2>/dev/null || printf '未知'
}

swap_enabled() {
  swapon --show --noheadings 2>/dev/null | grep -q .
}

basic_settings_ready() {
  [[ "$(current_timezone)" == "Asia/Shanghai" ]] && swap_enabled
}

format_elapsed() {
  local total="${1:-0}"
  printf '%02d:%02d' "$((total / 60))" "$((total % 60))"
}

CLOUDPANEL_INSTALL_OUTPUT=''

render_indeterminate_bar() {
  local step="${1:-0}" width=24 block=5 pos i bar=''
  pos="$((step % (width - block)))"
  for ((i=0; i<width; i++)); do
    if ((i >= pos && i < pos + block - 1)); then
      bar+='='
    elif ((i == pos + block - 1)); then
      bar+='>'
    else
      bar+=' '
    fi
  done
  printf '%s' "$bar"
}

run_cloudpanel_install_with_progress() {
  local log pid rc start now elapsed frame_index=0 bar
  log="$(mktemp -t p07-cloudpanel-install.XXXXXX)"
  CLOUDPANEL_INSTALL_OUTPUT=''

  "$CORE" server-migrate bootstrap-local --confirm BOOTSTRAP_LOCAL_CLOUDPANEL >"$log" 2>&1 &
  pid=$!
  start="$(date +%s)"

  ui_good '1/3 安装前安全检查已通过 ✓'
  if [[ -t 1 ]]; then
    while kill -0 "$pid" 2>/dev/null; do
      now="$(date +%s)"
      elapsed="$((now - start))"
      bar="$(render_indeterminate_bar "$frame_index")"
      printf '\r\033[K2/3 [%s] 正在安装 CloudPanel · 已耗时 %s' "$bar" "$(format_elapsed "$elapsed")"
      sleep 1
      frame_index="$((frame_index + 1))"
    done
    printf '\r\033[K'
  else
    ui_note '2/3 正在安装 CloudPanel；安装时间取决于服务器性能和网络速度。'
  fi

  set +e
  wait "$pid"
  rc=$?
  set -e
  CLOUDPANEL_INSTALL_OUTPUT="$(cat "$log" 2>/dev/null || true)"
  rm -f "$log"

  now="$(date +%s)"
  elapsed="$((now - start))"
  if [[ $rc -eq 0 ]]; then
    ui_good "2/3 CloudPanel 安装完成，用时 $(format_elapsed "$elapsed") ✓"
    ui_good '3/3 安装后检查通过 ✓'
  else
    ui_bad "2/3 CloudPanel 安装未完成，用时 $(format_elapsed "$elapsed")"
  fi
  return "$rc"
}

show_bootstrap_blocker() {
  local details="${1:-}"
  case "$details" in
    *"CloudPanel bootstrap requires root"*)
      ui_bad '需要使用 root 用户执行 CloudPanel 安装检查。'
      ;;
    *"current server OS cannot be identified"*)
      ui_bad '无法识别当前 Linux 系统版本，因此不能安全自动安装 CloudPanel。'
      ;;
    *"unsupported OS for CloudPanel:"*)
      ui_bad '当前 Linux 系统版本不在自动安装支持范围内。'
      ui_note '这属于系统兼容性问题，不是 CPU / 内存 / 磁盘配置限制。'
      ;;
    *"unsupported architecture for CloudPanel"*)
      ui_bad '当前 CPU 架构不在 CloudPanel 自动安装支持范围内。'
      ;;
    *"current server is not empty enough for automatic CloudPanel install:"*)
      local found
      found="$(printf '%s\n' "$details" | sed -n 's/^ERROR: current server is not empty enough for automatic CloudPanel install: //p' | head -n1)"
      ui_bad '检测到这台服务器已经存在网站或数据库环境，为避免覆盖现有环境，自动安装已停止。'
      [[ -n "$found" ]] && ui_note "检测到：$found"
      ui_note '这不是低配限制。若这是你要保留的现有环境，不要继续安装 CloudPanel。'
      ;;
    *"current server is not empty enough for automatic CloudPanel install"*)
      ui_bad '检测到这台服务器已经存在网站或数据库环境，为避免覆盖现有环境，自动安装已停止。'
      ui_note '这不是低配限制。'
      ;;
    *"current server already has Web listeners"*)
      ui_bad '检测到 80 / 443 网站端口已经被其他程序占用，为避免冲突，自动安装已停止。'
      ui_note '这不是低配限制。'
      ;;
    *)
      local reason
      reason="$(printf '%s\n' "$details" | sed -n 's/^ERROR: //p' | head -n1)"
      ui_bad '安装前安全检查未通过。'
      if [[ -n "$reason" ]]; then
        ui_note "检查返回：$reason"
      else
        ui_note '未取得明确原因；请保留本页结果用于排查。'
      fi
      ;;
  esac
}

preflight() {
  ui_page '初始化服务器' '可重复执行：缺少的补齐，已完成的安全跳过'
  ui_section '当前服务器'
  ui_kv '系统' "$( . /etc/os-release 2>/dev/null; printf '%s' "${PRETTY_NAME:-未知}" )"
  ui_kv 'CPU' "$(nproc 2>/dev/null || printf '?') 核"
  ui_kv '内存' "$(awk '/MemTotal/{printf "%.1f GB",$2/1024/1024}' /proc/meminfo 2>/dev/null || printf '?')"
  ui_kv '虚拟内存（Swap）' "$(awk '/^SwapTotal:/{printf "%.1f GB",$2/1024/1024}' /proc/meminfo 2>/dev/null || printf '?')"
  ui_kv '时区' "$(timedatectl show -p Timezone --value 2>/dev/null || printf '未知')"
  ui_kv 'CloudPanel' "$([[ -d /home/clp ]] && printf '已安装' || printf '未安装')"
  ui_kv '基础设置' "$(basic_settings_ready && printf '已完成' || printf '待检查 / 补齐')"
  say
  ui_note '初始化可以安全重复执行；已经正确的设置会跳过，CloudPanel 已健康时不会重复安装。'
  ui_note '建议顺序：先做服务器性能检测 → 再初始化服务器 → 最后迁移网站。'
  ui_note 'CPU / 内存 / 磁盘配置只做提示，不作为禁止安装或迁移的条件。'
  ui_note '不会自动修改 DNS、关闭 SSH 或删除任何网站。'
}

apply_missing_basic_settings() {
  if [[ "$(current_timezone)" != "Asia/Shanghai" ]]; then
    timedatectl set-timezone Asia/Shanghai
  fi
  if ! swap_enabled; then
    if [[ -f /swapfile ]]; then
      swapon /swapfile 2>/dev/null || return 2
    else
      fallocate -l 2G /swapfile
      chmod 600 /swapfile
      mkswap /swapfile >/dev/null
      swapon /swapfile
    fi
    grep -q '^/swapfile ' /etc/fstab || printf '/swapfile none swap sw 0 0\n' >> /etc/fstab
  fi
  return 0
}

cloudpanel_status() {
  local payload
  payload="$("$CORE" server-migrate target-status 2>/dev/null || true)"
  printf '%s' "$payload" | python3 -c 'import json,sys
try: print(json.load(sys.stdin).get("status","UNKNOWN"))
except Exception: print("UNKNOWN")'
}

run_initialization() {
  local answer='' status payload advisories environment_advisories
  ui_page '初始化 / 重新初始化服务器' '安全重跑初始化流程；已完成项目自动跳过'
  ui_section '1/2 基础设置'

  if [[ "$(current_timezone)" == "Asia/Shanghai" ]]; then
    ui_good '时区：Asia/Shanghai ✓'
  else
    ui_attention "时区：$(current_timezone) → 待补齐"
  fi
  if swap_enabled; then
    ui_good '虚拟内存（Swap）：已启用 ✓'
  else
    ui_attention '虚拟内存（Swap）：未启用 → 待补齐'
  fi

  if ! basic_settings_ready; then
    ui_prompt '发现缺少的基础设置，确认现在补齐？[y/N]：'
    read -r answer || answer=''
    if [[ "$answer" =~ ^[Yy]$ ]]; then
      if apply_missing_basic_settings; then
        ui_good '基础设置已补齐 ✓'
      else
        ui_bad '基础设置未全部补齐；检测到已有 /swapfile 但无法安全启用。'
      fi
    else
      ui_note '已跳过基础设置修改。'
    fi
  else
    ui_good '基础设置：已完成，安全跳过 ✓'
  fi

  say
  ui_section '2/2 CloudPanel'
  status="$(cloudpanel_status)"
  if [[ "$status" == "CLOUDPANEL_READY" ]]; then
    ui_good 'CloudPanel：已安装并可用 ✓'
    ui_good 'CloudPanel：已完成，安全跳过，不会重复安装 ✓'
  else
    ui_attention 'CloudPanel：未安装或当前未就绪'
    ui_note '正在执行安装前安全检查；检查不通过就不会安装。'
    if ! payload="$("$CORE" server-migrate target-status --bootstrap-preflight 2>&1)"; then
      show_bootstrap_blocker "$payload"
    else
      ui_good 'CloudPanel 安装前安全检查通过 ✓'
      advisories="$(printf '%s' "$payload" | python3 -c 'import json,sys
try:
    data=json.load(sys.stdin)
    print("\n".join(data.get("hardware_advisories") or []))
except Exception:
    pass' 2>/dev/null || true)"
      environment_advisories="$(printf '%s' "$payload" | python3 -c 'import json,sys
try:
    data=json.load(sys.stdin)
    print("\n".join(data.get("environment_advisories") or []))
except Exception:
    pass' 2>/dev/null || true)"
      if grep -q 'CPU_BELOW_CLOUDPANEL_PUBLISHED_BASELINE' <<<"$advisories"; then
        ui_attention 'CPU 低于 CloudPanel 官方公布的 1 核基线；这里只提示，不限制安装。'
      fi
      if grep -q 'MEMORY_BELOW_CLOUDPANEL_PUBLISHED_BASELINE' <<<"$advisories"; then
        ui_attention '内存低于 CloudPanel 官方公布的 2 GB 基线；这里只提示，不限制安装。'
      fi
      if grep -q 'DISK_BELOW_CLOUDPANEL_PUBLISHED_BASELINE' <<<"$advisories"; then
        ui_attention '磁盘低于 CloudPanel 官方公布的 10 GB 基线；这里只提示，不限制安装。'
      fi
      if grep -q 'STALE_CONFIG_DIR:/etc/nginx' <<<"$environment_advisories"; then
        ui_attention '检测到残留目录 /etc/nginx，但未发现 Nginx 程序；只提示，不阻止安装。'
      fi
      if grep -q 'STALE_CONFIG_DIR:/etc/apache2' <<<"$environment_advisories"; then
        ui_attention '检测到残留目录 /etc/apache2，但未发现 Apache 程序；只提示，不阻止安装。'
      fi
      ui_note '是否继续由你决定；服务器工具箱不会因为低配而拒绝安装。'
      ui_prompt 'CloudPanel 尚未安装，确认现在安装？[y/N]：'
      read -r answer || answer=''
      if [[ "$answer" =~ ^[Yy]$ ]]; then
        if run_cloudpanel_install_with_progress; then
          ui_result_ok 'CloudPanel 安装完成'
        else
          ui_result_error 'CloudPanel 安装未完成'
          [[ -n "$CLOUDPANEL_INSTALL_OUTPUT" ]] && ui_note "$(printf '%s\n' "$CLOUDPANEL_INSTALL_OUTPUT" | tail -n 1)"
        fi
      else
        ui_note '已跳过 CloudPanel 安装。'
      fi
    fi
  fi

  status="$(cloudpanel_status)"
  say
  if basic_settings_ready && [[ "$status" == "CLOUDPANEL_READY" ]]; then
    ui_result_ok '服务器初始化完成'
  else
    ui_attention '服务器初始化仍有未完成项目；可以再次运行本入口继续补齐。'
  fi
  ui_pause_return
}

while true; do
  answer=""
  preflight
  ui_menu_flow 1 '初始化 / 重新初始化服务器（推荐）'
  ui_menu_warn 2 '基础设置（时区 / Swap）'
  ui_menu_warn 3 'CloudPanel 状态 / 安装'
  ui_menu_back 0 '返回'
  ui_prompt '请选择 [0-3]：'; read -r choice || exit 0
  case "$choice" in
    1)
      run_initialization
      ;;
    2)
      ui_page '检查 / 补齐基础设置' '可重复执行，只补缺少的设置'
      timezone_now="$(current_timezone)"
      if [[ "$timezone_now" == "Asia/Shanghai" ]]; then
        ui_good '时区：Asia/Shanghai ✓'
      else
        ui_attention "时区：$timezone_now → 待设置为 Asia/Shanghai"
      fi
      if swap_enabled; then
        ui_good '虚拟内存（Swap）：已启用 ✓'
      else
        ui_attention '虚拟内存（Swap）：未启用 → 待创建 / 启用 2GB'
      fi

      if basic_settings_ready; then
        ui_result_ok '基础设置已经完成，无需重复修改'
        ui_note '你以后仍可以再次进入这里复查。'
        ui_pause_return
        continue
      fi

      ui_safety_tier write '只补齐缺少的时区 / Swap；已经正确的项目会跳过。'
      ui_prompt '确认补齐缺少的基础设置？[y/N]：'
      read -r answer || continue
      if [[ "$answer" =~ ^[Yy]$ ]]; then
        if ! apply_missing_basic_settings; then
          ui_result_error '检测到已有 /swapfile，但无法安全启用；未覆盖这个文件。'
          ui_pause_return
          continue
        fi
        ui_result_ok '基础设置已补齐'
        ui_note '未修改 DNS；未关闭 SSH；未删除任何服务。'
        ui_pause_return
      fi
      ;;
    3)
      ui_page 'CloudPanel 状态 / 安装' '网站面板'
      ui_safety_tier write '安装 CloudPanel 会写入系统，只允许在准备作为新服务器的机器上执行。'
      status="$(cloudpanel_status)"
      if [[ "$status" == "CLOUDPANEL_READY" ]]; then
        ui_good 'CloudPanel 已安装并可用 ✓'
        ui_note '不会重复安装。初始化入口仍然可以继续用于复查或补齐时区 / Swap。'
        ui_pause_return
        continue
      fi

      ui_note '先做空服务器安全检查；检查不通过就不会安装。'
      if ! payload="$("$CORE" server-migrate target-status --bootstrap-preflight 2>&1)"; then
        show_bootstrap_blocker "$payload"
        ui_pause_return
        continue
      fi
      ui_good '安装前安全检查通过 ✓'
      advisories="$(printf '%s' "$payload" | python3 -c 'import json,sys
try:
    data=json.load(sys.stdin)
    print("\n".join(data.get("hardware_advisories") or []))
except Exception:
    pass' 2>/dev/null || true)"
      environment_advisories="$(printf '%s' "$payload" | python3 -c 'import json,sys
try:
    data=json.load(sys.stdin)
    print("\n".join(data.get("environment_advisories") or []))
except Exception:
    pass' 2>/dev/null || true)"
      if grep -q 'CPU_BELOW_CLOUDPANEL_PUBLISHED_BASELINE' <<<"$advisories"; then
        ui_attention 'CPU 低于 CloudPanel 官方公布的 1 核基线；这里只提示，不限制安装。'
      fi
      if grep -q 'MEMORY_BELOW_CLOUDPANEL_PUBLISHED_BASELINE' <<<"$advisories"; then
        ui_attention '内存低于 CloudPanel 官方公布的 2 GB 基线；这里只提示，不限制安装。'
      fi
      if grep -q 'DISK_BELOW_CLOUDPANEL_PUBLISHED_BASELINE' <<<"$advisories"; then
        ui_attention '磁盘低于 CloudPanel 官方公布的 10 GB 基线；这里只提示，不限制安装。'
      fi
      if grep -q 'STALE_CONFIG_DIR:/etc/nginx' <<<"$environment_advisories"; then
        ui_attention '检测到残留目录 /etc/nginx，但未发现 Nginx 程序；只提示，不阻止安装。'
      fi
      if grep -q 'STALE_CONFIG_DIR:/etc/apache2' <<<"$environment_advisories"; then
        ui_attention '检测到残留目录 /etc/apache2，但未发现 Apache 程序；只提示，不阻止安装。'
      fi
      ui_note '是否继续由你决定；服务器工具箱不会因为低配而拒绝安装。'
      ui_prompt '确认安装 CloudPanel？[y/N]：'
      read -r answer || continue
      if [[ "$answer" =~ ^[Yy]$ ]]; then
        if run_cloudpanel_install_with_progress; then
          ui_result_ok 'CloudPanel 安装完成'
        else
          ui_result_error 'CloudPanel 安装未完成'
          [[ -n "$CLOUDPANEL_INSTALL_OUTPUT" ]] && ui_note "$(printf '%s\n' "$CLOUDPANEL_INSTALL_OUTPUT" | tail -n 1)"
        fi
      fi
      ui_pause_return
      ;;
    0) exit 0 ;;
    *) ui_attention '请输入 0-3。'; ui_pause_return ;;
  esac
done
