#!/usr/bin/env bash
set -euo pipefail
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$ROOT_DIR/lib/terminal_ui.sh"
CORE="$ROOT_DIR/bin/vfops"

preflight() {
  ui_page 'P07 · 初始化服务器' '先检查，再决定是否写入'
  ui_section '当前服务器'
  ui_kv '系统' "$( . /etc/os-release 2>/dev/null; printf '%s' "${PRETTY_NAME:-未知}" )"
  ui_kv 'CPU' "$(nproc 2>/dev/null || printf '?') 核"
  ui_kv '内存' "$(awk '/MemTotal/{printf "%.1f GB",$2/1024/1024}' /proc/meminfo 2>/dev/null || printf '?')"
  ui_kv '虚拟内存（Swap）' "$(awk '/^SwapTotal:/{printf "%.1f GB",$2/1024/1024}' /proc/meminfo 2>/dev/null || printf '?')"
  ui_kv '时区' "$(timedatectl show -p Timezone --value 2>/dev/null || printf '未知')"
  ui_kv 'CloudPanel' "$([[ -d /home/clp ]] && printf '已检测' || printf '未检测')"
  say
  ui_section '初始化路线'
  say '1. 基础检查与安全基线'
  say '2. 虚拟内存（Swap） / 时区等低风险基础项'
  say '3. 面板准备（CloudPanel）'
  say '4. P07 备份 / 诊断接入'
  say
  ui_note '远程登录（SSH）锁定、防火墙收紧、域名解析（DNS）修改都不会自动执行，避免把自己锁在服务器外。'
}
while true; do
  answer=""
  preflight
  ui_menu_good 1 '重新检查'
  ui_menu_warn 2 '应用低风险基础项'
  ui_menu_warn 3 '准备 / 安装网站面板（CloudPanel）'
  ui_menu_info 4 '查看初始化完成条件'
  ui_menu_back 0 '返回'
  ui_prompt '请选择 [0-4]：'; read -r choice || exit 0
  case "$choice" in
    1) ;;
    2)
      ui_page 'P07 · 初始化写入确认'
      ui_safety_tier write '当前只允许：时区 Asia/Shanghai；缺少虚拟内存（Swap）时创建 2GB Swap。'
      ui_prompt '确认应用这些基础设置？[y/N]：'
      read -r answer || continue
      if [[ "$answer" =~ ^[Yy]$ ]]; then
        timedatectl set-timezone Asia/Shanghai
        if ! swapon --show --noheadings 2>/dev/null | grep -q .; then
          fallocate -l 2G /swapfile
          chmod 600 /swapfile
          mkswap /swapfile >/dev/null
          swapon /swapfile
          grep -q '^/swapfile ' /etc/fstab || printf '/swapfile none swap sw 0 0\n' >> /etc/fstab
        fi
        ui_result_ok 'P07 · 基础项完成'
        ui_note '未修改 DNS；未关闭 SSH；未删除任何服务。'
        ui_pause_return
      fi
      ;;
    3)
      ui_page 'P07 · 面板准备（CloudPanel）'
      ui_safety_tier write 'CloudPanel 安装属于明显系统写入，只允许空白、受支持的新服务器执行。'
      payload="$("$CORE" server-migrate target-status 2>/dev/null || true)"
      status="$(printf '%s' "$payload" | python3 -c 'import json,sys; 
try: print(json.load(sys.stdin).get("status","UNKNOWN"))
except Exception: print("UNKNOWN")')"
      if [[ "$status" == "CLOUDPANEL_READY" ]]; then
        ui_good 'CloudPanel 当前已就绪，无需重复安装。'
        ui_pause_return
        continue
      fi

      ui_note '先做空服务器安全预检；检查不通过就不会安装。'
      if ! payload="$("$CORE" server-migrate target-status --bootstrap-preflight 2>&1)"; then
        ui_bad '当前服务器不满足 CloudPanel 自动安装条件。'
        ui_pause_return
        continue
      fi
      ui_good '空服务器安全预检通过 ✓'
      ui_prompt '确认安装 CloudPanel？[y/N]：'
      read -r answer || continue
      if [[ "$answer" =~ ^[Yy]$ ]]; then
        if "$CORE" server-migrate bootstrap-local --confirm BOOTSTRAP_LOCAL_CLOUDPANEL; then
          ui_result_ok 'P07 · CloudPanel 安装完成'
        else
          ui_result_error 'CloudPanel 安装未完成'
        fi
      fi
      ui_pause_return
      ;;
    4)
      ui_page 'P07 · 初始化完成条件'
      say '✓ 服务器性能检测结果可接受'
      say '✓ 时区 / 虚拟内存（Swap） 符合基线'
      say '✓ 网站面板、网页服务、数据库和网站运行环境均可用'
      say '✓ P07 自检通过'
      say '✓ 本地备份路径可用'
      say '✓ 异地备份按需要完成配置'
      say '✓ 诊断中心没有阻断级异常'
      say
      ui_note 'DNS、生产切流、旧服务器删除均不属于初始化自动步骤。'
      ui_pause_return
      ;;
    0) exit 0 ;;
    *) ui_attention '请输入 0-4。'; ui_pause_return ;;
  esac
done
