#!/usr/bin/env bash
set -euo pipefail
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$ROOT_DIR/lib/terminal_ui.sh"
CORE="$ROOT_DIR/bin/vfops"

show_bootstrap_blocker() {
  local details="${1:-}"
  case "$details" in
    *"CloudPanel bootstrap requires root"*)
      ui_bad '需要使用 root 用户执行 CloudPanel 安装检查。'
      ;;
    *"current server OS cannot be identified"*)
      ui_bad '无法识别当前 Linux 系统版本，因此不能安全自动安装 CloudPanel。'
      ;;
    *"unsupported OS for CloudPanel:"*)
      ui_bad '当前 Linux 系统版本不在自动安装支持范围内。'
      ui_note '这属于系统兼容性问题，不是 CPU / 内存 / 磁盘配置限制。'
      ;;
    *"unsupported architecture for CloudPanel"*)
      ui_bad '当前 CPU 架构不在 CloudPanel 自动安装支持范围内。'
      ;;
    *"current server is not empty enough for automatic CloudPanel install:"*)
      local found
      found="$(printf '%s\n' "$details" | sed -n 's/^ERROR: current server is not empty enough for automatic CloudPanel install: //p' | head -n1)"
      ui_bad '检测到这台服务器已经存在网站或数据库环境，为避免覆盖现有环境，自动安装已停止。'
      [[ -n "$found" ]] && ui_note "检测到：$found"
      ui_note '这不是低配限制。若这是你要保留的现有环境，不要继续安装 CloudPanel。'
      ;;
    *"current server is not empty enough for automatic CloudPanel install"*)
      ui_bad '检测到这台服务器已经存在网站或数据库环境，为避免覆盖现有环境，自动安装已停止。'
      ui_note '这不是低配限制。'
      ;;
    *"current server already has Web listeners"*)
      ui_bad '检测到 80 / 443 网站端口已经被其他程序占用，为避免冲突，自动安装已停止。'
      ui_note '这不是低配限制。'
      ;;
    *)
      local reason
      reason="$(printf '%s\n' "$details" | sed -n 's/^ERROR: //p' | head -n1)"
      ui_bad '安装前安全检查未通过。'
      if [[ -n "$reason" ]]; then
        ui_note "检查返回：$reason"
      else
        ui_note '未取得明确原因；请保留本页结果用于排查。'
      fi
      ;;
  esac
}

preflight() {
  ui_page '初始化服务器' '新服务器第一次使用时在这里完成基础设置'
  ui_section '当前服务器'
  ui_kv '系统' "$( . /etc/os-release 2>/dev/null; printf '%s' "${PRETTY_NAME:-未知}" )"
  ui_kv 'CPU' "$(nproc 2>/dev/null || printf '?') 核"
  ui_kv '内存' "$(awk '/MemTotal/{printf "%.1f GB",$2/1024/1024}' /proc/meminfo 2>/dev/null || printf '?')"
  ui_kv '虚拟内存（Swap）' "$(awk '/^SwapTotal:/{printf "%.1f GB",$2/1024/1024}' /proc/meminfo 2>/dev/null || printf '?')"
  ui_kv '时区' "$(timedatectl show -p Timezone --value 2>/dev/null || printf '未知')"
  ui_kv 'CloudPanel' "$([[ -d /home/clp ]] && printf '已安装' || printf '未安装')"
  say
  ui_note '建议顺序：先做服务器性能检测 → 再初始化服务器 → 最后迁移网站。'
  ui_note 'CPU / 内存 / 磁盘配置只做提示，不作为禁止安装或迁移的条件。'
  ui_note '不会自动修改 DNS、关闭 SSH 或删除任何网站。'
}

while true; do
  answer=""
  preflight
  ui_menu_warn 1 '应用基础设置（时区 / Swap）'
  ui_menu_warn 2 '检查 / 安装 CloudPanel'
  ui_menu_back 0 '返回'
  ui_prompt '请选择 [0-2]：'; read -r choice || exit 0
  case "$choice" in
    1)
      ui_page '应用基础设置' '只处理时区和虚拟内存（Swap）'
      ui_safety_tier write '时区设置为 Asia/Shanghai；如果没有 Swap，则创建 2GB Swap。'
      ui_prompt '确认应用这些基础设置？[y/N]：'
      read -r answer || continue
      if [[ "$answer" =~ ^[Yy]$ ]]; then
        timedatectl set-timezone Asia/Shanghai
        if ! swapon --show --noheadings 2>/dev/null | grep -q .; then
          fallocate -l 2G /swapfile
          chmod 600 /swapfile
          mkswap /swapfile >/dev/null
          swapon /swapfile
          grep -q '^/swapfile ' /etc/fstab || printf '/swapfile none swap sw 0 0\n' >> /etc/fstab
        fi
        ui_result_ok '基础设置完成'
        ui_note '未修改 DNS；未关闭 SSH；未删除任何服务。'
        ui_pause_return
      fi
      ;;
    2)
      ui_page '检查 / 安装 CloudPanel' '网站面板'
      ui_safety_tier write '安装 CloudPanel 会写入系统，只允许在准备作为新服务器的机器上执行。'
      payload="$("$CORE" server-migrate target-status 2>/dev/null || true)"
      status="$(printf '%s' "$payload" | python3 -c 'import json,sys
try: print(json.load(sys.stdin).get("status","UNKNOWN"))
except Exception: print("UNKNOWN")')"
      if [[ "$status" == "CLOUDPANEL_READY" ]]; then
        ui_good 'CloudPanel 已安装并可用 ✓'
        ui_pause_return
        continue
      fi

      ui_note '先做空服务器安全检查；检查不通过就不会安装。'
      if ! payload="$("$CORE" server-migrate target-status --bootstrap-preflight 2>&1)"; then
        show_bootstrap_blocker "$payload"
        ui_pause_return
        continue
      fi
      ui_good '安装前安全检查通过 ✓'
      advisories="$(printf '%s' "$payload" | python3 -c 'import json,sys
try:
    data=json.load(sys.stdin)
    print("\n".join(data.get("hardware_advisories") or []))
except Exception:
    pass' 2>/dev/null || true)"
      environment_advisories="$(printf '%s' "$payload" | python3 -c 'import json,sys
try:
    data=json.load(sys.stdin)
    print("\n".join(data.get("environment_advisories") or []))
except Exception:
    pass' 2>/dev/null || true)"
      if grep -q 'CPU_BELOW_CLOUDPANEL_PUBLISHED_BASELINE' <<<"$advisories"; then
        ui_attention 'CPU 低于 CloudPanel 官方公布的 1 核基线；这里只提示，不限制安装。'
      fi
      if grep -q 'MEMORY_BELOW_CLOUDPANEL_PUBLISHED_BASELINE' <<<"$advisories"; then
        ui_attention '内存低于 CloudPanel 官方公布的 2 GB 基线；这里只提示，不限制安装。'
      fi
      if grep -q 'DISK_BELOW_CLOUDPANEL_PUBLISHED_BASELINE' <<<"$advisories"; then
        ui_attention '磁盘低于 CloudPanel 官方公布的 10 GB 基线；这里只提示，不限制安装。'
      fi
      if grep -q 'STALE_CONFIG_DIR:/etc/nginx' <<<"$environment_advisories"; then
        ui_attention '检测到残留目录 /etc/nginx，但未发现 Nginx 程序；只提示，不阻止安装。'
      fi
      if grep -q 'STALE_CONFIG_DIR:/etc/apache2' <<<"$environment_advisories"; then
        ui_attention '检测到残留目录 /etc/apache2，但未发现 Apache 程序；只提示，不阻止安装。'
      fi
      ui_note '是否继续由你决定；服务器工具箱不会因为低配而拒绝安装。'
      ui_prompt '确认安装 CloudPanel？[y/N]：'
      read -r answer || continue
      if [[ "$answer" =~ ^[Yy]$ ]]; then
        if "$CORE" server-migrate bootstrap-local --confirm BOOTSTRAP_LOCAL_CLOUDPANEL; then
          ui_result_ok 'CloudPanel 安装完成'
        else
          ui_result_error 'CloudPanel 安装未完成'
        fi
      fi
      ui_pause_return
      ;;
    0) exit 0 ;;
    *) ui_attention '请输入 0-2。'; ui_pause_return ;;
  esac
done
