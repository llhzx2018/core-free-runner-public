#!/usr/bin/env bash
set -euo pipefail
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$ROOT_DIR/lib/terminal_ui.sh"
ENGINE="$ROOT_DIR/lib/ops_history.py"

ui_page '最近操作' '本机操作记录'
raw="$(python3 "$ENGINE" list --limit 10 --json 2>/dev/null || printf '[]')"
RAW="$raw" C_GREEN="$C_GREEN" C_YELLOW="$C_YELLOW" C_RED="$C_RED" C_RESET="$C_RESET" python3 - <<'PY'
import json,os
rows=json.loads(os.environ["RAW"])
if not rows:
    print("暂无操作记录。")
else:
    def color(name): return os.environ.get(name,"").replace("\\033", chr(27))
    colors={"成功":color("C_GREEN"),"失败":color("C_RED"),"提醒":color("C_YELLOW")}
    reset=color("C_RESET")
    for r in rows:
        ts=str(r.get("ts","")).replace("T"," ")[:19]
        result=str(r.get("result",""))
        detail=(" · "+str(r.get("detail"))) if r.get("detail") else ""
        print(f"{ts}  {colors.get(result,'')}{result}{reset}  {r.get('action','')}{detail}")
PY
say
ui_note '只记录动作、结果和简短摘要；不记录认证资料。'
ui_pause_return
