#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$ROOT_DIR/lib/terminal_ui.sh"
CORE="$ROOT_DIR/bin/vfops"

SOURCE_IDENTITY_FILE=""
SOURCE_IDENTITY_MANAGED=0
SSH_PREFLIGHT_STATE="UNKNOWN"

pause() { ui_pause_return; }

format_elapsed() {
  local total="${1:-0}"
  printf '%02d:%02d' "$((total / 60))" "$((total % 60))"
}

render_indeterminate_bar() {
  local step="${1:-0}" width=24 block=5 pos i bar=''
  pos="$((step % (width - block)))"
  for ((i=0; i<width; i++)); do
    if ((i >= pos && i < pos + block - 1)); then
      bar+='='
    elif ((i == pos + block - 1)); then
      bar+='>'
    else
      bar+=' '
    fi
  done
  printf '%s' "$bar"
}

migration_wait_label() {
  local all=" $* "
  case "$all" in
    *" server-migrate cutover "*) printf '最终同步处理中' ;;
    *" server-migrate resume "*) printf '继续迁入处理中' ;;
    *" server-migrate prepare "*) printf '首轮迁入处理中' ;;
    *" server-migrate finalize "*) printf '公网验证处理中' ;;
    *" fresh-17site preview "*) printf '检查全新CP2及旧VPS三个数据库' ;;
    *" fresh-17site prepare "*) printf '首轮迁入17站' ;;
    *" server-migrate plan "*) printf '正在读取迁移清单' ;;
    *" server-migrate target-status "*) printf '正在检查新服务器状态' ;;
    *" server-migrate status "*) printf '正在读取迁移状态' ;;
    *) printf '迁移处理中' ;;
  esac
}

WAIT_PAYLOAD=''
MIGRATION_PAYLOAD=''

run_quiet_with_progress() {
  local label="$1"
  shift
  local tmp pid rc start now elapsed frame_index=0 bar
  tmp="$(mktemp)"
  WAIT_PAYLOAD=''

  "$@" >"$tmp" 2>&1 &
  pid=$!
  start="$(date +%s)"

  if [[ -t 1 ]]; then
    while kill -0 "$pid" 2>/dev/null; do
      now="$(date +%s)"
      elapsed="$((now - start))"
      bar="$(render_indeterminate_bar "$frame_index")"
      printf '\r\033[K[%s] %s · 已耗时 %s' "$bar" "$label" "$(format_elapsed "$elapsed")"
      sleep 1
      frame_index="$((frame_index + 1))"
    done
    printf '\r\033[K'
  fi

  set +e
  wait "$pid"
  rc=$?
  set -e
  WAIT_PAYLOAD="$(cat "$tmp" 2>/dev/null || true)"
  rm -f "$tmp"
  return "$rc"
}

run_migration_live() {
  local tmp activity pid rc start now elapsed frame_index=0 bar
  local last_size=0 current_size=0 quiet_ticks=0 label
  tmp="$(mktemp)"
  activity="$(mktemp)"
  label="$(migration_wait_label "$@")"
  MIGRATION_PAYLOAD=''

  VFOPS_MIGRATION_PROGRESS=1 "$CORE" "$@" >"$tmp" 2> >(tee "$activity" >&2) &
  pid=$!
  start="$(date +%s)"

  if [[ -t 1 ]]; then
    while kill -0 "$pid" 2>/dev/null; do
      current_size="$(wc -c <"$activity" 2>/dev/null || printf 0)"
      if [[ "$current_size" == "$last_size" ]]; then
        quiet_ticks="$((quiet_ticks + 1))"
        if (( quiet_ticks >= 2 )); then
          now="$(date +%s)"
          elapsed="$((now - start))"
          bar="$(render_indeterminate_bar "$frame_index")"
          printf '\r\033[K[%s] %s · 已耗时 %s' "$bar" "$label" "$(format_elapsed "$elapsed")"
          frame_index="$((frame_index + 1))"
        fi
      else
        if (( quiet_ticks >= 2 )); then
          printf '\r\033[K'
        fi
        last_size="$current_size"
        quiet_ticks=0
      fi
      sleep 1
    done
    if (( quiet_ticks >= 2 )); then
      printf '\r\033[K'
    fi
  else
    ui_note "$label；文件传输阶段会继续输出 rsync 百分比 / 速度。"
  fi

  set +e
  wait "$pid"
  rc=$?
  set -e
  MIGRATION_PAYLOAD="$(cat "$tmp" 2>/dev/null || true)"
  rm -f "$tmp" "$activity"
  return "$rc"
}

validate_ip() {
  python3 - "$1" <<'PY' >/dev/null 2>&1
import ipaddress,sys
ipaddress.ip_address(sys.argv[1])
PY
}

json_field() {
  local payload="$1" field="$2"
  PAYLOAD_JSON="$payload" python3 - "$field" <<'PY'
import json,os,sys
field=sys.argv[1]
try:
    value=json.loads(os.environ["PAYLOAD_JSON"])
except Exception:
    raise SystemExit(2)
for part in field.split("."):
    if not isinstance(value,dict) or part not in value:
        raise SystemExit(2)
    value=value[part]
if isinstance(value,(dict,list)):
    print(json.dumps(value,ensure_ascii=False))
elif value is None:
    print("")
else:
    print(value)
PY
}

migration_status_label() {
  case "$1" in
    PRODUCTION_PASS) printf '正式环境验证通过' ;;
    PREPARED) printf '首轮迁入已完成' ;;
    CUTOVER_PREP_READY) printf '最终同步完成，等待 DNS 人工切换' ;;
    WAITING_DNS) printf '等待 DNS 生效' ;;
    PREPARING) printf '正在首轮迁入' ;;
    CUTOVER_RUNNING) printf '正在最终增量同步' ;;
    PREPARE_FAILED) printf '首轮迁入失败，需核验恢复条件' ;;
    PRODUCTION_VERIFY_FAILED) printf '公网验证未通过，可重试' ;;
    CUTOVER_FAILED_ROLLED_BACK) printf '最终同步失败，旧服务器已恢复' ;;
    CUTOVER_FAILED_ROLLBACK_PARTIAL) printf '最终同步失败，恢复不完整' ;;
    ROLLED_BACK) printf '已回退到旧服务器运行' ;;
    ROLLBACK_PARTIAL) printf '回退不完整，需要检查' ;;
    *) printf '未知状态' ;;
  esac
}

migration_status_color() {
  local label
  label="$(migration_status_label "$1")"
  case "$1" in
    PRODUCTION_PASS) printf '%b' "${C_GREEN}$label${C_RESET}" ;;
    PREPARED|CUTOVER_PREP_READY|WAITING_DNS) printf '%b' "${C_YELLOW}$label${C_RESET}" ;;
    PREPARING|CUTOVER_RUNNING) printf '%b' "${C_MAGENTA}$label${C_RESET}" ;;
    *) printf '%b' "${C_RED}$label${C_RESET}" ;;
  esac
}

ensure_migration_dependencies() {
  local -a missing=()
  local cmd
  for cmd in ssh ssh-copy-id ssh-keygen rsync; do
    command -v "$cmd" >/dev/null 2>&1 || missing+=("$cmd")
  done
  if (("${#missing[@]}")); then
    ui_attention '首次使用服务器迁移，需要远程连接和文件同步组件（SSH / rsync）；只在真正开始迁移时按需准备，不影响其它功能。'
    command -v apt-get >/dev/null 2>&1 || {
      ui_bad "当前系统缺少迁移依赖：${missing[*]}，且没有 apt-get。"
      return 1
    }
    ui_note '只安装服务器迁移当前需要的依赖：openssh-client + rsync'
    apt-get update -y >/dev/null || { ui_bad '软件源更新失败。'; return 1; }
    DEBIAN_FRONTEND=noninteractive apt-get install -y openssh-client rsync >/dev/null || {
      ui_bad '服务器迁移依赖安装失败。'
      return 1
    }
  fi
  for cmd in ssh ssh-copy-id ssh-keygen rsync; do
    command -v "$cmd" >/dev/null 2>&1 || { ui_bad "迁移依赖仍不可用：$cmd"; return 1; }
  done
}

ensure_current_server_ready() {
  local payload status answer
  if ! run_quiet_with_progress '正在检查新服务器状态' "$CORE" server-migrate target-status; then
    ui_bad '无法检查当前服务器。'
    return 1
  fi
  payload="$WAIT_PAYLOAD"
  status="$(json_field "$payload" status 2>/dev/null || printf UNKNOWN)"
  if [[ "$status" == "CLOUDPANEL_READY" ]]; then
    ui_good '当前：这台新服务器（接收数据） · CloudPanel 已就绪 ✓'
    return 0
  fi

  ui_attention '当前服务器还没有完成初始化。'
  ui_note '可从本页直接打开 P07 初始化向导；向导会独立检查空服务器及安装权限，绝不覆盖已有业务。'
  ui_prompt '现在进入初始化向导？[y/N]：'
  read -r answer || return 1
  if [[ "$answer" =~ ^[Yy]$ ]]; then
    if ! bash "$ROOT_DIR/bin/vfops-init-ui"; then
      ui_bad '初始化向导未正常完成，请先查看页面结果。'
      return 1
    fi
    if run_quiet_with_progress '复查新服务器环境' "$CORE" server-migrate target-status; then
      status="$(json_field "$WAIT_PAYLOAD" status 2>/dev/null || printf UNKNOWN)"
      if [[ "$status" == 'CLOUDPANEL_READY' ]]; then
        ui_good '新服务器 CloudPanel 已就绪 ✓'
        return 0
      fi
    fi
    ui_attention 'CloudPanel 还未达到迁移条件；请先完成初始化界面提示的必要步骤。'
  fi
  return 1
}

source_ssh_preflight() {
  local old_ip="$1" identity_file="${2:-}" output rc
  local -a id_args=()
  [[ -n "$identity_file" ]] && id_args=(-i "$identity_file")
  SSH_PREFLIGHT_STATE="UNKNOWN"
  if output="$(ssh -p 22 -o BatchMode=yes -o StrictHostKeyChecking=accept-new -o ConnectTimeout=10 \
    -o ServerAliveInterval=10 -o ServerAliveCountMax=1 "${id_args[@]}" "root@${old_ip}" \
    "set -eu; printf P07_SSH_READY; command -v clpctl >/dev/null 2>&1; test -f /home/clp/htdocs/app/data/db.sq3" 2>&1)"; then
    SSH_PREFLIGHT_STATE="READY"
    ui_good '旧服务器远程登录：已就绪 ✓'
    ui_good '旧服务器网站面板（CloudPanel）：已识别 ✓'
    return 0
  else
    rc=$?
  fi
  if printf '%s\n' "$output" | grep -Eqi 'permission denied|publickey|no supported authentication methods'; then
    SSH_PREFLIGHT_STATE="NEEDS_KEY_SETUP"
    ui_attention '这台新服务器还没有旧服务器的远程登录权限（SSH 密钥）。'
    return 10
  fi
  if printf '%s\n' "$output" | grep -Fq 'P07_SSH_READY'; then
    SSH_PREFLIGHT_STATE="OLD_NOT_CLOUDPANEL"
    ui_bad '远程登录（SSH）可以连接，但旧服务器未检测到可用的网站面板（CloudPanel）。'
    ui_note '请确认旧服务器确实是要迁出的 CloudPanel 网站服务器。'
    return 11
  fi
  SSH_PREFLIGHT_STATE="UNREACHABLE"
  ui_bad "无法连接旧服务器：$old_ip"
  ui_note '请检查旧服务器 IP、远程登录端口、防火墙和远程登录（SSH）服务。'
  return "$rc"
}

prepare_source_key() {
  local old_ip="$1" ssh_dir="${HOME:-/root}/.ssh" token key marker
  token="$(python3 - "$old_ip" <<'PY'
import hashlib,sys
print(hashlib.sha256(sys.argv[1].encode()).hexdigest()[:12])
PY
)"
  key="$ssh_dir/vfops-old-server-$token"
  marker="$key.vfops-managed"
  mkdir -p "$ssh_dir"; chmod 700 "$ssh_dir"

  if [[ -e "$key" || -e "$key.pub" || -e "$marker" ]]; then
    if [[ ! -f "$key" || ! -f "$key.pub" || ! -f "$marker" ]] || \
       [[ "$(cat "$marker" 2>/dev/null || true)" != "VFOPS_MANAGED_OLD_SERVER_KEY_V1" ]]; then
      ui_bad '发现同名远程登录（SSH）文件，但无法确认是否由本工具创建；为避免误用，迁移停止。'
      return 1
    fi
    if source_ssh_preflight "$old_ip" "$key"; then
      SOURCE_IDENTITY_FILE="$key"
      SOURCE_IDENTITY_MANAGED=1
      ui_good '已复用之前创建的旧服务器迁移密钥 ✓'
      return 0
    fi
  else
    ssh-keygen -q -t ed25519 -f "$key" -N '' -C "p07-old-server-$token" || return 1
    chmod 600 "$key"; chmod 644 "$key.pub"
    printf '%s\n' 'VFOPS_MANAGED_OLD_SERVER_KEY_V1' >"$marker"
    chmod 600 "$marker"
  fi

  printf '\n如果系统询问 root 密码，请输入“旧服务器”的 root 密码。\n'
  printf '密码只交给系统 ssh-copy-id；工具不读取、不保存。\n'
  if ! ssh-copy-id -i "$key.pub" -o StrictHostKeyChecking=accept-new "root@${old_ip}"; then
    ui_bad '远程登录密钥（SSH）授权失败；迁移尚未开始。'
    return 1
  fi
  SOURCE_IDENTITY_FILE="$key"
  SOURCE_IDENTITY_MANAGED=1
  source_ssh_preflight "$old_ip" "$key"
}

ensure_source_access() {
  local old_ip="$1" rc
  SOURCE_IDENTITY_FILE=""
  SOURCE_IDENTITY_MANAGED=0
  if source_ssh_preflight "$old_ip"; then
    return 0
  else
    rc=$?
  fi
  [[ "$rc" -eq 10 ]] || return 1
  ui_note '第一次连接旧服务器，需要输入旧服务器 root 密码一次，用来建立后续迁移的专用 SSH 密钥。'
  ui_note '密码只交给系统 ssh-copy-id；P07 不读取、不保存。'
  prepare_source_key "$old_ip"
}

OLD_SERVER_IP=""
read_old_ip() {
  local value
  OLD_SERVER_IP=""
  while true; do
    printf '旧服务器 IP（输入 0 返回）：'
    read -r value || return 1
    [[ "$value" == 0 ]] && return 2
    if [[ -n "$value" ]] && validate_ip "$value"; then
      OLD_SERVER_IP="$value"
      return 0
    fi
    printf 'IP 格式无效，请重新输入。\n'
  done
}

source_args() {
  local old_ip="$1"
  SOURCE_ARGS=(--source-ip "$old_ip")
  if [[ -n "$SOURCE_IDENTITY_FILE" ]]; then
    SOURCE_ARGS+=(--identity-file "$SOURCE_IDENTITY_FILE")
    [[ "$SOURCE_IDENTITY_MANAGED" -eq 1 ]] && SOURCE_ARGS+=(--managed-identity-file)
  fi
}

show_plan() {
  local payload="$1"
  PLAN_JSON="$payload" C_GREEN="$C_GREEN" C_YELLOW="$C_YELLOW" C_GRAY="$C_GRAY" C_RESET="$C_RESET" python3 - <<'PY'
import json,os
p=json.loads(os.environ["PLAN_JSON"])
green=os.environ.get("C_GREEN",""); yellow=os.environ.get("C_YELLOW",""); gray=os.environ.get("C_GRAY",""); reset=os.environ.get("C_RESET","")
def paint(t,c): return f"{c}{t}{reset}" if c else t
print("当前："+paint("这台新服务器（接收数据）",green))
print(f"旧服务器：{p.get('old_server_ip','')}")
print(f"将迁入网站：{p.get('site_count',0)} 个")
for i,s in enumerate(p.get("sites",[]),1):
    runtime=s.get("runtime") or {}
    rtype=runtime.get("type","")
    version=runtime.get("version","")
    dbs=s.get("mysql_databases") or []
    print(f"  {i}. {s.get('domain')} · {rtype} {version} · MySQL {len(dbs)}")
cap=p.get("capacity_estimate") or {}
required=int(cap.get("target_required_bytes") or 0)
if required:
    print(f"预计新服务器所需空间：约 {required/1024/1024/1024:.2f} GiB")
listeners=p.get("old_server_external_listeners") or []
if listeners:
    ports=", ".join(f"{x.get('protocol','?').upper()}/{x.get('port','?')}" for x in listeners)
    print("旧服务器额外公网服务："+paint(ports,yellow))
    print(paint("这些服务不属于 CloudPanel 网站迁入范围；旧服务器必须继续保留。",gray))
if p.get("source_temporary_helper_written"):
    print(paint("旧服务器：已短暂放置 P07 探测辅助程序；清理已尝试，不改业务文件。",yellow))
print(paint("安全边界：DNS 不自动修改 · 旧服务器不删除 · 新服务器已有资源不覆盖",gray))
PY
}

prepare_and_continue() {
  local old_ip="$1" domain="${2:-}" payload mid answer
  local -a args
  source_args "$old_ip"; args=("${SOURCE_ARGS[@]}")
  [[ -n "$domain" ]] && args+=(--site "$domain")

  say
  ui_attention '完整盘点需要在旧服务器临时放置一份 P07 辅助程序，完成后会尝试清理。'
  ui_note '不会修改旧服务器网站、数据库或 DNS；辅助目录只使用本次独立生成的名称，不覆盖已有目录。'
  ui_prompt '允许此次在旧服务器临时放置并清理辅助程序？[y/N]：'
  read -r answer || return 0
  [[ "$answer" =~ ^[Yy]$ ]] || { ui_note '已取消，旧服务器没有执行临时辅助程序写入。'; return 0; }
  ui_flow '正在从旧服务器读取迁移清单...'
  if ! run_quiet_with_progress '正在读取旧服务器迁移清单' "$CORE" server-migrate plan "${args[@]}" --confirm-source-helper-staging ALLOW_SOURCE_HELPER_STAGING; then
    payload="$WAIT_PAYLOAD"
    ui_bad '迁移预检未通过；没有迁移业务数据，也没有改 DNS。'
    printf '%s\n' "$payload" >&2
    pause
    return 0
  fi
  payload="$WAIT_PAYLOAD"
  show_plan "$payload"

  printf '\n开始首轮迁入？[y/N]：'
  read -r answer || return 0
  [[ "$answer" =~ ^[Yy]$ ]] || return 0

  ui_flow '新服务器开始从旧服务器复制数据...'
  ui_note '下面会实时显示已传输量 / 百分比 / 速度；不同网站会分段显示。'
  if ! run_migration_live server-migrate prepare "${args[@]}" --confirm PREPARE_PULL_MIGRATION; then
    payload="$MIGRATION_PAYLOAD"
    ui_bad '首轮迁入未完整结束；目标端状态已保留，禁止直接重新首轮迁入。'
    ui_note '若失败涉及 SQL 安全校验或已写入的目标数据库，不可直接从断点重试；先保留状态并完成安全恢复评估。'
    [[ -n "$payload" ]] && printf '%s\n' "$payload" >&2
    pause
    return 0
  fi
  payload="$MIGRATION_PAYLOAD"
  mid="$(json_field "$payload" migration_id 2>/dev/null || true)"
  [[ -n "$mid" ]] || {
    ui_bad '迁移已执行，但没有读到迁移任务编号。请从“继续未完成迁移”进入。'
    pause
    return 0
  }
  ui_good '首轮迁入完成 ✓'
  say "迁移任务编号：${C_MAGENTA}$mid${C_RESET}"
  continue_migration "$mid"
}

offer_verified_adopted_first_copy() {
  local mid="$1" domain="$2" answer output status
  ui_note '已有数据库必须通过独立所有权、配置、源端身份及未创建站点检查；仅继续原任务的首轮复制。'
  ui_note '旧 VPS 不停写；本操作绝不允许直接切换 DNS 或覆盖已导入的数据库。'
  ui_prompt '确认在此18站任务内安全续迁未创建的站点？[y/N]：'
  read -r answer || return 0
  [[ "$answer" =~ ^[Yy]$ ]] || return 0
  if ! run_migration_live server-migrate resume-verified-adoption --migration-id "$mid" --domain "$domain" --confirm "RESUME_VERIFIED_ADOPTION:$mid:$domain"; then
    ui_attention '严格恢复门禁拒绝继续，原任务和已有数据库均保留。'
    return 0
  fi
  output="$MIGRATION_PAYLOAD"
  status="$(json_field "$output" status 2>/dev/null || printf UNKNOWN)"
  if [[ "$status" == PREPARED ]]; then
    ui_good '18站首轮复制已完成；仍非最终一致性或正式切换。'
  else
    ui_attention '首轮续迁尚未完成；保留现有状态，不自动重试。'
  fi
  return 0
}

continue_migration() {
  local mid="$1" payload status answer output guard_flow guard_reason provenance blocked_site adopted_site evidence_state diagnostic verification reasons advisory
  while true; do
    if ! run_quiet_with_progress '正在读取迁移状态' "$CORE" server-migrate status --migration-id "$mid"; then
      ui_bad "无法读取迁移状态：$mid"
      pause
      return 0
    fi
    payload="$WAIT_PAYLOAD"
    status="$(json_field "$payload" status 2>/dev/null || printf UNKNOWN)"
    say
    ui_flow "迁移任务：$mid"
    printf '状态：'; migration_status_color "$status"; printf '\n'
    # The source SQL dump is deliberately transient. Display only the
    # fail-closed verifier's fixed-count evidence saved in private state.
    guard_flow="$(json_field "$payload" last_sql_guard_failure.flow 2>/dev/null || true)"
    guard_reason="$(json_field "$payload" last_sql_guard_failure.reason 2>/dev/null || true)"
    provenance="$(json_field "$payload" prepare_failure_provenance 2>/dev/null || true)"
    if [[ "$guard_flow" == SQL_GUARD_FLOW_V1\ * || "$guard_flow" == SQL_GUARD_FLOW_V1_UNAVAILABLE ]]; then
      ui_attention '上次 MySQL 校验被安全阻断；以下是脱敏诊断，不含 SQL 正文。'
      ui_note "$guard_flow"
    fi

    # A rejected SQL comparison may occur AFTER initial target import and app
    # config remap. Neither an automatic retry nor a new migration is safe.
    # Keep the immutable evidence in place and return to the menu.
    if [[ "$status" == 'PREPARE_FAILED' &&
          ( "$guard_reason" == 'CONDITIONAL_DDL' ||
            "$provenance" == 'MISSING_PARTIAL_STATE_RECOVERY_REQUIRED' ) ]]; then
      ui_bad '数据库验证被安全拦截；不能直接续跑或重新导入。'
      ui_note '现有站点文件、目标数据库和迁移记录必须保留。旧服务器继续运行，DNS 不修改。'
      evidence_state="$(json_field "$payload" first_failed_sql_evidence.status 2>/dev/null || true)"
      if [[ "$evidence_state" == 'RETAINED_NOT_RECOVERED' ]]; then
        ui_good '已有目标私有 SQL 快照与哈希留证，尚未获准恢复。'
      elif [[ "$evidence_state" == 'EVIDENCE_RETENTION_UNVERIFIED' ]]; then
        ui_attention 'SQL 留证未得到完整验证；保留所有迁移目录。'
      else
        ui_note '此前正式版可能已清理临时 SQL；不能把缺少留证视为数据库丢失。'
      fi
      blocked_site="$(json_field "$payload" first_failed_sql_site 2>/dev/null || true)"
      adopted_site="$(json_field "$payload" first_stage_adopted_sql_site 2>/dev/null || true)"
      if [[ -n "$blocked_site" ]]; then
        ui_note "受阻数据库所在网站：$blocked_site"
        ui_note '可对现有 CP2 数据库及旧 VPS 当前快照做一次只读诊断；旧 VPS 会临时导出并尝试清理私有 SQL，不会重新导入数据库。'
        ui_prompt '只执行此站的安全诊断？[y/N]：'
        read -r answer || return 0
        if [[ "$answer" =~ ^[Yy]$ ]]; then
          local capture_original_18=0
          local -a diagnostic_args=(server-migrate diagnose-sql --migration-id "$mid" --domain "$blocked_site")
          if [[ "$mid" == 'pull-20261106T065804Z-1aef6d0e' && "$blocked_site" == 'ilovem3u8.kewaro.com' ]]; then
            diagnostic_args+=(--capture-private-repro)
            capture_original_18=1
          fi
          if run_quiet_with_progress '受阻 SQL 私有取证（不重复迁入）' "$CORE" "${diagnostic_args[@]}"; then
            diagnostic="$WAIT_PAYLOAD"
            verification="$(json_field "$diagnostic" evidence.verification 2>/dev/null || printf UNKNOWN)"
            reasons="$(json_field "$diagnostic" evidence.dynamic_guard.unsafe_branch_reasons 2>/dev/null || printf UNAVAILABLE)"
            ui_note "校验资料状态：$verification（仅供诊断，非迁移放行）"
            ui_note "动态 SQL 拒绝原因分类：$reasons"
            ui_note '以下仅展示固定结构分类与数量，不包含原始 SQL；任何分类均不代表安全放行。'
            local branch_shapes
            branch_shapes="$(json_field "$diagnostic" evidence.dynamic_guard.unsafe_branch_features 2>/dev/null || printf UNAVAILABLE)"
            ui_note "被拒 SQL 的结构特征：$branch_shapes"
            ui_note '本诊断不更改任务状态，不重导数据库，不授予继续或切换权限。'
            local repro_state repro_env repro_branch_json
            if [[ "$capture_original_18" == 1 ]]; then
              repro_state="$(json_field "$diagnostic" private_repro.status 2>/dev/null || printf UNAVAILABLE)"
              if [[ "$repro_state" != PRIVATE_MINIMAL_REPRO_CAPTURED_NOT_VERIFIED ]]; then
                ui_attention '本次私有最小复现未完整建立；保留原任务和 SQL 安全阻断。'
                pause
                return 0
              fi
              ui_good '原3组完整 SQL 控制语法已一次性保存在 CP2 私有目录（绝不上传或执行）。'
              ui_note '下面仅显示去标识化语法骨架；不包含业务标识、SQL 原文、行值或凭据。'
              ui_note "私有最小复现回放：$(json_field "$diagnostic" private_repro.reproduced_guard_flow 2>/dev/null || printf UNAVAILABLE)"
              repro_env="$(json_field "$diagnostic" private_repro.environment 2>/dev/null || printf '{}')"
              ui_note "导出/数据库版本：$repro_env"
              repro_branch_json="$(json_field "$diagnostic" private_repro.branches 2>/dev/null || printf '[]')"
              REPRO_BRANCH_JSON="$repro_branch_json" python3 - <<'PY'
import json,os
try:
    rows=json.loads(os.environ["REPRO_BRANCH_JSON"])
except (ValueError,TypeError):
    rows=[]
if not isinstance(rows,list) or len(rows)!=3:
    print("复现结构：不可用；保留私有证据，不允许续迁")
else:
    for i,item in enumerate(rows,1):
        for side in ("yes","no"):
            b=item.get(side,{}) if isinstance(item,dict) else {}
            tokens=b.get("tokens",[])
            if not isinstance(tokens,list) or len(tokens)>100:
                tokens=[]
            verdict=b.get("guard_verdict","UNPROVEN")
            print("组%d %s [%s]: %s" % (i,side.upper(),verdict," ".join(
                str(t) for t in tokens if isinstance(t,str)
            )))
PY
              ui_attention '真实 SQL 仍未得到安全证明；不得继续迁移、登记 DB 检查点或切换 DNS。'
              pause
              return 0
            fi
            advisory="$(json_field "$diagnostic" evidence.guarded_export_comparison.status 2>/dev/null || printf UNAVAILABLE)"
            if [[ "$advisory" == 'MATCH_ADVISORY_NOT_MIGRATION_PASS' ]]; then
              ui_note '诊断仅为参考；下面的独立双次源端回读、原DB归属与配置验证仍可能拒绝恢复。'
              ui_prompt '仅核验并登记已导入数据库的安全检查点？[y/N]：'
              read -r answer || return 0
              if [[ "$answer" =~ ^[Yy]$ ]]; then
                if run_quiet_with_progress '原数据库严格重验（不重导）' "$CORE" server-migrate adopt-existing-guarded-db --migration-id "$mid" --domain "$blocked_site" --confirm "ADOPT_EXISTING_DB:$mid:$blocked_site"; then
                  verification="$(json_field "$WAIT_PAYLOAD" status 2>/dev/null || printf UNKNOWN)"
                  if [[ "$verification" == 'FIRST_STAGE_ADOPTED_REQUIRES_CHAIN_RECOVERY' || "$verification" == 'ALREADY_ADOPTED_FIRST_STAGE' ]]; then
                    ui_good '已建立原数据库受保护的首轮检查点；原始阻断历史保留。'
                    offer_verified_adopted_first_copy "$mid" "$blocked_site"
                  else
                    ui_attention '回执状态未经验证，不能进入续迁。'
                  fi
                else
                  ui_attention '独立数据重验尚未通过；不能安全续迁，且未重新导入原数据库。'
                fi
              fi
            else
              ui_attention 'SQL 安全等价未证明；不尝试重验写入状态或恢复导入。'
            fi
          else
            ui_attention '只读 SQL 诊断未完成；没有解锁迁移或修改数据库。'
          fi
        fi
      elif [[ -n "$adopted_site" ]]; then
        ui_good '已存在经过原数据库严格重验的首轮检查点；恢复前还将重新核对全部身份与目标缺失项。'
        offer_verified_adopted_first_copy "$mid" "$adopted_site"
      else
        ui_attention '无法安全确定唯一受阻数据库，不进行任何自动数据库操作。'
      fi
      pause
      return 0
    fi

    case "$status" in
      PREPARING|PREPARE_FAILED)
        ui_note '仅无 SQL 保护阻断、无已暂存站点冲突的任务，才允许受保护的恢复尝试。'
        printf '继续首轮迁入？[Y/n]：'
        read -r answer || return 0
        [[ ! "$answer" =~ ^[Nn]$ ]] || return 0
        ui_note '继续时会实时显示文件同步进度。'
        if ! run_migration_live server-migrate resume --migration-id "$mid"; then
          output="$MIGRATION_PAYLOAD"
          ui_bad '继续迁入仍未完成；状态已保留。'
          [[ -n "$output" ]] && printf '%s\n' "$output" >&2
          pause
          return 0
        fi
        output="$MIGRATION_PAYLOAD"
        ui_good '首轮迁入完成 ✓'
        ;;
      PREPARED)
        local scope_count
        scope_count="$(json_field "$payload" site_count 2>/dev/null || printf UNKNOWN)"
        if [[ "$scope_count" == 17 || "$scope_count" == 18 ]]; then
          ui_attention '当前整机首轮迁入已完成，最终同步与回滚尚须独立现场门禁。'
          ui_note '此菜单不会直接停旧服务器或重放三个数据库；请保留迁移任务，等待通过最终切换门禁。'
          pause
          return 0
        fi
        ui_attention '下一步进入短维护窗口：旧服务器会暂时停止 网站服务 / 定时任务 / Node.js 进程，然后新服务器做最终增量复制。'
        ui_note '此阶段仍不会修改 DNS；失败会尝试恢复旧服务器运行。'
        ui_safety_tier migration '会短暂停止旧服务器运行环境并执行最终增量。'
        ui_prompt '确认进入最终同步？[y/N]：'; read -r answer || return 0
        [[ "$answer" =~ ^[Yy]$ ]] || return 0
        ui_note '最终增量同步会实时显示 rsync 进度。'
        if ! run_migration_live server-migrate cutover --migration-id "$mid" --confirm "CUTOVER_PULL:$mid"; then
          output="$MIGRATION_PAYLOAD"
          ui_bad '最终同步未完成；已执行安全恢复流程，请以上方状态为准。'
          [[ -n "$output" ]] && printf '%s\n' "$output" >&2
          pause
          return 0
        fi
        output="$MIGRATION_PAYLOAD"
        ui_good '最终增量同步与新服务器本地验证完成 ✓'
        ;;
      CUTOVER_RUNNING)
        ui_attention '上次最终同步被中断。再次执行会从安全状态继续。'
        printf '继续最终同步？[Y/n]：'
        read -r answer || return 0
        [[ ! "$answer" =~ ^[Nn]$ ]] || return 0
        if ! run_migration_live server-migrate cutover --migration-id "$mid" --confirm "CUTOVER_PULL:$mid"; then
          output="$MIGRATION_PAYLOAD"
          ui_bad '最终同步仍未完成。'
          [[ -n "$output" ]] && printf '%s\n' "$output" >&2
          pause
          return 0
        fi
        output="$MIGRATION_PAYLOAD"
        ;;
      CUTOVER_PREP_READY)
        ui_good '新服务器本地验证通过 ✓'
        ui_attention '唯一剩余人工步骤：把网站 DNS 切换到当前这台新服务器。'
        ui_note '不会自动修改 DNS，也不会删除旧服务器。'
        printf '\n完成 DNS 切换后，输入 y 开始公网验证；暂未切换可直接返回。[y/N]：'
        read -r answer || return 0
        [[ "$answer" =~ ^[Yy]$ ]] || return 0
        if ! run_quiet_with_progress '正在进行公网验证' "$CORE" server-migrate finalize --migration-id "$mid" --confirm "DNS_UPDATED:$mid"; then
          output="$WAIT_PAYLOAD"
          ui_bad '公网验证暂未通过。请检查 DNS / HTTPS，之后可从“继续未完成迁移”重试。'
          printf '%s\n' "$output" >&2
          pause
          return 0
        fi
        output="$WAIT_PAYLOAD"
        ;;
      WAITING_DNS|PRODUCTION_VERIFY_FAILED)
        ui_attention '已进入 DNS / 公网验证阶段；不要执行运行环境回退。'
        ui_note '确认 DNS 已指向当前新服务器后，可以安全重试公网验证。'
        printf '\n重试公网验证？[Y/n]：'
        read -r answer || return 0
        [[ ! "$answer" =~ ^[Nn]$ ]] || return 0
        if ! run_quiet_with_progress '正在重试公网验证' "$CORE" server-migrate finalize --migration-id "$mid" --confirm "DNS_UPDATED:$mid"; then
          output="$WAIT_PAYLOAD"
          ui_bad '公网验证仍未通过。'
          printf '%s\n' "$output" >&2
          pause
          return 0
        fi
        output="$WAIT_PAYLOAD"
        ;;
      PRODUCTION_PASS)
        ui_good '服务器迁入正式验证通过 ✓'
        ui_note '当前：这台新服务器（接收数据）'
        ui_note '旧服务器：继续保留为恢复副本，不自动删除'
        ui_note '迁移完成后旧服务器网站保持停止；登录旧服务器后可从“旧服务器网站开关”一键开启。'
        ui_note 'DNS：未自动修改 · 旧服务器：未删除'
        local listeners
        listeners="$(json_field "$payload" old_server_external_listeners 2>/dev/null || printf '[]')"
        if [[ "$listeners" != "[]" ]]; then
          LISTENERS_JSON="$listeners" python3 - <<'PY'
import json,os
try: rows=json.loads(os.environ["LISTENERS_JSON"])
except Exception: rows=[]
if rows:
    ports=", ".join(f"{x.get('protocol','?').upper()}/{x.get('port','?')}" for x in rows)
    print(f"注意：旧服务器还有非网站面板管理的公网服务：{ports}")
    print("这些服务未被网站迁入链自动处理，因此旧服务器更不能删除。")
PY
        fi
        pause
        return 0
        ;;
      CUTOVER_FAILED_ROLLED_BACK)
        ui_attention '上次最终同步验证失败，但旧服务器已经安全恢复运行。'
        ui_note '可以继续使用同一个迁移任务重试；不会重新创建任务，也不会修改 DNS。'
        ui_safety_tier migration '重试会再次进入短维护窗口并执行最终增量。'
        ui_prompt '继续这个迁移任务重试最终同步？[y/N]：'; read -r answer || return 0
        [[ "$answer" =~ ^[Yy]$ ]] || return 0
        ui_note '最终增量同步会实时显示 rsync 进度。'
        if ! run_migration_live server-migrate cutover --migration-id "$mid" --confirm "CUTOVER_PULL:$mid"; then
          output="$MIGRATION_PAYLOAD"
          ui_bad '最终同步仍未完成；已执行安全恢复流程，请以上方状态为准。'
          [[ -n "$output" ]] && printf '%s
' "$output" >&2
          pause
          return 0
        fi
        output="$MIGRATION_PAYLOAD"
        ui_good '最终增量同步与新服务器本地验证完成 ✓'
        ;;
      ROLLED_BACK)
        ui_attention '迁移已按人工回退结束；新服务器资源不会自动删除。'
        pause
        return 0
        ;;
      CUTOVER_FAILED_ROLLBACK_PARTIAL|ROLLBACK_PARTIAL)
        ui_bad '恢复只完成了一部分，需要工程检查；请勿修改 DNS 或删除旧服务器。'
        pause
        return 0
        ;;
      *)
        ui_bad "当前状态需要工程检查：$status"
        pause
        return 0
        ;;
    esac
  done
}

whole_server_in() {
  local old_ip preview status count databases target answer result state reason
  local -a fresh_args=()
  ui_page '全新CP2 · 17站整机迁移' '当前：新服务器（接收数据）'
  ui_flow '一次完成环境检查 → 旧VPS连接 → 17站/三库预检 → 首轮复制'
  ui_note '旧服务器继续运营；首轮仅准备目标数据，不停站、不修改 DNS。'
  ui_note '最终停写、最终一致性、回滚验收及 DNS 切换是后续独立阶段。'
  say
  read_old_ip || return 0
  old_ip="$OLD_SERVER_IP"
  ensure_source_access "$old_ip" || { pause; return 0; }

  fresh_args=(--source-ip "$old_ip")
  [[ -n "$SOURCE_IDENTITY_FILE" ]] && fresh_args+=(--identity-file "$SOURCE_IDENTITY_FILE")

  say
  ui_attention '预检会在旧 VPS 的 P07 私有目录暂存采集助手和 SQL 快照并尝试清理；不会执行数据库导入。'
  ui_prompt '同意临时采集并检查三个数据库？[y/N]：'
  read -r answer || return 0
  [[ "$answer" =~ ^[Yy]$ ]] || { ui_note '已取消，没有执行迁移。'; return 0; }

  ui_flow '正在确认新 CP2 为空、旧VPS恰有17站及3个数据库安全性...'
  if ! run_quiet_with_progress '17站与三库迁移预检' "$CORE" fresh-17site preview "${fresh_args[@]}" --confirm ALLOW_TEMP_SOURCE_PREFLIGHT; then
    reason="$(json_field "$WAIT_PAYLOAD" reason 2>/dev/null || printf 'SOURCE_OR_CP2_NOT_READY')"
    ui_bad "预检未通过：$reason"
    ui_note '没有创建目标网站或导入数据库。请保留旧VPS，不要重复尝试被阻断操作。'
    pause
    return 0
  fi
  preview="$WAIT_PAYLOAD"
  status="$(json_field "$preview" status 2>/dev/null || printf UNKNOWN)"
  count="$(json_field "$preview" source_site_count 2>/dev/null || printf 0)"
  databases="$(json_field "$preview" source_db_count 2>/dev/null || printf 0)"
  target="$(json_field "$preview" target_empty_verified 2>/dev/null || printf False)"
  if [[ "$status" != 'PREFLIGHT_PASS_NOT_CUTOVER_READY' || "$count" != 17 ||
        "$databases" != 3 || "$target" != True ]]; then
    ui_bad '预检输出未达到17站/三库/空目标要求，未执行复制。'
    pause
    return 0
  fi
  ui_good '17站与三个数据库安全预检通过 ✓'
  ui_good '已确认当前目标为全新 CP2 ✓'
  ui_note '接下来只执行首轮迁入，旧VPS不停写。真正最终一致性要等停写窗口。'
  ui_prompt '现在开始首轮复制到这台新 CP2？[y/N]：'
  read -r answer || return 0
  [[ "$answer" =~ ^[Yy]$ ]] || { ui_note '首轮复制已取消。'; return 0; }

  ui_flow '开始17站首轮迁入；原有目标及旧 VPS 不会被自动覆盖或删除。'
  if ! run_migration_live fresh-17site prepare "${fresh_args[@]}" --confirm PREPARE_FRESH_CP2_17_SITES; then
    reason="$(json_field "$MIGRATION_PAYLOAD" reason 2>/dev/null || printf 'FRESH_PREPARE_NOT_COMPLETED')"
    ui_bad "首轮迁入被阻止或未完成：$reason"
    ui_note '不自动重试、不重新创建迁移任务、不冻结旧VPS、不修改 DNS。'
    pause
    return 0
  fi
  result="$MIGRATION_PAYLOAD"
  state="$(json_field "$result" status 2>/dev/null || printf UNKNOWN)"
  if [[ "$state" != 'FRESH_FIRST_COPY_COMPLETED_NOT_CUTOVER_READY' ]]; then
    ui_bad '迁入未取得成功确认。请保留现有迁移记录。'
  else
    ui_good '17站首轮迁入已完成 ✓'
    ui_note '此结果不代表最终一致性或正式切换批准；禁止直接修改 DNS。'
    ui_note '后续仍需独立的最终同步、回滚证明和现场验收。'
  fi
  pause
}

single_site_in() {
  local old_ip domain rc
  ui_page '迁入一个网站' '当前：这台新服务器（接收数据）'
  ui_flow '单站迁入'
  ui_note '当前固定为这台新服务器（接收数据）。'
  if ! read_old_ip; then
    rc=$?
    [[ "$rc" -eq 2 ]] && return 0
    return 0
  fi
  old_ip="$OLD_SERVER_IP"
  printf '要迁入的网站域名（输入 0 返回）：'
  read -r domain || return 0
  [[ "$domain" == 0 || -z "$domain" ]] && return 0
  ensure_source_access "$old_ip" || { pause; return 0; }
  prepare_and_continue "$old_ip" "$domain"
}


old_server_nginx_control() {
  local payload site_state choice output answer

  ui_page '旧服务器网站开关' '迁移后在旧服务器上使用'
  ui_note '迁移后如果你登录的是旧服务器，就直接在这里操作，不需要输入 IP。'
  ui_note '不会影响 CloudPanel 后台，也不会修改 DNS。'
  say

  while true; do
    if ! payload="$("$CORE" server-migrate local-nginx-status 2>&1)"; then
      ui_bad '无法读取当前服务器网站状态。'
      pause
      return 0
    fi

    site_state="$(json_field "$payload" site_nginx_state 2>/dev/null || printf unknown)"

    ui_page '旧服务器网站开关' '当前这台服务器'
    case "$site_state" in
      active) ui_good '当前状态：这台服务器全部网站已开启 ✓' ;;
      inactive|failed|deactivating|dead) ui_attention '当前状态：这台服务器全部网站已停止' ;;
      *) ui_attention '当前状态：暂时无法确认' ;;
    esac
    ui_note '一次操作整台服务器的网站，不需要一个网站一个网站处理。'
    say
    ui_menu_good 1 '开启这台服务器全部网站'
    ui_menu_warn 2 '停止这台服务器全部网站'
    ui_menu_back 0 '返回'
    ui_prompt '请选择 [0-2]：'
    read -r choice || return 0

    case "$choice" in
      1)
        if [[ "$site_state" == "active" ]]; then
          ui_good '这台服务器全部网站已经开启，无需重复操作。'
          pause
          continue
        fi
        ui_attention '将开启这台服务器全部网站。'
        ui_note '系统会先自动检查，检查不通过就不会开启。'
        ui_prompt '确认开启？[y/N]：'
        read -r answer || continue
        [[ "$answer" =~ ^[Yy]$ ]] || continue
        if output="$("$CORE" server-migrate local-nginx-start --confirm START_LOCAL_NGINX 2>&1)"; then
          ui_good '这台服务器全部网站已开启 ✓'
        else
          ui_bad '这台服务器网站没有成功开启。'
        fi
        pause
        ;;
      2)
        if [[ "$site_state" != "active" ]]; then
          ui_good '这台服务器全部网站当前已经停止，无需重复操作。'
          pause
          continue
        fi
        ui_attention '将停止这台服务器全部网站。'
        ui_note 'CloudPanel 后台仍可继续使用。'
        ui_prompt '确认停止？[y/N]：'
        read -r answer || continue
        [[ "$answer" =~ ^[Yy]$ ]] || continue
        if output="$("$CORE" server-migrate local-nginx-stop --confirm STOP_LOCAL_NGINX 2>&1)"; then
          ui_good '这台服务器全部网站已停止 ✓'
        else
          ui_bad '这台服务器网站没有成功停止。'
        fi
        pause
        ;;
      0) return 0 ;;
      *) ui_warn '无效选择。请输入 0-2。' ;;
    esac
  done
}

select_existing_migration() {
  local root="/var/lib/vf-server-ops/server-migrations" choice count row i mid status ip
  local -a rows
  [[ -d "$root" ]] || { ui_empty_state '继续未完成迁移' '没有发现未完成的迁移任务。' '0. 返回服务器迁移'; pause; return 0; }
  mapfile -t rows < <(python3 - "$root" <<'PY'
import json,sys
from pathlib import Path
rows=[]
for p in Path(sys.argv[1]).glob("*/state.json"):
    try: d=json.loads(p.read_text(encoding="utf-8"))
    except Exception: continue
    if d.get("schema")!="vf-server-ops.server-migration.target-pull.v1":
        continue
    rows.append((d.get("updated_at",""),d.get("migration_id",p.parent.name),d.get("status","UNKNOWN"),(d.get("source") or {}).get("ip","")))
for _,mid,status,ip in sorted(rows,reverse=True):
    print(f"{mid}\t{status}\t{ip}")
PY
)
  count="${#rows[@]}"
  [[ "$count" -gt 0 ]] || { ui_empty_state '继续未完成迁移' '没有发现未完成的迁移任务。' '0. 返回服务器迁移'; pause; return 0; }
  ui_title '迁移任务'; ui_rule
  i=1
  for row in "${rows[@]}"; do
    IFS=$'\t' read -r mid status ip <<<"$row"
    printf '  %s. %s · ' "$i" "$mid"; migration_status_color "$status"; printf ' · 旧服务器 %s\n' "$ip"
    i=$((i+1))
  done
  ui_menu_back 0 '返回'
  ui_prompt "请选择 [0-${count}]："
  read -r choice || return 0
  [[ "$choice" =~ ^[0-9]+$ ]] || return 0
  [[ "$choice" == 0 ]] && return 0
  (( choice>=1 && choice<=count )) || return 0
  IFS=$'\t' read -r mid _ _ <<<"${rows[$((choice-1))]}"
  continue_migration "$mid"
}

old_server_switch_needed() {
  local root="${VFOPS_SOURCE_RECOVERY_ROOT:-/var/lib/vf-server-ops/source-recovery}"
  [[ -d "$root" ]] || return 1
  python3 - "$root" <<'PY' >/dev/null 2>&1
import json,sys
from pathlib import Path
root=Path(sys.argv[1])
for path in root.glob("*/state.json"):
    try:
        state=json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        continue
    status=str(state.get("status",""))
    if status in {"SOURCE_FREEZE_RUNNING","SOURCE_FROZEN"} or state.get("source_nginx_frozen") is True:
        raise SystemExit(0)
raise SystemExit(1)
PY
}

migration_menu() {
  local choice show_old_switch=0 prompt_range='0-3'
  while true; do
    old_server_switch_needed && show_old_switch=1 || show_old_switch=0
    [[ "$show_old_switch" -eq 1 ]] && prompt_range='0-4' || prompt_range='0-3'
    ui_page '服务器迁移' '新服务器主动从旧服务器复制数据'
    ui_rule
    say "当前：${C_GREEN}这台新服务器（接收数据）${C_RESET}"
    ui_note '普通迁移只在新服务器操作；旧服务器只有真的被迁移流程冻结过，才显示恢复开关。'
    say
    ui_menu_flow 1 '全新CP2迁入17站'
    ui_note '     向导完成SSH连接、空目标检查、三库预检和首轮复制'
    say
    ui_menu_flow 2 '迁入一个网站'
    ui_note '     只迁入指定网站'
    say
    ui_menu_flow 3 '继续上次迁移'
    ui_note '     继续传输 / 验证域名是否已切换 / 查看结果'
    if [[ "$show_old_switch" -eq 1 ]]; then
      say
      ui_menu_info 4 '旧服务器网站开关'
      ui_note '     仅在旧服务器存在迁移冻结状态时显示，用于恢复或人工检查网站运行状态'
    fi
    say
    ui_menu_back 0 '返回'
    say
    ui_note '安全边界：DNS 只人工切换 · 旧服务器永不自动删除 · 新服务器已有资源不覆盖'
    ui_prompt "请选择 [${prompt_range}]："
    read -r choice || return 0
    case "$choice" in
      1)
        ensure_current_server_ready || { pause; continue; }
        ensure_migration_dependencies || { pause; continue; }
        whole_server_in
        ;;
      2)
        ensure_migration_dependencies || { pause; continue; }
        ensure_current_server_ready || { pause; continue; }
        single_site_in
        ;;
      3)
        ensure_migration_dependencies || { pause; continue; }
        ensure_current_server_ready || { pause; continue; }
        select_existing_migration
        ;;
      4) [[ "$show_old_switch" -eq 1 ]] && old_server_nginx_control || ui_warn '当前没有需要恢复的旧服务器冻结状态。' ;;
      0) return 0 ;;
      *) ui_warn "无效选择。请输入 ${prompt_range}。" ;;
    esac
  done
}

migration_menu
