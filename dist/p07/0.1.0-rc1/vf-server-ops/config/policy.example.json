{
  "schema": "vf-server-ops.policy.v1",
  "source_root": "/",
  "local_backup_dir": "/var/backups/vf-server-ops",
  "sites": [
    "example.com"
  ],
  "storage_config": "/etc/vf-server-ops/storage.json",
  "backup": {
    "upload_remote": true,
    "remote_target": "auto"
  },
  "retention": {
    "automatic_keep_last": 7,
    "automatic_max_age_days": 30,
    "manual_protected": true,
    "auto_delete_automatic": false
  },
  "automation": {
    "enabled": false,
    "daily_at": "03:30"
  }
}
