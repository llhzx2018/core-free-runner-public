#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT_DIR="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
CORE="$ROOT_DIR/bin/vfops"
VERSION="$(cat "$ROOT_DIR/VERSION" 2>/dev/null || printf 'UNKNOWN')"
CHANNEL="RC2"
INV_FILE=""
SELECTED_DOMAIN=""
SELECTED_BACKUP=""

cleanup() {
  [[ -n "$INV_FILE" ]] && rm -f "$INV_FILE" 2>/dev/null || true
}
trap cleanup EXIT

pause() {
  printf '\n按 Enter 返回...'
  read -r _ || true
}

header() {
  clear 2>/dev/null || true
  cat <<EOF
========================================
 P07 · VF Server Ops  ${VERSION} ${CHANNEL}
========================================

  1. 查看这台服务器
  2. 备份网站
  3. 迁移网站到新服务器
  4. 恢复备份

  0. 退出

EOF
}

load_inventory() {
  cleanup
  INV_FILE="$(mktemp -t p07-inventory.XXXXXX)"
  local err
  err="$(mktemp -t p07-inventory-error.XXXXXX)"
  if ! "$CORE" inventory --compact >"$INV_FILE" 2>"$err"; then
    printf '\n[P07] 无法读取这台服务器。\n' >&2
    sed -n '1,8p' "$err" >&2 || true
    rm -f "$err"
    return 1
  fi
  rm -f "$err"
  return 0
}

show_inventory() {
  python3 - "$INV_FILE" <<'PY'
import json, sys
p=json.load(open(sys.argv[1], encoding='utf-8'))
system=p.get('system',{})
osinfo=system.get('os',{}) if isinstance(system.get('os'),dict) else {}
sites=p.get('sites',[]) if isinstance(p.get('sites'),list) else []
summary=p.get('summary',{}) if isinstance(p.get('summary'),dict) else {}
print('\n服务器概览')
print('----------------------------------------')
print(f"系统：{osinfo.get('pretty_name','UNKNOWN')}")
print(f"CloudPanel：{system.get('cloudpanel_version','UNKNOWN')}")
print(f"网站数量：{len(sites)}")
print(f"MySQL 数据库：{summary.get('mysql_database_count_known','UNKNOWN')}")
print(f"SQLite 文件：{summary.get('sqlite_file_count_known','UNKNOWN')}")
print('\n网站')
print('----------------------------------------')
if not sites:
    print('没有发现 CloudPanel 网站。')
for i,s in enumerate(sites,1):
    runtime=s.get('runtime',{}) if isinstance(s.get('runtime'),dict) else {}
    mysql=s.get('mysql_databases')
    sqlite=s.get('sqlite_paths')
    ssl=s.get('ssl',{}) if isinstance(s.get('ssl'),dict) else {}
    dbn=len(mysql) if isinstance(mysql,list) else '?'
    sqn=len(sqlite) if isinstance(sqlite,list) else '?'
    ssl_text='已配置' if ssl.get('configured') is True else ('未配置' if ssl.get('configured') is False else '未知')
    print(f"{i}. {s.get('domain','UNKNOWN')}")
    print(f"   类型：{runtime.get('type','UNKNOWN')}  MySQL：{dbn}  SQLite：{sqn}  SSL：{ssl_text}")
PY
}

select_site() {
  SELECTED_DOMAIN=""
  load_inventory || return 1
  local count choice
  count="$(python3 - "$INV_FILE" <<'PY'
import json,sys
p=json.load(open(sys.argv[1],encoding='utf-8'))
print(len(p.get('sites',[]) if isinstance(p.get('sites'),list) else []))
PY
)"
  if [[ "$count" -eq 0 ]]; then
    printf '\n没有发现可操作的网站。\n' >&2
    return 1
  fi
  python3 - "$INV_FILE" <<'PY'
import json,sys
p=json.load(open(sys.argv[1],encoding='utf-8'))
for i,s in enumerate(p.get('sites',[]),1):
    print(f"  {i}. {s.get('domain','UNKNOWN')}")
PY
  printf '\n请选择网站 [1-%s]：' "$count"
  read -r choice || return 1
  [[ "$choice" =~ ^[0-9]+$ ]] || { printf '请输入上面的数字。\n' >&2; return 1; }
  (( choice >= 1 && choice <= count )) || { printf '选择超出范围。\n' >&2; return 1; }
  SELECTED_DOMAIN="$(python3 - "$INV_FILE" "$choice" <<'PY'
import json,sys
p=json.load(open(sys.argv[1],encoding='utf-8'))
print(p['sites'][int(sys.argv[2])-1]['domain'])
PY
)"
  [[ -n "$SELECTED_DOMAIN" ]]
}

backup_site() {
  printf '\n[P07] 正在读取 CloudPanel 网站...\n'
  select_site || { pause; return; }
  printf '\n将备份：%s\n' "$SELECTED_DOMAIN"
  printf '备份位置：/var/backups/vf-server-ops\n'
  printf '开始备份？[Y/n]：'
  local yn output rc
  read -r yn || return
  [[ -z "$yn" || "$yn" =~ ^[Yy]$ ]] || return
  printf '\n[P07] 正在创建并校验备份...\n'
  set +e
  output="$("$CORE" backup --site "$SELECTED_DOMAIN" 2>&1)"
  rc=$?
  set -e
  if [[ $rc -ne 0 ]]; then
    printf '\n备份失败。\n%s\n' "$output" >&2
    pause
    return
  fi
  local path
  path="$(printf '%s\n' "$output" | tail -n1)"
  printf '\n备份完成 ✓\n'
  printf '网站：%s\n' "$SELECTED_DOMAIN"
  printf '备份：%s\n' "$path"
  printf '完整性校验：PASS\n'
  pause
}

show_server() {
  printf '\n[P07] 正在读取这台服务器...\n'
  if load_inventory; then
    show_inventory
  fi
  pause
}

backup_identity() {
  python3 - "$1" <<'PY'
import json,sys
from pathlib import Path
p=Path(sys.argv[1])/'manifest.json'
d=json.loads(p.read_text(encoding='utf-8'))
print(f"{d.get('site',{}).get('domain','')}\t{d.get('backup_id','')}")
PY
}

list_backups() {
  python3 - <<'PY'
import json
from pathlib import Path
base=Path('/var/backups/vf-server-ops')
rows=[]
if base.is_dir():
    for m in base.glob('*/manifest.json'):
        try:
            d=json.loads(m.read_text(encoding='utf-8'))
            rows.append((m.parent, d.get('site',{}).get('domain','UNKNOWN'), d.get('backup_id','UNKNOWN'), d.get('created_at','UNKNOWN')))
        except Exception:
            pass
rows.sort(key=lambda x:x[3], reverse=True)
for i,(path,domain,bid,created) in enumerate(rows,1):
    print(f"{i}\t{path}\t{domain}\t{bid}\t{created}")
PY
}

select_backup() {
  SELECTED_BACKUP=""
  local raw count choice
  raw="$(list_backups)"
  if [[ -z "$raw" ]]; then
    printf '\n没有发现 P07 本地备份。\n' >&2
    return 1
  fi
  count="$(printf '%s\n' "$raw" | wc -l | tr -d ' ')"
  printf '\n可用备份\n----------------------------------------\n'
  printf '%s\n' "$raw" | awk -F '\t' '{printf "  %s. %s  (%s)\n",$1,$3,$5}'
  printf '\n请选择备份 [1-%s]：' "$count"
  read -r choice || return 1
  [[ "$choice" =~ ^[0-9]+$ ]] || return 1
  (( choice >= 1 && choice <= count )) || return 1
  SELECTED_BACKUP="$(printf '%s\n' "$raw" | awk -F '\t' -v n="$choice" '$1==n{print $2}')"
  [[ -n "$SELECTED_BACKUP" ]]
}

restore_backup() {
  select_backup || { pause; return; }
  printf '\n[P07] 先做恢复前检查（不会写入服务器）...\n'
  local plan rc identity domain backup_id confirm
  set +e
  plan="$("$CORE" restore plan --package "$SELECTED_BACKUP" 2>&1)"
  rc=$?
  set -e
  if [[ $rc -ne 0 ]]; then
    printf '\n恢复前检查未通过：\n%s\n' "$plan" >&2
    pause
    return
  fi
  printf '恢复前检查：PASS\n'
  identity="$(backup_identity "$SELECTED_BACKUP")"
  IFS=$'\t' read -r domain backup_id <<<"$identity"
  printf '将恢复网站：%s\n' "$domain"
  printf '仅允许恢复到全新的 CloudPanel 站点；不会覆盖已有站点，不会改 DNS。\n'
  printf '确认执行请输入 YES：'
  read -r confirm || return
  [[ "$confirm" == "YES" ]] || { printf '已取消。\n'; pause; return; }
  printf '\n[P07] 正在恢复...\n'
  set +e
  "$CORE" restore apply-new-site --package "$SELECTED_BACKUP" --confirm "RESTORE_NEW_SITE:${domain}:${backup_id}"
  rc=$?
  set -e
  if [[ $rc -eq 0 ]]; then
    printf '\n恢复完成 ✓\n'
    printf '说明：DNS 仍未修改。若该站点有 Cron/PM2，还需要继续做 Runtime 恢复。\n'
  else
    printf '\n恢复未完成，请以上方错误为准。\n' >&2
  fi
  pause
}

migrate_site() {
  printf '\n[P07] 正在读取源服务器网站...\n'
  select_site || { pause; return; }
  local target_ip confirm output rc package identity domain backup_id
  printf '\n迁移网站：%s\n' "$SELECTED_DOMAIN"
  printf '新服务器 IP：'
  read -r target_ip || return
  [[ -n "$target_ip" ]] || { printf '未输入 IP，已取消。\n'; pause; return; }
  printf '\nP07 将：创建迁移备份 → SSH 传输 → 新站恢复 → 技术验证。\n'
  printf '不会改 DNS，不会删除旧服务器。\n'
  printf '确认迁移到 %s 请输入 YES：' "$target_ip"
  read -r confirm || return
  [[ "$confirm" == "YES" ]] || { printf '已取消。\n'; pause; return; }

  printf '\n[1/2] 创建并验证迁移备份...\n'
  set +e
  output="$("$CORE" backup --site "$SELECTED_DOMAIN" --kind pre_migration 2>&1)"
  rc=$?
  set -e
  if [[ $rc -ne 0 ]]; then
    printf '\n迁移备份失败：\n%s\n' "$output" >&2
    pause
    return
  fi
  package="$(printf '%s\n' "$output" | tail -n1)"
  identity="$(backup_identity "$package")"
  IFS=$'\t' read -r domain backup_id <<<"$identity"

  printf '[2/2] 连接新服务器并迁移...\n'
  set +e
  "$CORE" migrate transfer-new-site \
    --package "$package" \
    --target-host "$target_ip" \
    --target-ip "$target_ip" \
    --ssh-user root \
    --ssh-port 22 \
    --confirm "MIGRATE_NEW_SITE:${domain}:${backup_id}"
  rc=$?
  set -e
  if [[ $rc -eq 0 ]]; then
    printf '\n迁移技术验证完成 ✓\n'
    printf 'DNS 仍未修改，旧服务器仍保留。\n'
  else
    printf '\n迁移未完成。源服务器和刚生成的迁移备份仍保留。\n' >&2
  fi
  pause
}

if (($# > 0)); then
  case "$1" in
    --version|-V)
      printf 'VF Server Ops %s %s\n' "$VERSION" "$CHANNEL"
      exit 0
      ;;
    --advanced)
      shift
      exec "$CORE" "$@"
      ;;
    *)
      exec "$CORE" "$@"
      ;;
  esac
fi

while true; do
  header
  printf '请选择 [0-4]：'
  read -r choice || exit 0
  case "$choice" in
    1) show_server ;;
    2) backup_site ;;
    3) migrate_site ;;
    4) restore_backup ;;
    0) exit 0 ;;
    *) printf '\n请输入 0-4。\n'; pause ;;
  esac
done
