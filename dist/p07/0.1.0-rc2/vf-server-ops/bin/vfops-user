#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT_DIR="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
CORE="$ROOT_DIR/bin/vfops"
VERSION="$(cat "$ROOT_DIR/VERSION" 2>/dev/null || printf 'UNKNOWN')"
CHANNEL="RC2"
BACKUP_DIR="${VFOPS_BACKUP_DIR:-/var/backups/vf-server-ops}"
INV_FILE=""
SELECTED_DOMAIN=""
SELECTED_BACKUP=""
SSH_PREFLIGHT_STATE="UNKNOWN"

cleanup() {
  [[ -n "$INV_FILE" ]] && rm -f "$INV_FILE" 2>/dev/null || true
}
trap cleanup EXIT

pause() {
  printf '\n按 Enter 返回...'
  read -r _ || true
}

header() {
  clear 2>/dev/null || true
  cat <<EOF
========================================
 P07 · VF Server Ops  ${VERSION} ${CHANNEL}
========================================

  1. 查看这台服务器
  2. 备份网站
  3. 迁移网站到新服务器
  4. 恢复备份

  0. 退出

EOF
}

diagnostic_value() {
  local output="$1" key="$2"
  printf '%s\n' "$output" | sed -nE "s/.*${key}=([^ ]+).*/\1/p" | tail -n1
}

human_reason() {
  local blocker="$1"
  case "$blocker" in
    SITE_NOT_FOUND) printf '没有在 CloudPanel 中找到这个网站。' ;;
    FRESH_VERIFY_NOT_PASS) printf '备份完整性检查没有通过。' ;;
    TARGET_STATE_CONFLICT) printf '目标服务器已有冲突的网站或文件，P07 已停止写入。' ;;
    TARGET_PREFLIGHT_FAILED) printf '新服务器还没有准备好，P07 没有开始迁移。' ;;
    TARGET_CRONTAB_CONFLICT) printf '目标网站用户已有 Cron，P07 不会直接覆盖。' ;;
    RUNTIME_MANUAL_GATE_REQUIRED) printf '有系统级 Cron 需要人工确认，P07 不会自动覆盖。' ;;
    PM2_RUNTIME_FAILED) printf 'PM2 运行环境没有恢复成功。' ;;
    CONFIRMATION_REQUIRED|CONFIRMATION_MISMATCH) printf '安全确认没有通过，P07 已停止。' ;;
    GOOGLE_POOL_CAPACITY_NOT_READY) printf 'Google 备份空间当前不足。' ;;
    ENCRYPTED_REMOTE_NOT_VERIFIED) printf '远程加密存储还没有验证通过。' ;;
    REMOTE_FETCH_FAILED) printf '远程备份取回失败。' ;;
    REMOTE_TRANSFER_FAILED) printf '服务器之间的备份传输失败。' ;;
    REMOTE_INTEGRITY_NOT_PASS) printf '远程备份完整性检查没有通过。' ;;
    *) printf '操作没有完成，P07 已安全停止。' ;;
  esac
}

friendly_failure() {
  local title="$1" output="$2" safe_note="${3:-原网站和现有数据没有被 P07 删除。}"
  local blocker stage
  blocker="$(diagnostic_value "$output" blocker)"
  stage="$(diagnostic_value "$output" stage)"
  printf '\n%s\n' "$title"
  printf '%s\n' "$(human_reason "${blocker:-UNKNOWN}")"
  [[ -n "$stage" ]] && printf '阶段：%s\n' "$stage"
  [[ -n "$blocker" ]] && printf '状态：%s\n' "$blocker"
  [[ -n "$safe_note" ]] && printf '%s\n' "$safe_note"
  printf '如需工程诊断，可运行：vfops --advanced --help\n'
}

load_inventory() {
  cleanup
  INV_FILE="$(mktemp -t p07-inventory.XXXXXX)"
  local output rc
  if output="$("$CORE" inventory --compact 2>&1)"; then
    rc=0
  else
    rc=$?
    friendly_failure "无法读取这台服务器。" "$output" "服务器没有被修改。"
    return 1
  fi
  printf '%s\n' "$output" >"$INV_FILE"
  return 0
}

show_inventory() {
  python3 - "$INV_FILE" <<'PY'
import json, sys
p=json.load(open(sys.argv[1], encoding='utf-8'))
system=p.get('system',{}) if isinstance(p.get('system'),dict) else {}
osinfo=system.get('os',{}) if isinstance(system.get('os'),dict) else {}
sites=p.get('sites',[]) if isinstance(p.get('sites'),list) else []
summary=p.get('summary',{}) if isinstance(p.get('summary'),dict) else {}
print('\n服务器概览')
print('----------------------------------------')
print(f"系统：{osinfo.get('pretty_name','UNKNOWN')}")
print(f"CloudPanel：{system.get('cloudpanel_version','UNKNOWN')}")
print(f"网站数量：{len(sites)}")
print(f"MySQL 数据库：{summary.get('mysql_database_count_known','UNKNOWN')}")
print(f"SQLite 文件：{summary.get('sqlite_file_count_known','UNKNOWN')}")
print('\n网站')
print('----------------------------------------')
if not sites:
    print('没有发现 CloudPanel 网站。')
for i,s in enumerate(sites,1):
    runtime=s.get('runtime',{}) if isinstance(s.get('runtime'),dict) else {}
    mysql=s.get('mysql_databases')
    sqlite=s.get('sqlite_paths')
    ssl=s.get('ssl',{}) if isinstance(s.get('ssl'),dict) else {}
    dbn=len(mysql) if isinstance(mysql,list) else '?'
    sqn=len(sqlite) if isinstance(sqlite,list) else '?'
    ssl_text='已配置' if ssl.get('configured') is True else ('未配置' if ssl.get('configured') is False else '未知')
    print(f"{i}. {s.get('domain','UNKNOWN')}")
    print(f"   类型：{runtime.get('type','UNKNOWN')}  MySQL：{dbn}  SQLite：{sqn}  SSL：{ssl_text}")
PY
}

select_site() {
  SELECTED_DOMAIN=""
  load_inventory || return 1
  local count choice
  count="$(python3 - "$INV_FILE" <<'PY'
import json,sys
p=json.load(open(sys.argv[1],encoding='utf-8'))
print(len(p.get('sites',[]) if isinstance(p.get('sites'),list) else []))
PY
)"
  if [[ "$count" -eq 0 ]]; then
    printf '\n没有发现可操作的网站。\n' >&2
    return 1
  fi
  printf '\n请选择网站\n----------------------------------------\n'
  python3 - "$INV_FILE" <<'PY'
import json,sys
p=json.load(open(sys.argv[1],encoding='utf-8'))
for i,s in enumerate(p.get('sites',[]),1):
    print(f"  {i}. {s.get('domain','UNKNOWN')}")
print("  0. 返回")
PY
  printf '\n请选择 [0-%s]：' "$count"
  read -r choice || return 2
  [[ "$choice" =~ ^[0-9]+$ ]] || { printf '请输入上面的数字。\n' >&2; return 1; }
  [[ "$choice" == "0" ]] && return 2
  (( choice >= 1 && choice <= count )) || { printf '选择超出范围。\n' >&2; return 1; }
  SELECTED_DOMAIN="$(python3 - "$INV_FILE" "$choice" <<'PY'
import json,sys
p=json.load(open(sys.argv[1],encoding='utf-8'))
print(p['sites'][int(sys.argv[2])-1]['domain'])
PY
)"
  [[ -n "$SELECTED_DOMAIN" ]]
}

show_server() {
  printf '\n[P07] 正在读取这台服务器...\n'
  if load_inventory; then
    show_inventory
  fi
  pause
}

backup_result_card() {
  local package="$1" fallback_domain="$2" size="未知"
  command -v du >/dev/null 2>&1 && size="$(du -sh "$package" 2>/dev/null | awk '{print $1}' || printf '未知')"
  python3 - "$package" "$fallback_domain" "$size" <<'PY'
import json,sys
from pathlib import Path
package=Path(sys.argv[1])
fallback=sys.argv[2]
size=sys.argv[3]
try:
    d=json.loads((package/'manifest.json').read_text(encoding='utf-8'))
except Exception:
    d={}
domain=(d.get('site') or {}).get('domain') if isinstance(d.get('site'),dict) else None
print('\n备份完成 ✓')
print(f"网站：{domain or fallback}")
print(f"备份编号：{d.get('backup_id','UNKNOWN')}")
print(f"大小：{size}")
print('状态：已验证，可恢复')
print('保存：本机')
print(f"位置：{package}")
PY
}

backup_site() {
  printf '\n[P07] 正在读取 CloudPanel 网站...\n'
  local rc
  if select_site; then
    rc=0
  else
    rc=$?
    [[ $rc -eq 2 ]] && return 0
    pause
    return 0
  fi

  printf '\n将备份：%s\n' "$SELECTED_DOMAIN"
  printf '备份位置：%s\n' "$BACKUP_DIR"
  printf '开始备份？[Y/n]：'
  local yn output
  read -r yn || return 0
  [[ -z "$yn" || "$yn" =~ ^[Yy]$ ]] || return 0
  printf '\n[P07] 正在创建并校验备份...\n'
  if output="$("$CORE" backup --site "$SELECTED_DOMAIN" --output-dir "$BACKUP_DIR" 2>&1)"; then
    rc=0
  else
    rc=$?
    friendly_failure "备份没有完成。" "$output"
    pause
    return 0
  fi
  local path
  path="$(printf '%s\n' "$output" | tail -n1)"
  backup_result_card "$path" "$SELECTED_DOMAIN"
  pause
}

backup_identity() {
  python3 - "$1" <<'PY'
import json,sys
from pathlib import Path
p=Path(sys.argv[1])/'manifest.json'
d=json.loads(p.read_text(encoding='utf-8'))
print(f"{d.get('site',{}).get('domain','')}\t{d.get('backup_id','')}")
PY
}

list_backups() {
  python3 - "$BACKUP_DIR" <<'PY'
import json,sys
from pathlib import Path
base=Path(sys.argv[1])
rows=[]
if base.is_dir():
    for m in base.glob('*/manifest.json'):
        try:
            d=json.loads(m.read_text(encoding='utf-8'))
            vpath=m.parent/'verification.json'
            if not vpath.is_file():
                continue
            verification=json.loads(vpath.read_text(encoding='utf-8'))
            if verification.get('status') != 'PASS':
                continue
            rows.append((m.parent, d.get('site',{}).get('domain','UNKNOWN'), d.get('backup_id','UNKNOWN'), d.get('created_at','UNKNOWN')))
        except Exception:
            pass
rows.sort(key=lambda x:x[3], reverse=True)
for i,(path,domain,bid,created) in enumerate(rows,1):
    print(f"{i}\t{path}\t{domain}\t{bid}\t{created}")
PY
}

select_backup() {
  SELECTED_BACKUP=""
  local raw count choice
  raw="$(list_backups)"
  if [[ -z "$raw" ]]; then
    printf '\n没有发现已验证、可恢复的 P07 本地备份。\n' >&2
    return 1
  fi
  count="$(printf '%s\n' "$raw" | wc -l | tr -d ' ')"
  printf '\n可恢复备份\n----------------------------------------\n'
  printf '%s\n' "$raw" | awk -F '\t' '{printf "  %s. %s  (%s)\n",$1,$3,$5}'
  printf '  0. 返回\n'
  printf '\n请选择 [0-%s]：' "$count"
  read -r choice || return 2
  [[ "$choice" =~ ^[0-9]+$ ]] || { printf '请输入上面的数字。\n' >&2; return 1; }
  [[ "$choice" == "0" ]] && return 2
  (( choice >= 1 && choice <= count )) || { printf '选择超出范围。\n' >&2; return 1; }
  SELECTED_BACKUP="$(printf '%s\n' "$raw" | awk -F '\t' -v n="$choice" '$1==n{print $2}')"
  [[ -n "$SELECTED_BACKUP" ]]
}

validate_ip() {
  python3 - "$1" <<'PY' >/dev/null 2>&1
import ipaddress,sys
ipaddress.ip_address(sys.argv[1])
PY
}

ssh_state_line() {
  printf '连接状态：%s\n' "$1"
}

target_ssh_preflight() {
  local target_ip="$1" domain="$2" output rc remote_cmd
  SSH_PREFLIGHT_STATE="UNKNOWN"
  command -v ssh >/dev/null 2>&1 || {
    SSH_PREFLIGHT_STATE="UNREACHABLE"
    printf '\n新服务器连接未准备好。\n'
    ssh_state_line "$SSH_PREFLIGHT_STATE"
    printf '原因：这台源服务器缺少 SSH 客户端。\n'
    printf '迁移尚未开始，也没有创建迁移备份。\n'
    return 13
  }
  if [[ ! "$domain" =~ ^[A-Za-z0-9.-]+$ ]]; then
    SSH_PREFLIGHT_STATE="UNREACHABLE"
    printf '\n网站标识无法安全用于迁移预检。\n'
    ssh_state_line "$SSH_PREFLIGHT_STATE"
    printf '迁移尚未开始，也没有创建迁移备份。\n'
    return 13
  fi

  printf '\n[P07] 正在检查 SSH、CloudPanel 与同名网站冲突...\n'
  if output="$(ssh \
    -p 22 \
    -o BatchMode=yes \
    -o StrictHostKeyChecking=accept-new \
    -o ConnectTimeout=10 \
    -o ServerAliveInterval=10 \
    -o ServerAliveCountMax=1 \
    "root@${target_ip}" \
    "printf P07_SSH_READY" 2>&1)"; then
    rc=0
  else
    rc=$?
    if printf '%s\n' "$output" | grep -Eqi 'permission denied|publickey|no supported authentication methods'; then
      SSH_PREFLIGHT_STATE="NEEDS_KEY_SETUP"
      printf '\nSOURCE 还没有获得 TARGET 的 SSH Key 登录权限。\n'
      ssh_state_line "$SSH_PREFLIGHT_STATE"
      printf '这通常只需要准备一次。\n'
      printf '迁移尚未开始，也没有创建迁移备份。\n'
      return 10
    fi
    SSH_PREFLIGHT_STATE="UNREACHABLE"
    printf '\n无法连接新服务器：%s\n' "$target_ip"
    ssh_state_line "$SSH_PREFLIGHT_STATE"
    printf '请检查 IP、22 端口、防火墙或服务器是否在线。\n'
    printf '迁移尚未开始，也没有创建迁移备份。\n'
    return 13
  fi

  remote_cmd="set -eu; command -v clpctl >/dev/null 2>&1 || exit 43; test -f /home/clp/htdocs/app/data/db.sq3 || exit 43; for p in /home/*/htdocs/${domain}; do [ ! -e \"\$p\" ] || exit 42; done"
  if output="$(ssh \
    -p 22 \
    -o BatchMode=yes \
    -o StrictHostKeyChecking=accept-new \
    -o ConnectTimeout=10 \
    -o ServerAliveInterval=10 \
    -o ServerAliveCountMax=1 \
    "root@${target_ip}" \
    "$remote_cmd" 2>&1)"; then
    rc=0
  else
    rc=$?
    if [[ $rc -eq 42 ]]; then
      SSH_PREFLIGHT_STATE="TARGET_SITE_CONFLICT"
      printf '\n新服务器已经存在同名网站目录：%s\n' "$domain"
      ssh_state_line "$SSH_PREFLIGHT_STATE"
      printf 'P07 不会覆盖已有站点。\n'
      printf '迁移尚未开始，也没有创建迁移备份。\n'
      return 12
    fi
    if [[ $rc -eq 43 ]]; then
      SSH_PREFLIGHT_STATE="TARGET_NOT_CLOUDPANEL"
      printf '\n新服务器可以 SSH 登录，但没有检测到可用的 CloudPanel。\n'
      ssh_state_line "$SSH_PREFLIGHT_STATE"
      printf '请先完成 TARGET 的 CloudPanel 安装。\n'
      printf '迁移尚未开始，也没有创建迁移备份。\n'
      return 11
    fi
    SSH_PREFLIGHT_STATE="UNREACHABLE"
    printf '\n新服务器检查中断。\n'
    ssh_state_line "$SSH_PREFLIGHT_STATE"
    printf '迁移尚未开始，也没有创建迁移备份。\n'
    return 13
  fi

  SSH_PREFLIGHT_STATE="READY"
  ssh_state_line "$SSH_PREFLIGHT_STATE"
  printf 'SSH Key：READY ✓\n'
  printf 'CloudPanel：READY ✓\n'
  printf '同名网站冲突：未发现 ✓\n'
  return 0
}

prepare_target_ssh_key() {
  local target_ip="$1" ssh_dir="${HOME:-/root}/.ssh"
  command -v ssh-copy-id >/dev/null 2>&1 || {
    printf '\n无法自动准备连接：缺少 ssh-copy-id。\n'
    printf '请安装 openssh-client 后重新进入迁移。\n'
    return 1
  }
  command -v ssh-keygen >/dev/null 2>&1 || {
    printf '\n无法自动准备连接：缺少 ssh-keygen。\n'
    printf '请安装 openssh-client 后重新进入迁移。\n'
    return 1
  }

  mkdir -p "$ssh_dir"
  chmod 700 "$ssh_dir"
  if ! compgen -G "$ssh_dir/id_*.pub" >/dev/null; then
    printf '\n[P07] 正在为这台 SOURCE 生成 SSH Key...\n'
    ssh-keygen -q -t ed25519 -f "$ssh_dir/id_ed25519" -N '' -C 'p07-vf-server-ops' || {
      printf 'SSH Key 生成失败。\n'
      return 1
    }
    chmod 600 "$ssh_dir/id_ed25519"
    chmod 644 "$ssh_dir/id_ed25519.pub"
    printf 'SSH Key：已生成 ✓\n'
  fi

  printf '\n接下来如果系统询问 root 密码，请输入 TARGET 的 root 密码。\n'
  printf '这是系统 ssh-copy-id 的临时输入；P07 不读取、不保存、不记录密码。\n'
  if ! ssh-copy-id -o StrictHostKeyChecking=accept-new "root@${target_ip}"; then
    printf '\n连接权限没有准备完成。迁移仍未开始。\n'
    return 1
  fi
  printf '\nSSH Key 已发送到 TARGET ✓\n'
  return 0
}

runtime_plan_summary() {
  local payload="$1"
  python3 - "$payload" <<'PY'
import json,sys
p=json.loads(sys.argv[1])
manual=p.get('manual_cron',[]) if isinstance(p.get('manual_cron'),list) else []
user_cron=isinstance(p.get('user_crontab'),dict)
pm2=p.get('pm2',{}) if isinstance(p.get('pm2'),dict) else {}
print(f"STATUS={p.get('status','UNKNOWN')}")
print(f"USER_CRON={'YES' if user_cron else 'NO'}")
print(f"PM2={'YES' if pm2.get('ready') is True else 'NO'}")
print(f"MANUAL={len(manual)}")
PY
}

restore_backup() {
  local rc
  if select_backup; then
    rc=0
  else
    rc=$?
    [[ $rc -eq 2 ]] && return 0
    pause
    return 0
  fi

  printf '\n[P07] 先做恢复前检查（不会写入服务器）...\n'
  local plan identity domain backup_id confirm restore_output runtime_plan runtime_info runtime_status manual runtime_output
  if plan="$("$CORE" restore plan --package "$SELECTED_BACKUP" 2>&1)"; then
    rc=0
  else
    rc=$?
    friendly_failure "恢复前检查没有通过。" "$plan" "服务器没有被修改。"
    pause
    return 0
  fi
  printf '恢复前检查：PASS ✓\n'
  identity="$(backup_identity "$SELECTED_BACKUP")"
  IFS=$'\t' read -r domain backup_id <<<"$identity"
  printf '将恢复网站：%s\n' "$domain"
  printf '仅允许恢复到全新的 CloudPanel 站点；不会覆盖已有站点，不会改 DNS。\n'
  printf '继续恢复？[y/N]：'
  read -r confirm || return 0
  [[ "$confirm" =~ ^[Yy]$ ]] || { printf '已取消。\n'; return 0; }

  printf '\n[P07] 正在恢复网站数据...\n'
  if restore_output="$("$CORE" restore apply-new-site --package "$SELECTED_BACKUP" --confirm "RESTORE_NEW_SITE:${domain}:${backup_id}" 2>&1)"; then
    rc=0
  else
    rc=$?
    friendly_failure "网站数据恢复没有完成。" "$restore_output"
    pause
    return 0
  fi
  printf '网站数据：已恢复 ✓\n'

  printf '\n[P07] 正在检查 Cron / PM2 运行环境（只读）...\n'
  if runtime_plan="$("$CORE" runtime plan --package "$SELECTED_BACKUP" 2>&1)"; then
    rc=0
  else
    rc=$?
    friendly_failure "网站数据已恢复，但运行环境检查没有完成。" "$runtime_plan" "网站数据已保留；DNS 没有修改。"
    printf '最终状态：NEEDS_RUNTIME_CHECK\n'
    pause
    return 0
  fi

  runtime_info="$(runtime_plan_summary "$runtime_plan")"
  runtime_status="$(printf '%s\n' "$runtime_info" | sed -n 's/^STATUS=//p')"
  manual="$(printf '%s\n' "$runtime_info" | sed -n 's/^MANUAL=//p')"

  if [[ "$runtime_status" == "READY_WITH_MANUAL_GATES" || "${manual:-0}" -gt 0 ]]; then
    printf '\n网站数据已恢复 ✓\n'
    printf '但运行环境尚未完全恢复。\n'
    printf '原因：发现系统级/不支持自动处理的 Cron，需要人工确认。\n'
    printf '最终状态：NEEDS_MANUAL_RUNTIME_GATE\n'
    printf 'DNS 没有修改。\n'
    pause
    return 0
  fi

  printf '运行环境检查：READY ✓\n'
  printf '[P07] 正在恢复 Cron / PM2...\n'
  if runtime_output="$("$CORE" runtime apply-new-site \
    --package "$SELECTED_BACKUP" \
    --confirm "ACTIVATE_RUNTIME:${domain}:${backup_id}" 2>&1)"; then
    rc=0
  else
    rc=$?
    friendly_failure "网站数据已恢复，但 Cron / PM2 没有完全恢复。" "$runtime_output" "网站数据已保留；DNS 没有修改。"
    printf '最终状态：NEEDS_RUNTIME_ATTENTION\n'
    pause
    return 0
  fi

  printf '\n恢复完成 ✓\n'
  printf '网站数据：PASS\n'
  printf 'Cron / PM2：PASS\n'
  printf 'DNS：未修改\n'
  printf '最终状态：RESTORE_COMPLETE\n'
  pause
}

migrate_site() {
  printf '\n[P07] 正在读取源服务器网站...\n'
  local rc
  if select_site; then
    rc=0
  else
    rc=$?
    [[ $rc -eq 2 ]] && return 0
    pause
    return 0
  fi

  local target_ip confirm output package identity domain backup_id migration_output preflight_rc setup_choice
  printf '\n迁移网站：%s\n' "$SELECTED_DOMAIN"
  printf '新服务器 IP（输入 0 返回）：'
  read -r target_ip || return 0
  [[ "$target_ip" == "0" ]] && return 0
  if [[ -z "$target_ip" ]] || ! validate_ip "$target_ip"; then
    printf '请输入有效的 IPv4 / IPv6 地址。\n'
    pause
    return 0
  fi

  printf '\n[1/3] 检查新服务器...\n'
  if target_ssh_preflight "$target_ip" "$SELECTED_DOMAIN"; then
    preflight_rc=0
  else
    preflight_rc=$?
    if [[ $preflight_rc -eq 10 ]]; then
      printf '\n  1. 现在准备 SOURCE → TARGET 连接\n'
      printf '  0. 返回\n'
      printf '请选择 [0-1]：'
      read -r setup_choice || return 0
      if [[ "$setup_choice" == "1" ]]; then
        if prepare_target_ssh_key "$target_ip"; then
          printf '\n[P07] 重新检查新服务器...\n'
          if ! target_ssh_preflight "$target_ip" "$SELECTED_DOMAIN"; then
            pause
            return 0
          fi
        else
          pause
          return 0
        fi
      else
        return 0
      fi
    else
      pause
      return 0
    fi
  fi

  printf '\nP07 将：创建迁移备份 → SSH 传输 → 新站恢复 → Runtime → 技术验证。\n'
  printf '不会改 DNS，不会删除旧服务器。\n'
  printf '开始迁移？[y/N]：'
  read -r confirm || return 0
  [[ "$confirm" =~ ^[Yy]$ ]] || { printf '已取消。\n'; return 0; }

  printf '\n[2/3] 创建并验证迁移备份...\n'
  if output="$("$CORE" backup --site "$SELECTED_DOMAIN" --kind pre_migration --output-dir "$BACKUP_DIR" 2>&1)"; then
    rc=0
  else
    rc=$?
    friendly_failure "迁移备份没有完成。" "$output"
    pause
    return 0
  fi
  package="$(printf '%s\n' "$output" | tail -n1)"
  identity="$(backup_identity "$package")"
  IFS=$'\t' read -r domain backup_id <<<"$identity"

  printf '\n[3/3] 正在传输、恢复 Runtime 并做技术验证...\n'
  printf '这一步可能需要一些时间，请以最终结果为准。\n'
  if migration_output="$("$CORE" migrate transfer-new-site \
    --package "$package" \
    --target-host "$target_ip" \
    --target-ip "$target_ip" \
    --ssh-user root \
    --ssh-port 22 \
    --confirm "MIGRATE_NEW_SITE:${domain}:${backup_id}" 2>&1)"; then
    rc=0
    printf '\n迁移技术验证完成 ✓\n'
    printf '网站：%s\n' "$domain"
    printf '新服务器：%s · READY\n' "$target_ip"
    printf '迁移技术验证：PASS\n'
    printf '当前网站流量：仍在旧服务器\n'
    printf 'DNS：未修改\n'
    printf '旧服务器：保留\n'
    printf '下一步：确认新服务器网站无误后，再单独决定 DNS 切换。\n'
  else
    friendly_failure "迁移没有完成。" "$migration_output" "源网站和迁移备份仍保留；DNS 没有修改。"
  fi
  pause
}

if (($# > 0)); then
  case "$1" in
    --version|-V)
      printf 'VF Server Ops %s %s\n' "$VERSION" "$CHANNEL"
      exit 0
      ;;
    --advanced)
      shift
      exec "$CORE" "$@"
      ;;
    *)
      exec "$CORE" "$@"
      ;;
  esac
fi

while true; do
  header
  printf '请选择 [0-4]：'
  read -r choice || exit 0
  case "$choice" in
    1) show_server ;;
    2) backup_site ;;
    3) migrate_site ;;
    4) restore_backup ;;
    0) exit 0 ;;
    *) printf '\n请输入 0-4。\n'; pause ;;
  esac
done
