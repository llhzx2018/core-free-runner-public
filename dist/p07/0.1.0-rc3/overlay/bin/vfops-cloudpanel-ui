#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$ROOT_DIR/lib/cloudpanel_ui_common.sh"
source "$ROOT_DIR/lib/cloudpanel_ui_sites.sh"
source "$ROOT_DIR/lib/cloudpanel_ui_ops.sh"
source "$ROOT_DIR/lib/cloudpanel_ui_admin.sh"

while true; do
  cat <<'EOF'

CloudPanel 网站工具
----------------------------------------
  1. 网站详情
  2. 网站健康检查
  3. 创建网站
  4. 数据库工具
  5. SSL / HTTPS
  6. 权限 / 缓存
  7. CloudPanel 安全
  8. CloudPanel 用户
  9. Vhost 模板
 10. 平台基础能力检查
  0. 返回

说明：删除网站 / 删除数据库 / 删除用户不在普通入口中。
      P07 不自动修改 DNS，不删除 SOURCE，不覆盖已有 TARGET。
EOF
  printf '请选择 [0-10]：'; read -r choice || exit 0
  case "$choice" in
    1) show_site_details ;;
    2) site_health ;;
    3) create_site ;;
    4) database_tools ;;
    5) ssl_tools ;;
    6) maintenance_tools ;;
    7) panel_security ;;
    8) panel_users ;;
    9) vhost_tools ;;
    10) platform_status ;;
    0) exit 0 ;;
    *) printf '请输入 0-10。\n' ;;
  esac
done
