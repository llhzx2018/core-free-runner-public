#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT_DIR="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
CORE="$ROOT_DIR/bin/vfops"
ENGINE="$ROOT_DIR/lib/auto_backup.py"
SETUP_MENU="$ROOT_DIR/bin/vfops-storage-setup"
CONFIG="${VFOPS_AUTO_BACKUP_CONFIG:-/etc/vf-server-ops/auto-backup.json}"
STORAGE_CONFIG="${VFOPS_STORAGE_CONFIG:-/etc/vf-server-ops/storage.json}"
BACKUP_DIR="${VFOPS_BACKUP_DIR:-/var/backups/vf-server-ops}"
CRON_FILE="${VFOPS_AUTO_BACKUP_CRON:-/etc/cron.d/vf-server-ops-auto-backup}"
STATE_FILE="${VFOPS_AUTO_BACKUP_STATE:-/var/lib/vf-server-ops/auto-backup-state.json}"

screen_clear() { [[ -t 1 ]] && printf '\033[H\033[2J' || true; }
pause_menu() { printf '\n按 Enter 返回...'; read -r _ || true; }

header() {
  screen_clear
  cat <<'EOF'
P07 · 自动备份

每天自动执行：
  本地 Fresh Verify
  → Google Drive 加密副本
  → Backblaze B2 加密灾备副本

EOF
}

require_root() {
  if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
    printf '自动备份设置需要 root。\n' >&2
    return 1
  fi
}

storage_preflight() {
  if [[ ! -f "$STORAGE_CONFIG" ]]; then
    printf 'Google + B2 远程存储尚未设置。\n' >&2
    printf '请先选择“1. 设置 / 检查 Google + B2”。\n' >&2
    return 1
  fi
  command -v rclone >/dev/null 2>&1 || {
    printf '缺少 rclone，无法验证 Google / B2 加密远程。\n' >&2
    return 1
  }
  printf '\n[P07] 正在验证 Google + B2 加密远程，请稍候...\n'
  local output
  if ! output="$("$CORE" storage --config "$STORAGE_CONFIG" status 2>&1)"; then
    printf '%s\n' "$output" >&2
    printf '远程存储检查没有通过，自动备份未启用。\n' >&2
    return 1
  fi
  if ! python3 - "$output" <<'PY'
import json,sys
p=json.loads(sys.argv[1])
accounts=p.get('accounts',[]) if isinstance(p.get('accounts'),list) else []
google=any(a.get('provider')=='google' and a.get('enabled') is True and a.get('health')=='OK' for a in accounts if isinstance(a,dict))
b2=any(a.get('provider')=='b2' and a.get('enabled') is True and a.get('health')=='OK' for a in accounts if isinstance(a,dict))
raise SystemExit(0 if google and b2 else 1)
PY
  then
    printf '需要至少一个健康的 Google crypt 远程和一个健康的 B2 crypt 远程。\n' >&2
    printf '请先重新运行“设置 / 检查 Google + B2”。\n' >&2
    return 1
  fi
  printf 'Google Drive：READY ✓\n'
  printf 'Backblaze B2：READY ✓\n'
}

inventory_sites() {
  local payload
  if ! payload="$("$CORE" inventory --compact 2>&1)"; then
    printf '%s\n' "$payload" >&2
    return 1
  fi
  python3 - "$payload" <<'PY'
import json,sys
p=json.loads(sys.argv[1])
for site in p.get('sites',[]):
    if isinstance(site,dict) and isinstance(site.get('domain'),str) and site.get('domain'):
        print(site['domain'])
PY
}

schedule_guard() {
  local requested="$1" output
  if ! output="$(python3 "$ENGINE" schedule-check --daily-at "$requested" 2>&1)"; then
    printf '%s\n' "$output" >&2
    return 1
  fi
  python3 - "$output" <<'PY'
import json,sys
p=json.loads(sys.argv[1])
print(p.get('status','UNKNOWN'))
print(p.get('recommended_at',p.get('requested_at','')))
print(p.get('collision_count',0))
for item in p.get('collisions',[]):
    print(f"{item.get('scheduled_at','?')}\t{item.get('path','?')}")
PY
}

setup_storage() {
  if [[ ! -x "$SETUP_MENU" ]]; then
    printf '远程存储设置组件缺失，请重新运行 P07 主入口更新。\n' >&2
    pause_menu
    return 0
  fi
  bash "$SETUP_MENU"
}

show_status() {
  printf '\n[P07] 正在检查自动备份设置与 Google + B2 实时状态，请稍候...\n'
  local output rc remote_output remote_rc
  set +e
  output="$(python3 "$ENGINE" status --config "$CONFIG" --cron-file "$CRON_FILE" --state-file "$STATE_FILE" 2>/dev/null)"
  rc=$?
  set -e
  if [[ $rc -ne 0 && $rc -ne 12 ]]; then
    printf '%s\n' "$output" >&2
    printf '自动备份状态读取失败；没有修改任何配置。\n' >&2
    pause_menu
    return 0
  fi
  if ! python3 - "$output" <<'PY' >/dev/null 2>&1
import json,sys
p=json.loads(sys.argv[1])
raise SystemExit(0 if isinstance(p,dict) and p.get('schema')=='vf-server-ops.auto-backup-status.v1' else 1)
PY
  then
    printf '%s\n' "$output" >&2
    printf '自动备份状态返回格式异常；没有修改任何配置。\n' >&2
    pause_menu
    return 0
  fi

  remote_output='{}'
  remote_rc=125
  if [[ -f "$STORAGE_CONFIG" ]] && command -v rclone >/dev/null 2>&1 && [[ -x "$CORE" ]]; then
    set +e
    remote_output="$("$CORE" storage --config "$STORAGE_CONFIG" status 2>/dev/null)"
    remote_rc=$?
    set -e
  fi

  python3 - "$output" "$remote_output" "$remote_rc" <<'PY'
import json,sys

base=json.loads(sys.argv[1])
try:
    live=json.loads(sys.argv[2]) if sys.argv[2] else {}
except json.JSONDecodeError:
    live={}
try:
    remote_rc=int(sys.argv[3])
except ValueError:
    remote_rc=125

status=base.get('status','UNKNOWN')
last=base.get('last_run') if isinstance(base.get('last_run'),dict) else None

def provider_health(provider):
    if status == 'NOT_CONFIGURED':
        return 'NOT_CONFIGURED'
    if remote_rc != 0 or not isinstance(live,dict):
        return 'CHECK_FAILED'
    accounts=live.get('accounts',[]) if isinstance(live.get('accounts'),list) else []
    provider_accounts=[a for a in accounts if isinstance(a,dict) and a.get('provider')==provider and a.get('enabled') is True]
    if not provider_accounts:
        return 'MISSING'
    return 'OK' if any(a.get('health')=='OK' for a in provider_accounts) else 'UNAVAILABLE'

google=provider_health('google')
b2=provider_health('b2')
live_ok=(google=='OK' and b2=='OK')
effective=status
if status=='ENABLED' and not live_ok:
    effective='LIVE_ATTENTION'

cn={
    'ENABLED':'已启用',
    'DISABLED':'已关闭',
    'NOT_CONFIGURED':'未配置',
    'ATTENTION':'需关注',
    'LIVE_ATTENTION':'需关注（实时远程异常）',
}.get(effective,effective)
health_cn={
    'OK':'正常 ✓',
    'UNAVAILABLE':'不可用',
    'MISSING':'未配置',
    'CHECK_FAILED':'检查失败',
    'NOT_CONFIGURED':'未配置',
}

print()
print('自动备份状态')
print('----------------------------------------')
print(f"状态：{cn}")
if status != 'NOT_CONFIGURED':
    print(f"时间：每天 {base.get('daily_at','UNKNOWN')}")
    sites=base.get('sites',[]) if isinstance(base.get('sites'),list) else []
    print(f"网站：{len(sites)} 个")
    for site in sites:
        print(f"  - {site}")
    print('远程：Google + Backblaze B2')
    print(f"Google 实时：{health_cn.get(google,google)}")
    print(f"B2 实时：{health_cn.get(b2,b2)}")
    print(f"本地自动备份保留：最近 {base.get('local_keep_last','?')} 份 / 网站")
    print(f"Cron：{'已安装（P07 owned）' if base.get('cron_installed') else '未安装 / 非 P07 owned'}")
    print(f"配置结构：{base.get('storage_state','UNKNOWN')}")

if last:
    result=last.get('status','UNKNOWN')
    cn_result={'PASS':'PASS','FAIL':'FAIL','RUNNING':'执行中','SKIPPED_BUSY':'服务器忙，已让路','DISABLED':'已关闭'}.get(result,result)
    print(f"上次执行：{cn_result}")
    print(f"更新时间：{last.get('updated_at','UNKNOWN')}")
    rows=last.get('sites',[]) if isinstance(last.get('sites'),list) else []
    detail_rows=[row for row in rows if isinstance(row,dict)]
    if detail_rows:
        print('上次各网站：')
        for row in detail_rows:
            print(f"  {row.get('domain','UNKNOWN')}")
            print(f"    本地：{row.get('local_backup','UNKNOWN')}")
            print(f"    Google：{row.get('google','UNKNOWN')}")
            print(f"    B2：{row.get('b2','UNKNOWN')}")
            print(f"    双副本：{row.get('dual_remote','UNKNOWN')}")
    if result=='SKIPPED_BUSY':
        print('说明：上次检测到服务器正在执行备份 / 恢复 / 迁移 / 远程存储任务，P07 已安全让路。')

if status=='NOT_CONFIGURED':
    action='先选择“1. 设置 / 检查 Google + B2”，再选择“2. 启用 / 更新自动备份”。'
elif not base.get('enabled',False):
    if not live_ok:
        action='自动备份已关闭；如要重新启用，先选择“1. 设置 / 检查 Google + B2”确认远程，再选择“2. 启用 / 更新自动备份”。'
    else:
        action='如需恢复定时保护，选择“2. 启用 / 更新自动备份”。'
elif not base.get('cron_installed',False):
    action='选择“2. 启用 / 更新自动备份”修复 P07 自己的定时任务；不会修改 CloudPanel Cron。'
elif not live_ok:
    action='选择“1. 设置 / 检查 Google + B2”修复实时远程状态；修复后可选择“3. 立即完整备份一次”验证。'
elif last and last.get('status')=='FAIL':
    action='远程当前正常，但上次备份失败；选择“3. 立即完整备份一次”重新验证，并查看失败输出。'
elif last and last.get('status')=='SKIPPED_BUSY':
    action='无需修复；稍后选择“3. 立即完整备份一次”，或等待下一次计划任务自动重试。'
elif last and last.get('status')=='RUNNING':
    action='当前可能仍在执行备份；稍后再查看状态，不要重复启动。'
elif last is None:
    action='当前设置正常但还没有执行记录；可选择“3. 立即完整备份一次”完成首次验证。'
else:
    action='当前无需操作；继续保留定时备份即可。'

print(f"下一步：{action}")
print('安全边界：DNS 未修改；状态检查不会删除 SOURCE、备份或改写 CloudPanel Cron。')
PY
  pause_menu
}

enable_or_update() {
  require_root || { pause_menu; return 0; }
  storage_preflight || { pause_menu; return 0; }

  local sites_raw daily_at choice schedule_raw schedule_state recommended collision_count
  if ! sites_raw="$(inventory_sites)" || [[ -z "$sites_raw" ]]; then
    printf '没有发现可自动备份的 CloudPanel 网站。\n' >&2
    pause_menu
    return 0
  fi

  printf '\n将保护当前 CloudPanel 全部网站：\n'
  while IFS= read -r site; do [[ -n "$site" ]] && printf '  - %s\n' "$site"; done <<<"$sites_raw"

  printf '\n每天备份时间 [03:30]：'
  read -r daily_at || return 0
  [[ -n "$daily_at" ]] || daily_at='03:30'
  if [[ ! "$daily_at" =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]]; then
    printf '时间格式应为 HH:MM，例如 03:30。\n' >&2
    pause_menu
    return 0
  fi

  if ! schedule_raw="$(schedule_guard "$daily_at")"; then
    printf '无法完成定时冲突检查，P07 暂不写入 Cron。\n' >&2
    pause_menu
    return 0
  fi
  schedule_state="$(printf '%s\n' "$schedule_raw" | sed -n '1p')"
  recommended="$(printf '%s\n' "$schedule_raw" | sed -n '2p')"
  collision_count="$(printf '%s\n' "$schedule_raw" | sed -n '3p')"
  if [[ "$schedule_state" == 'COLLISION' ]]; then
    printf '\n检测到 %s 个相邻的备份类定时任务。\n' "$collision_count"
    printf '%s\n' "$schedule_raw" | tail -n +4 | while IFS=$'\t' read -r at path; do
      [[ -n "$at" ]] && printf '  %s  %s\n' "$at" "$path"
    done
    printf 'P07 已建议错峰：%s → %s\n' "$daily_at" "$recommended"
    daily_at="$recommended"
  else
    printf '\n定时冲突检查：CLEAR ✓\n'
  fi

  printf '\n将启用：本地 + Google + B2，每个网站本地保留最近 7 份自动备份。\n'
  printf '执行时间：每天 %s\n' "$daily_at"
  printf '运行时若发现备份/恢复/迁移/远程上传正忙，会自动让路，不抢资源。\n'
  printf '不会修改 DNS，不会删除网站，不会删除手工/迁移备份。\n\n'
  printf '1. 确认启用 / 更新\n0. 取消\n\n请选择 [0-1]：'
  read -r choice || return 0
  [[ "$choice" == '1' ]] || { printf '已取消。\n'; pause_menu; return 0; }

  local args=()
  while IFS= read -r site; do [[ -n "$site" ]] && args+=(--site "$site"); done <<<"$sites_raw"

  printf '\n[P07] 正在写入 P07 自动备份配置...\n'
  if ! python3 "$ENGINE" configure --config "$CONFIG" "${args[@]}" --daily-at "$daily_at" --storage-config "$STORAGE_CONFIG" --backup-dir "$BACKUP_DIR" --keep-last 7 >/dev/null; then
    printf '自动备份配置写入失败。\n' >&2
    pause_menu
    return 0
  fi
  if ! python3 "$ENGINE" install-cron --config "$CONFIG" --cron-file "$CRON_FILE" --script "$ENGINE" --python /usr/bin/python3 --confirm ENABLE_DUAL_REMOTE_AUTOBACKUP >/dev/null; then
    printf '定时任务安装失败；不会假装已启用。\n' >&2
    pause_menu
    return 0
  fi

  printf '\n自动备份已启用 ✓\n'
  printf '时间：每天 %s\n' "$daily_at"
  printf '目标：本地 + Google Drive + Backblaze B2\n'
  printf '并发保护：已启用\nDNS：不会修改\n'
  pause_menu
}

run_now() {
  require_root || { pause_menu; return 0; }
  if [[ ! -f "$CONFIG" ]]; then
    printf '尚未配置自动备份，请先选择“启用 / 更新自动备份”。\n' >&2
    pause_menu
    return 0
  fi
  printf '\n[P07] 正在执行一次完整双远程自动备份。\n'
  printf '若检测到备份/恢复/迁移/远程上传正忙，本次会自动让路。\n'
  local output rc
  set +e
  output="$(python3 "$ENGINE" run --config "$CONFIG" --state-file "$STATE_FILE" 2>&1)"
  rc=$?
  set -e
  if [[ $rc -ne 0 ]]; then
    printf '%s\n' "$output" >&2
    printf '\n本次自动备份没有达到双副本 PASS；已有本地/成功远程副本不会因此被删除。\n' >&2
    pause_menu
    return 0
  fi
  python3 - "$output" <<'PY'
import json,sys
p=json.loads(sys.argv[1])
status=p.get('status','UNKNOWN')
print()
if status=='SKIPPED_BUSY':
    print('服务器当前有备份/恢复/迁移/远程上传任务，P07 本次已自动让路。')
    print('状态：SKIPPED_BUSY')
    print('没有删除任何备份，也没有修改 DNS。')
    raise SystemExit
print('自动备份结果')
print('----------------------------------------')
for row in p.get('sites',[]):
    print(row.get('domain','UNKNOWN'))
    print(f"  本地：{row.get('local_backup','UNKNOWN')}")
    print(f"  Google：{row.get('google','UNKNOWN')}")
    print(f"  B2：{row.get('b2','UNKNOWN')}")
    print(f"  双副本：{row.get('dual_remote','UNKNOWN')}")
print(f"最终：{status}")
print('DNS：未修改')
PY
  pause_menu
}

disable_auto() {
  require_root || { pause_menu; return 0; }
  if [[ ! -f "$CONFIG" && ! -f "$CRON_FILE" ]]; then
    printf '自动备份当前没有启用。\n'
    pause_menu
    return 0
  fi
  printf '\n关闭后只停止以后自动执行；不会删除现有本地、Google 或 B2 备份。\n\n'
  printf '1. 确认关闭\n0. 取消\n\n请选择 [0-1]：'
  local choice
  read -r choice || return 0
  [[ "$choice" == '1' ]] || { printf '已取消。\n'; pause_menu; return 0; }
  if python3 "$ENGINE" disable --config "$CONFIG" --cron-file "$CRON_FILE" --confirm DISABLE_DUAL_REMOTE_AUTOBACKUP >/dev/null; then
    printf '自动备份已关闭。现有备份均保留。\n'
  else
    printf '关闭没有完成；P07 没有删除任何备份。\n' >&2
  fi
  pause_menu
}

while true; do
  header
  cat <<'EOF'
1. 设置 / 检查 Google + B2
2. 启用 / 更新自动备份
3. 立即完整备份一次
4. 查看自动备份状态
5. 关闭自动备份
0. 返回

EOF
  printf '请选择 [0-5]：'
  read -r choice || exit 0
  case "$choice" in
    1) setup_storage ;;
    2) enable_or_update ;;
    3) run_now ;;
    4) show_status ;;
    5) disable_auto ;;
    0) exit 0 ;;
    *) printf '请输入 0-5。\n'; pause_menu ;;
  esac
done
