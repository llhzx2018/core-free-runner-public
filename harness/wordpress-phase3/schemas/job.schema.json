{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vf.local/schemas/wordpress-phase3-job-v2.json",
  "title": "VF WordPress Phase 3 Job Manifest V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "component_id", "run_id", "phase", "source", "environment", "tests"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "project_id": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[A-Za-z0-9._-]+$"},
    "component_id": {"type": "string", "maxLength": 80, "pattern": "^[A-Za-z0-9._-]*$"},
    "run_id": {"type": "string", "minLength": 8, "maxLength": 120, "pattern": "^[A-Za-z0-9._-]+$"},
    "phase": {"const": "PHASE3"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["none", "local_directory"]},
        "path": {"type": "string", "minLength": 1, "maxLength": 240},
        "exact_sha": {"type": "string", "pattern": "^[a-fA-F0-9]{40}$"}
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "local_directory"}}},
          "then": {"required": ["path", "exact_sha"]}
        }
      ]
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wordpress", "php", "mariadb"],
      "properties": {
        "wordpress": {"const": "7.0.2"},
        "php": {"const": "8.4"},
        "mariadb": {"const": "11.8.8"}
      }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {"const": "environment"}
    }
  }
}

