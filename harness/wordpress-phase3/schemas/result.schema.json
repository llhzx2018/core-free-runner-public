{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vf.local/schemas/wordpress-phase3-result-v2.json",
  "title": "VF WordPress Phase 3 Result V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "component_id", "run_id", "status", "started_at", "finished_at", "environment", "checks"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "project_id": {"type": "string"},
    "component_id": {"type": "string"},
    "run_id": {"type": "string"},
    "status": {"enum": ["PASS", "FAIL", "BLOCKED_ENV", "BLOCKED_EXTERNAL", "CANCELLED"]},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "environment": {"type": "object", "additionalProperties": true},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "detail"],
        "properties": {
          "id": {"type": "string"},
          "status": {"enum": ["PASS", "FAIL", "BLOCKED", "N_A"]},
          "detail": {"type": "string"}
        }
      }
    },
    "root_causes": {"type": "array", "items": {"type": "string"}}
  }
}

