name: p01-pr1946-final-candidate-gate
on:
  pull_request:
    branches: [main]
    paths:
      - '.github/workflows/p01-pr1946-final-candidate-temp.yml'
      - 'specs/p01_pr1946_final_candidate.json'
      - 'templates/p01_pr1946_final_candidate.yml.in'
permissions:
  contents: read
jobs:
  candidate-regression:
    if: github.event.pull_request.head.repo.full_name == github.repository
    runs-on: ubuntu-24.04
    timeout-minutes: 35
    env:
      WORK: /tmp/p01-pr1946-final-${{ github.run_id }}
      TARGET_REPO: {{REPOSITORY}}
      TARGET_VERSION: {{TARGET_VERSION}}
      TARGET_SHA: {{TARGET_SHA}}
      TARGET_TREE: {{TARGET_TREE}}
      HEAD_BRANCH: {{HEAD_BRANCH}}
      BASE_SHA: {{BASE_SHA}}
    steps:
      - name: Checkout registered Public Runner control
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          persist-credentials: false
      - name: Audit single-source identity and rendered workflow
        shell: bash
        run: |
          set -Eeuo pipefail
          mkdir -p "$WORK"
          python3 scripts/ephemeral_lane_spec.py validate --spec specs/p01_pr1946_final_candidate.json >/dev/null
          python3 scripts/ephemeral_lane_spec.py audit-rendered --spec specs/p01_pr1946_final_candidate.json --input .github/workflows/p01-pr1946-final-candidate-temp.yml
          python3 scripts/ephemeral_lane_spec.py render --spec specs/p01_pr1946_final_candidate.json --template templates/p01_pr1946_final_candidate.yml.in --output "$WORK/rendered.yml"
          cmp "$WORK/rendered.yml" .github/workflows/p01-pr1946-final-candidate-temp.yml
          echo P01_1946_FINAL_RENDER_IDENTITY=PASS
      - name: Install isolated PHP and browser test dependencies
        shell: bash
        run: |
          set -Eeuo pipefail
          sudo apt-get update -qq
          sudo apt-get install -y -qq php-cli php-sqlite3 php-curl php-mbstring php-zip php-gd php-xml unzip jq >/dev/null
          php -m | grep -Fxi pdo_sqlite
          php -m | grep -Fxi sqlite3
          command -v google-chrome
          node --version
          echo P01_1946_FINAL_RUNTIME=PASS
      - name: Lock exact candidate and official main baseline
        shell: bash
        env:
          READ_TOKEN: ${{ secrets.VF_PRIVATE_READ_TOKEN }}
        run: |
          set -Eeuo pipefail
          set +x
          test -n "$READ_TOKEN"
          remote="$(git ls-remote "https://x-access-token:$READ_TOKEN@github.com/$TARGET_REPO.git" "refs/heads/$HEAD_BRANCH" | awk '{print $1}')"
          test "$remote" = "$TARGET_SHA"
          git clone -q --no-checkout "https://x-access-token:$READ_TOKEN@github.com/$TARGET_REPO.git" "$WORK/repo"
          git -C "$WORK/repo" remote set-url origin "https://github.com/$TARGET_REPO.git"
          git -C "$WORK/repo" checkout -q --detach "$TARGET_SHA"
          test "$(git -C "$WORK/repo" rev-parse HEAD)" = "$TARGET_SHA"
          test "$(git -C "$WORK/repo" rev-parse HEAD^{tree})" = "$TARGET_TREE"
          test "$(tr -d '\r\n ' < "$WORK/repo/VERSION")" = "$TARGET_VERSION"
          test "$(tr -d '\r\n ' < "$WORK/repo/src/VERSION.txt")" = "$TARGET_VERSION"
          git -C "$WORK/repo" cat-file -e "$BASE_SHA^{commit}"
          test "$(git -C "$WORK/repo" rev-list --count "$BASE_SHA..$TARGET_SHA")" -gt 0
          git -C "$WORK/repo" diff --name-only "$BASE_SHA" "$TARGET_SHA" | sort > "$WORK/changed.txt"
          printf '%s\n' src/assets/frontstage-legacy-entry.js src/assets/global-remote-music.js src/assets/global-remote-software.js src/assets/global-remote-sources.js src/assets/local-subsite-management.js src/assets/software-workspace.js src/settings.php tests/unit/p01_ia5_remote_music_quick_r48_contract.cjs tests/unit/p01_ia5_remote_software_r39_contract.cjs tests/unit/p01_ia6_governed_source_uncertain_post_contract.cjs tests/unit/p01_ia6_legacy_bookmark_native_contract.cjs tests/unit/p01_ia6_music_remote_unknown_readback_guard_contract.cjs tests/unit/p01_ia6_software_browser_plan_parity_contract.cjs tests/unit/p01_ia6_toolbox_group_delete_remap_contract.cjs tests/unit/p01_ia6_tools_acknowledged_write_readback_guard_contract.cjs | sort > "$WORK/expected.txt"
          cmp "$WORK/expected.txt" "$WORK/changed.txt"
          git -C "$WORK/repo" worktree add -q --detach "$WORK/candidate" "$TARGET_SHA"
          git -C "$WORK/repo" worktree add -q --detach "$WORK/baseline" "$BASE_SHA"
          echo P01_1946_FINAL_SHA_TREE_AND_15_FILE_SCOPE=PASS
      - name: Verify unit PHP zero-debt on candidate versus main
        shell: bash
        run: |
          set -Eeuo pipefail
          cd "$WORK/candidate"
          php -l src/settings.php
          bash tests/canonical_release_regression.sh . "$WORK/baseline" --require-zero-debt > "$WORK/canonical.txt" 2>&1 || {
            tail -n 90 "$WORK/canonical.txt"
            exit 31
          }
          tail -n 13 "$WORK/canonical.txt"
          grep -Fx 'P01_CANONICAL_UNIT_REGRESSION=PASS' "$WORK/canonical.txt"
          grep -Fx 'P01_CANONICAL_ZERO_DEBT_REQUIRED=PASS' "$WORK/canonical.txt"
          echo P01_1946_FINAL_PHP_CANONICAL=PASS
      - name: Cross-page Software owner visitor and no-nested-modal regression
        shell: bash
        run: |
          set -Eeuo pipefail
          cd "$WORK/candidate"
          for js in src/assets/frontstage-legacy-entry.js src/assets/global-remote-music.js src/assets/global-remote-sources.js src/assets/global-remote-software.js src/assets/local-subsite-management.js src/assets/software-workspace.js; do node --check "$js"; done
          node tests/unit/software_owner_guest_install_profiles_native.js
          node tests/browser/software_plan_mutation_safety_contract.cjs
          node tests/browser/software_plan_detail_route_contract.cjs
          node tests/browser/local_management_bulk_search_scope_contract.cjs
          node tests/unit/p01_ia5_remote_software_r39_contract.cjs
          echo P01_1946_FINAL_SOFTWARE_ROLE_AND_ROUTE=PASS
      - name: Headless real-Chromium project CSS regression
        shell: bash
        run: |
          set -Eeuo pipefail
          cd "$WORK/candidate"
          node tests/unit/project_visual_geometry_browser_contract.cjs | tee "$WORK/browser.txt"
          grep -Fx P01_PROJECT_VISUAL_BROWSER=PASS "$WORK/browser.txt"
          echo P01_1946_FINAL_CHROMIUM_GEOMETRY=PASS
      - name: Remove private source and runtime products
        if: always()
        shell: bash
        run: |
          set -Eeuo pipefail
          echo P01_1946_FINAL_PUBLIC_ARTIFACT=NONE
          echo P01_1946_FINAL_PRODUCTION_WRITE=NONE
          case "$WORK" in /tmp/p01-pr1946-final-*) rm -rf -- "$WORK";; *) exit 66;; esac
