name: p01-source-sync-uncertainty-guard
on:
  pull_request:
    branches: [main]
    paths:
      - '.github/workflows/p01-source-sync-uncertainty-temp.yml'
      - 'specs/p01_source_sync_uncertainty.json'
      - 'templates/p01_source_sync_uncertainty.yml.in'
permissions:
  contents: read
jobs:
  source-sync-exact:
    if: github.event.pull_request.head.repo.full_name == github.repository
    runs-on: ubuntu-24.04
    timeout-minutes: 18
    env:
      WORK: /tmp/p01-source-sync-${{ github.run_id }}
      TARGET_REPO: {{REPOSITORY}}
      TARGET_VERSION: {{TARGET_VERSION}}
      TARGET_SHA: {{TARGET_SHA}}
      TARGET_TREE: {{TARGET_TREE}}
      HEAD_BRANCH: {{HEAD_BRANCH}}
      BASE_SHA: {{BASE_SHA}}
    steps:
      - name: Checkout registered Public Runner control
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          persist-credentials: false
      - name: Audit rendered single-source test specification
        shell: bash
        run: |
          set -Eeuo pipefail
          mkdir -p "$WORK"
          python3 scripts/ephemeral_lane_spec.py validate --spec specs/p01_source_sync_uncertainty.json > /dev/null
          python3 scripts/ephemeral_lane_spec.py audit-rendered --spec specs/p01_source_sync_uncertainty.json --input .github/workflows/p01-source-sync-uncertainty-temp.yml
          python3 scripts/ephemeral_lane_spec.py render --spec specs/p01_source_sync_uncertainty.json --template templates/p01_source_sync_uncertainty.yml.in --output "$WORK/rendered.yml"
          cmp "$WORK/rendered.yml" .github/workflows/p01-source-sync-uncertainty-temp.yml
          echo P01_SOURCE_SYNC_RUNNER_IDENTITY=PASS
      - name: Exact private checkout in disposable workspace
        shell: bash
        env:
          READ_TOKEN: ${{ secrets.VF_PRIVATE_READ_TOKEN }}
        run: |
          set -Eeuo pipefail
          set +x
          test -n "$READ_TOKEN"
          remote="$(git ls-remote "https://x-access-token:$READ_TOKEN@github.com/$TARGET_REPO.git" "refs/heads/$HEAD_BRANCH" | awk '{print $1}')"
          test "$remote" = "$TARGET_SHA"
          git clone -q --no-checkout "https://x-access-token:$READ_TOKEN@github.com/$TARGET_REPO.git" "$WORK/candidate"
          git -C "$WORK/candidate" checkout -q --detach "$TARGET_SHA"
          git -C "$WORK/candidate" remote set-url origin "https://github.com/$TARGET_REPO.git"
          test "$(git -C "$WORK/candidate" rev-parse HEAD)" = "$TARGET_SHA"
          test "$(git -C "$WORK/candidate" rev-parse HEAD^{tree})" = "$TARGET_TREE"
          test "$(tr -d '\r\n ' < "$WORK/candidate/VERSION")" = "$TARGET_VERSION"
          git -C "$WORK/candidate" cat-file -e "$BASE_SHA^{commit}"
          git -C "$WORK/candidate" diff --name-only "$BASE_SHA" "$TARGET_SHA" | sort > "$WORK/diff.txt"
          printf '%s\n' src/assets/frontstage-legacy-entry.js src/assets/global-remote-music.js src/assets/global-remote-sources.js src/assets/local-subsite-management.js src/settings.php tests/unit/p01_ia5_remote_music_quick_r48_contract.cjs tests/unit/p01_ia6_governed_source_uncertain_post_contract.cjs tests/unit/p01_ia6_legacy_bookmark_native_contract.cjs tests/unit/p01_ia6_music_remote_unknown_readback_guard_contract.cjs tests/unit/p01_ia6_toolbox_group_delete_remap_contract.cjs tests/unit/p01_ia6_tools_acknowledged_write_readback_guard_contract.cjs | sort > "$WORK/expected.txt"
          cmp "$WORK/expected.txt" "$WORK/diff.txt"
          echo P01_SOURCE_SYNC_EXACT_SCOPE=PASS
      - name: Run exact-source dynamic partial-sync and regression proofs
        shell: bash
        run: |
          set -Eeuo pipefail
          cd "$WORK/candidate"
          for file in src/assets/global-remote-sources.js src/assets/global-remote-music.js src/assets/local-subsite-management.js tests/unit/p01_ia6_governed_source_uncertain_post_contract.cjs tests/unit/p01_ia6_tools_acknowledged_write_readback_guard_contract.cjs; do node --check "$file"; done
          node tests/unit/p01_ia6_governed_source_uncertain_post_contract.cjs
          node tests/unit/p01_ia6_governed_source_paging_contract.cjs
          node tests/unit/p01_ia5_remote_sources_r38_contract.cjs
          node tests/unit/p01_ia6_sources_read_cancel_write_guard.cjs
          node tests/unit/p01_ia6_sources_governance_native_closure_contract.cjs
          node tests/unit/p01_ia6_source_review_legacy_detail_parity_contract.cjs
          node tests/unit/p01_ia6_music_remote_unknown_readback_guard_contract.cjs
          node tests/unit/p01_ia6_legacy_bookmark_native_contract.cjs
          node tests/unit/p01_tools_workflow_draft_preservation_contract.cjs
          node tests/unit/p01_ia6_toolbox_group_delete_remap_contract.cjs
          node tests/unit/p01_ia6_tools_acknowledged_write_readback_guard_contract.cjs
          echo P01_SOURCE_SYNC_PARTIAL_POST_AND_READONLY_PROOF=PASS
      - name: Clean private source from Public Runner on every exit
        if: always()
        shell: bash
        run: |
          set -Eeuo pipefail
          echo P01_SOURCE_SYNC_PUBLIC_ARTIFACT=NONE
          echo P01_SOURCE_SYNC_PRODUCTION_WRITE=NONE
          case "$WORK" in /tmp/p01-source-sync-*) rm -rf -- "$WORK";; *) exit 66;; esac
