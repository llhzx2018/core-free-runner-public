    $paths=[];
    foreach($rootFiles as $name){$p=$real.DIRECTORY_SEPARATOR.$name;if(is_file($p)){if(is_link($p))throw new RuntimeException('Runtime source symlink detected: '.$name);$paths[$name]=$p;}}
    foreach(['app','assets','cli','migrations'] as $dn){
        $dir=$real.DIRECTORY_SEPARATOR.$dn; if(!is_dir($dir))continue; if(is_link($dir))throw new RuntimeException('Runtime source directory symlink detected: '.$dn);
        $it=new RecursiveIteratorIterator(new RecursiveDirectoryIterator($dir,FilesystemIterator::SKIP_DOTS));
        foreach($it as $info){if(!$info->isFile()||$info->isLink())continue;$p=$info->getRealPath();if($p===false||!str_starts_with($p,$real.DIRECTORY_SEPARATOR))throw new RuntimeException('Runtime path boundary failure.');$rel=str_replace('\\','/',substr($p,strlen($real)+1));if($rel==='app/.runtime.php'||preg_match('#(^|/)repair-v[^/]+\\.php$#',$rel))continue;$paths[$rel]=$p;}
    }
    ksort($paths,SORT_STRING);$actual=[];$rows=[];$fpRows=[];
    foreach($paths as $rel=>$p){$z=filesize($p);$h=hash_file('sha256',$p);if(!is_int($z)||!is_string($h))throw new RuntimeException('Runtime source read failure: '.$rel);$actual[$rel]=['size'=>$z,'sha256'=>$h];$rows[]=$rel."\t".$z."\t".$h;if($rel!=='release-manifest.json')$fpRows[]=$h.'  '.$rel;}
    $body=implode("\n",$rows)."\n";$sourceSha=hash('sha256',$body);$runtimeFp=hash('sha256',implode("\n",$fpRows)."\n");
    $missing=[];$unexpected=[];$mismatch=[];$drift=[];
    foreach($expected as $rel=>$m){if(!isset($actual[$rel])){$missing[]=$rel;$drift[]=['path'=>$rel,'type'=>'missing','expected_sha'=>(string)$m['sha256'],'actual_sha'=>''];continue;}if(!hash_equals((string)$m['sha256'],(string)$actual[$rel]['sha256'])||(int)$m['size']!==(int)$actual[$rel]['size']){$mismatch[]=$rel;$drift[]=['path'=>$rel,'type'=>'hash_mismatch','expected_sha'=>(string)$m['sha256'],'actual_sha'=>(string)$actual[$rel]['sha256']];}}
    foreach($actual as $rel=>$m){if(!isset($expected[$rel])){$unexpected[]=$rel;$drift[]=['path'=>$rel,'type'=>'unexpected','expected_sha'=>'','actual_sha'=>(string)$m['sha256']];}}
    $exact=count($actual)===VFP_EXPECTED_SOURCE_FILE_COUNT&&$sourceSha===VFP_EXPECTED_SOURCE_MANIFEST_SHA256&&!$missing&&!$unexpected&&!$mismatch;
    return ['source_manifest_file_count'=>count($actual),'production_source_manifest_sha256'=>$sourceSha,'missing'=>$missing,'unexpected'=>$unexpected,'mismatch'=>$mismatch,'drift'=>$drift,'source_manifest_exact'=>$exact?'PASS':'FAIL'];
}
function vfp_runtime_scan(string $root): array {
