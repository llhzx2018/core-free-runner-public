g_replace('/[\\x00-\\x08\\x0B\\x0C\\x0E-\\x1F\\x7F]/u','',$value)??'';
    return function_exists('mb_substr')?mb_substr($value,0,$max,'UTF-8'):substr($value,0,$max);
}
function vfp_ident(string $name): string {
    if(!preg_match('/^[A-Za-z_][A-Za-z0-9_]*$/',$name)) throw new RuntimeException('SQL identifier contract failed.');
    return '"'.$name.'"';
}
function vfp_scalar(SQLite3 $db,string $sql) {
    $r=$db->querySingle($sql,false); return $r;
}
function vfp_rows(SQLite3 $db,string $sql): array {
    $res=$db->query($sql); $rows=[];
    while($row=$res->fetchArray(SQLITE3_ASSOC)) $rows[]=$row;
    $res->finalize(); return $rows;
}
function vfp_table_columns(SQLite3 $db,string $table): array {
    $out=[]; foreach(vfp_rows($db,'PRAGMA table_info('.vfp_ident($table).')') as $r) $out[]=(string)$r['name']; return $out;
}
function vfp_open_ro(string $path): SQLite3 {
    if(!is_file($path)||is_link($path)||!is_readable($path)) throw new RuntimeException('SQLite read-only source unavailable.');
    $db=new SQLite3($path,SQLITE3_OPEN_READONLY); $db->enableExceptions(true); $db->busyTimeout(5000); $db->exec('PRAGMA query_only=ON'); return $db;
}
function vfp_schema(SQLite3 $db): int {
    $cols=vfp_table_columns($db,'schema_migrations');
    if(in_array('status',$cols,true)) return (int)vfp_scalar($db,"SELECT COALESCE(MAX(version),0) FROM schema_migrations WHERE status='success'");
    return (int)vfp_scalar($db,'SELECT COALESCE(MAX(version),0) FROM schema_migrations');
}
function vfp_db_health(SQLite3 $db): array {
    $integrity=(string)vfp_scalar($db,'PRAGMA integrity_check');
    $fk=count(vfp_rows($db,'PRAGMA foreign_key_check'));
    return ['integrity'=>$integrity,'foreign_key_violations'=>$fk];
}
function vfp_source_scan(string $root,array $expected): array {
    $real=realpath($root); if($real===false||is_link($root)) throw new RuntimeException('Application Root 无法安全读取。');
