2592000));if(($last>0&&$now-$last>$idle)||($created>0&&$now-$created>$max))vfp_deny();
    $appKey=(string)($cfg['app_key']??'');if($appKey===''||!preg_match('/^[a-f0-9]{64,}$/i',$appKey))throw new RuntimeException('Application auth contract unavailable.');$ua=vfp_clean_string($_SERVER['HTTP_USER_AGENT']??'unknown',500);$uaFp=hash('sha256',$ua.'|'.$appKey);$sessionUa=(string)($s['vf_domain_ua']??'');if($sessionUa!==''&&!hash_equals($sessionUa,$uaFp))vfp_deny();
    $dataPath=rtrim((string)($cfg['data_path']??''),DIRECTORY_SEPARATOR);if($dataPath===''||$dataPath[0]!==DIRECTORY_SEPARATOR||is_link($dataPath))throw new RuntimeException('Private data path unavailable.');$dbPath=$dataPath.DIRECTORY_SEPARATOR.'database'.DIRECTORY_SEPARATOR.'vf-domain.sqlite';$db=vfp_open_ro($dbPath);
    $generation=(int)vfp_scalar($db,"SELECT COALESCE((SELECT value FROM settings WHERE key='auth_generation' LIMIT 1),'1')");if((int)($s['vf_domain_auth_generation']??-1)!==$generation)vfp_deny();
    $versionFile=$root.DIRECTORY_SEPARATOR.'VERSION.txt';$version=is_file($versionFile)&&!is_link($versionFile)?trim((string)file_get_contents($versionFile)):'';
    $schema=vfp_schema($db);$health=vfp_db_health($db);$expected=json_decode((string)base64_decode(VFP_EXPECTED_MAP_B64,true),true,512,JSON_THROW_ON_ERROR);if(!is_array($expected))throw new RuntimeException('Embedded manifest contract invalid.');$source=vfp_source_scan($root,$expected);$runtime=vfp_runtime_scan($root);$drift=vfp_merge_drift($source,$runtime);$missing=array_values(array_unique(array_merge($source['missing'],$runtime['missing'])));$unexpected=array_values(array_unique(array_merge($source['unexpected'],$runtime['unexpected'])));$mismatch=array_values(array_unique(array_merge($source['mismatch'],$runtime['mismatch'])));$sourceExact=$source['source_manifest_exact']==='PASS'&&$runtime['runtime_exact']==='PASS'&&!$drift;
    $backup=vfp_backup($db,$dataPath);$preDb=$backup['_db']??null;if(!$preDb instanceof SQLite3){$business=['status'=>'FAIL','reason'=>'validated pre-upgrade backup unavailable'];}else{$business=vfp_business_preservation($preDb,$db);}unset($backup['_db']);
    $versionPass=$version===VFP_EXPECTED_VERSION;$schemaPass=$schema===VFP_EXPECTED_SCHEMA;$integrityPass=$health['integrity']==='ok';$fkPass=$health['foreign_key_violations']===0;$final=$versionPass&&$schemaPass&&$integrityPass&&$fkPass&&$sourceExact&&$business['status']==='PASS'&&$backup['status']==='PASS';
    vfp_json(['ok'=>true,'probe'=>'P04_V258_ONE_TIME_READ_ONLY_RECONCILIATION','production_version'=>$version,'production_version_gate'=>$versionPass?'PASS':'FAIL','schema_version'=>$schema,'schema_gate'=>$schemaPass?'PASS':'FAIL','sqlite_integrity'=>$integrityPass?'PASS':'FAIL','foreign_keys'=>$fkPass?'PASS':'FAIL','foreign_key_violations'=>$health['foreign_key_violations'],'runtime_file_count'=>$runtime['runtime_file_count'],'runtime_fingerprint'=>$runtime['runtime_fingerprint'],'production_source_manifest_sha256'=>$source['production_source_manifest_sha256'],'source_manifest_file_count'=>$source['source_manifest_file_count'],'missing_count'=>count($missing),'unexpected_count'=>count($unexpected),'hash_mismatch_count'=>count($mismatch),'source_exact'=>$sourceExact?'PASS':'FAIL','drift'=>$drift,'business_preservation'=>$business,'pre_upgrade_backup'=>$backup,'final_reconciliation'=>$final?'PASS':'FAIL','safety'=>['authentication_reuse'=>'VF Infra existing admin session / read-only mirror','database_mode'=>'SQLITE3_OPEN_READONLY + PRAGMA query_only','filesystem_write'=>0,'database_write'=>0,'network_call'=>0,'provider_remote_write'=>0]]);
} catch(Throwable $e) { vfp_json(['ok'=>false,'error'=>'Reconciliation Probe 无法完成只读验证。','error_type'=>'READ_ONLY_RECONCILIATION_FAILURE'],500); }
'''
