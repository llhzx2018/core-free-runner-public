const VFP_EXPECTED_SCHEMA = __SCHEMA__;
const VFP_EXPECTED_FILE_COUNT = __FILES__;
const VFP_EXPECTED_SOURCE_FILE_COUNT = __SOURCE_FILES__;
const VFP_EXPECTED_RUNTIME_FINGERPRINT = '__RUNTIME_FP__';
const VFP_EXPECTED_SOURCE_MANIFEST_SHA256 = '__SOURCE_SHA__';
const VFP_EXPECTED_MAP_B64 = '__MAP_B64__';

function vfp_json(array $value, int $status = 200): never {
    http_response_code($status);
    header('Content-Type: application/json; charset=utf-8');
    header('Cache-Control: no-store, max-age=0');
    header('Pragma: no-cache');
    header('X-Robots-Tag: noindex, nofollow, noarchive');
    header('X-Content-Type-Options: nosniff');
    echo json_encode($value, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_PRETTY_PRINT | JSON_THROW_ON_ERROR);
    exit;
}
function vfp_deny(): never { vfp_json(['ok'=>false,'error'=>'需要现有 VF Infra 管理员会话。'],403); }
