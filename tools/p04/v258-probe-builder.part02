    [$curCols,$curRows]=vfp_select_rows($cur,$spec['table'],$spec['columns'],$spec['where']??'1=1');
    $cols=array_values(array_intersect($preCols,$curCols));$keys=$spec['keys'];foreach($keys as $k)if(!in_array($k,$cols,true))throw new RuntimeException('Business key unavailable: '.$spec['table'].'.'.$k);
    $preMap=[];foreach($preRows as $r){$k=vfp_row_key($r,$keys);$preMap[$k]=vfp_row_hash($r,$cols);}ksort($preMap,SORT_STRING);
    $curMap=[];foreach($curRows as $r){$k=vfp_row_key($r,$keys);$curMap[$k]=vfp_row_hash($r,$cols);}ksort($curMap,SORT_STRING);
    $preLines=[];$curLines=[];$missing=0;$mismatch=0;
    foreach($preMap as $k=>$h){$preLines[]=$k."\t".$h;$ch=$curMap[$k]??'';$curLines[]=$k."\t".($ch!==''?$ch:'<MISSING>');if($ch==='')$missing++;elseif(!hash_equals($h,$ch))$mismatch++;}
