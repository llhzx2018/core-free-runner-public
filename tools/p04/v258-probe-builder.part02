    return ['pre_count'=>count($preRows),'current_count'=>count($curRows),'pre_identity_digest'=>$preDigest,'current_identity_digest'=>$curDigest,'missing_pre_identities'=>$missing,'changed_pre_identities'=>$mismatch,'preserved'=>$ok?'YES':'NO'];
