    ksort($fpRows,SORT_STRING);$fp=hash('sha256',implode("\n",$fpRows).($fpRows?"\n":''));$exact=count($files)+1===VFP_EXPECTED_FILE_COUNT&&$fp===VFP_EXPECTED_RUNTIME_FINGERPRINT&&!$missing&&!$mismatch&&hash_equals((string)($m['source_fingerprint']??''),VFP_EXPECTED_RUNTIME_FINGERPRINT);
    return ['runtime_file_count'=>count($files)+1,'runtime_fingerprint'=>$fp,'missing'=>$missing,'unexpected'=>[],'mismatch'=>$mismatch,'drift'=>$drift,'runtime_exact'=>$exact?'PASS':'FAIL'];
