}
function vfp_select_rows(SQLite3 $db,string $table,array $cols,string $where='1=1'): array {
    $available=vfp_table_columns($db,$table); if(!$available)throw new RuntimeException('Required business table missing: '.$table);
    $use=array_values(array_filter($cols,fn($c)=>in_array($c,$available,true))); if(!$use)throw new RuntimeException('Business identity columns missing: '.$table);
    $sql='SELECT '.implode(',',array_map('vfp_ident',$use)).' FROM '.vfp_ident($table).' WHERE '.$where;
    return [$use,vfp_rows($db,$sql)];
}
function vfp_row_key(array $row,array $keys): string { $v=[];foreach($keys as $k){if(!array_key_exists($k,$row))throw new RuntimeException('Business key missing: '.$k);$v[$k]=$row[$k];}return json_encode($v,JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES|JSON_THROW_ON_ERROR); }
